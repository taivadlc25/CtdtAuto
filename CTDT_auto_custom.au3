	EndIf
	If EVN_ISSPECMENU ( ) Then
		; man chon nhom Special Scenario (Scouting Tour / Player List Bonus / Tsubasa Ozora...): vao Player List Bonus (the 2, 100 map)
		SENDCLICK ( 330 + $APOS [ 0 ] , 200 + $APOS [ 1 ] , $APOS )
		Sleep ( 3500 )
		Return
	EndIf
	If EVN_SPECIALTODAY ( ) And EVN_ISHUB ( ) Then
		; hom nay da het map Event Matches -> o man chon su kien thi lui ve menu Story Mode
		SENDCLICK ( 50 + $APOS [ 0 ] , 413 + $APOS [ 1 ] , $APOS )
		Sleep ( 3500 )
		Return
	EndIf
	If EVN_SPECIALTODAY ( ) And ( CHECKCOLOR ( 566 , 160 , 7113135 ) Or CHECKCOLOR ( 566 , 160 , 7113391 ) ) Then
		; menu Story Mode: vao Special Scenario (the o giua duoi) thay vi Event Matches
		SENDCLICK ( 455 + $APOS [ 0 ] , 300 + $APOS [ 1 ] , $APOS )
		Sleep ( 2500 )
	ElseIf $FARMMODE = 4 Then
		CLICKPIXEL ( 681 , 417 , 4213111 , $APOS )
	Else
		CLICKPIXEL ( 566 , 160 , 7113135 , $APOS )
		CLICKPIXEL ( 566 , 160 , 7113391 , $APOS )
	EndIf
	If ( CHECKCOLOR ( 23 , 43 , 16576096 ) Or CHECKCOLOR ( 23 , 43 , 16642655 ) ) And CHECKCOLOR ( 10 , 370 , 6439470 ) Then
		SENDCLICK ( 11 + $APOS [ 0 ] , 372 + $APOS [ 1 ] , $APOS )
		Sleep ( 2000 )
	EndIf
	If CHECKCOLOR ( 324 , 80 , 14072215 ) Or CHECKCOLOR ( 324 , 80 , 14137751 ) Then
		Switch $MUCEVEN
		Case 0
		Case 1
			SENDCLICK ( 96 + $APOS [ 0 ] , 246 + $APOS [ 1 ] , $APOS )
			Sleep ( 1000 )
		Case 2
			SENDCLICK ( 318 + $APOS [ 0 ] , 246 + $APOS [ 1 ] , $APOS )
			Sleep ( 1000 )
		Case 3
			SENDCLICK ( 503 + $APOS [ 0 ] , 246 + $APOS [ 1 ] , $APOS )
			Sleep ( 1000 )
		Case 4
			SENDCLICK ( 750 + $APOS [ 0 ] , 246 + $APOS [ 1 ] , $APOS )
			Sleep ( 1000 )
		EndSwitch
	EndIf
	If CHECKCOLOR ( 23 , 43 , 16576096 ) And CHECKCOLOR ( 743 , 72 , 8682590 ) Then
		CLICKPIXEL ( 29 , 414 , 14575636 , $APOS )
		Sleep ( 500 )
	EndIf
EndFunc
Func POSTMESSAGEDRAGDOWN ( $HWND , $X1 , $Y1 , $X2 , $Y2 )
	Local $WM_LBUTTONDOWN = 513
	Local $WM_LBUTTONUP = 514
	Local $WM_MOUSEMOVE = 512
	Local $MK_LBUTTON = 1
	Local $ISTEPDISTANCE = 20
	Local $IPAUSETIME = 3000
	Local $ISMOOTHSTEPS = 5
	Local $ISMOOTHDELAY = 200
	Local $ICURRENTY = $Y1
	Local $INEXTY
	While $ICURRENTY < $Y2
		If Not $BRUN Then Return
		$INEXTY = $ICURRENTY + $ISTEPDISTANCE
		Local $IY_DRAGSTART = $ICURRENTY
		Local $IY_DRAGEND
		If $INEXTY < $Y2 Then
			$IY_DRAGEND = $INEXTY
		Else
			$IY_DRAGEND = $Y2
		EndIf
		Local $IACTUALDRAGDISTANCE = $IY_DRAGEND - $IY_DRAGSTART
		If $IACTUALDRAGDISTANCE <= 0 Then ExitLoop
		DllCall ( "user32.dll" , "int" , "PostMessage" , "hwnd" , $HWND , "int" , $WM_MOUSEMOVE , "int" , 0 , "long" , _MAKELONG ( $X1 , $IY_DRAGSTART ) )
		DllCall ( "user32.dll" , "int" , "PostMessage" , "hwnd" , $HWND , "int" , $WM_LBUTTONDOWN , "int" , $MK_LBUTTON , "long" , _MAKELONG ( $X1 , $IY_DRAGSTART ) )
		Sleep ( 50 )
		Local $ISMOOTHSTEPY = $IACTUALDRAGDISTANCE / $ISMOOTHSTEPS
		For $K = 1 To $ISMOOTHSTEPS
			If Not $BRUN Then
				DllCall ( "user32.dll" , "int" , "PostMessage" , "hwnd" , $HWND , "int" , $WM_LBUTTONUP , "int" , 0 , "long" , _MAKELONG ( $X1 , $IY_DRAGSTART ) )
				Return
			EndIf
			$IY_DRAGSTART += $ISMOOTHSTEPY
			DllCall ( "user32.dll" , "int" , "PostMessage" , "hwnd" , $HWND , "int" , $WM_MOUSEMOVE , "int" , $MK_LBUTTON , "long" , _MAKELONG ( $X1 , $IY_DRAGSTART ) )
			Sleep ( $ISMOOTHDELAY )
		Next
		DllCall ( "user32.dll" , "int" , "PostMessage" , "hwnd" , $HWND , "int" , $WM_LBUTTONUP , "int" , 0 , "long" , _MAKELONG ( $X1 , $IY_DRAGEND ) )
		$ICURRENTY = $IY_DRAGEND
		If $ICURRENTY < $Y2 Then
			Sleep ( $IPAUSETIME )
		EndIf
	WEnd
	Return
EndFunc
