				Next
			EndIf
		EndIf
		If IsArray ( $APREV ) Then
			$APRIVILEGES = $APREV
		EndIf
		Local $TAGSTRUCT = "dword;dword[" & ( 3 * UBound ( $APRIVILEGES ) ) & "]"
		$TTP1 = DllStructCreate ( $TAGSTRUCT )
		$TTP2 = DllStructCreate ( $TAGSTRUCT )
		If @error Then Return SetError ( @error + 20 , 0 , 0 )
