Func SENDCLICK ( $X , $Y , $APOS )
	$LPARAM = ( $Y + 1 - $APOS [ 1 ] ) * 65536 + $X + 1 - $APOS [ 0 ]
	_WINAPI_POSTMESSAGE ( $HWND , $WM_LBUTTONDOWN , 1 , $LPARAM )
	_WINAPI_POSTMESSAGE ( $HWND , $WM_LBUTTONUP , 0 , $LPARAM )
EndFunc
Func SENDCLICK2 ( $X , $Y , $APOS )
	$LPARAM = ( $Y + 1 - $APOS [ 1 ] ) * 65536 + $X + 1 - $APOS [ 0 ]
	_WINAPI_POSTMESSAGE ( $HWND2 , $WM_LBUTTONDOWN , 1 , $LPARAM )
	_WINAPI_POSTMESSAGE ( $HWND2 , $WM_LBUTTONUP , 0 , $LPARAM )
EndFunc
Func SENDCLICK3 ( $X , $Y , $APOS )
	$LPARAM = ( $Y + 1 - $APOS [ 1 ] ) * 65536 + $X + 1 - $APOS [ 0 ]
	_WINAPI_POSTMESSAGE ( $HWND3 , $WM_LBUTTONDOWN , 1 , $LPARAM )
	_WINAPI_POSTMESSAGE ( $HWND3 , $WM_LBUTTONUP , 0 , $LPARAM )
EndFunc
Func SENDCLICK4 ( $X , $Y , $APOS , $HWND4 )
	$LPARAM = ( $Y + 1 - $APOS [ 1 ] ) * 65536 + $X + 1 - $APOS [ 0 ]
	_WINAPI_POSTMESSAGE ( $HWND4 , $WM_LBUTTONDOWN , 1 , $LPARAM )
	_WINAPI_POSTMESSAGE ( $HWND4 , $WM_LBUTTONUP , 0 , $LPARAM )
EndFunc
