; ===================== Nhan qua Missions + Presents o man hinh chinh =====================
; Thay cham do o icon Missions (705,330) / Presents (33,200) -> mo ra bam "Accept All", OK, dong lai.
; Moi muc cach nhau it nhat 10 phut de khong bi lap neu cham do khong tat.
Func GIFT_WAIT ( $sWhat , $iSec )
	Local $hT = TimerInit ( )
	While TimerDiff ( $hT ) < $iSec * 1000
		If Not $BRUN Then Return False
		NETRETRY ( )
		Switch $sWhat
			Case "mis"     ; bang Regular/Club Missions: thanh tieu de xanh + nut Accept All (xanh hoac xam)
				If CHECKCOLORT ( 300 , 48 , 0x4B88F8 , 15 ) And ( CHECKCOLORT ( 700 , 418 , 0x81CA40 , 15 ) Or CHECKCOLORT ( 700 , 418 , 0x406520 , 15 ) ) Then Return True
			Case "pre"     ; Present List: o "Presents" xanh + nut Accept All goc phai duoi
				If CHECKCOLORT ( 660 , 136 , 0x429EE5 , 15 ) And ( CHECKCOLORT ( 760 , 415 , 0x81CA40 , 15 ) Or CHECKCOLORT ( 760 , 415 , 0x406520 , 15 ) ) Then Return True
			Case "home"
				If ISHOMESCREEN ( ) Then Return True
		EndSwitch
		Sleep ( 500 )
	WEnd
	Return False
EndFunc
; bam qua popup "Presents Received" (OK 400,350) / loi thoai "You cleared all the missions!"
Func GIFT_DISMISS ( $sWhat )
	; Accept All bi toi ca luc dang tai / luc popup "Presents Received" chua hien -> chi coi la xong khi
	; nut toi va 2 lan kiem tra lien tiep (cach 1.2s) khong co popup OK; toi da ~30s
	Local $iOk = 0
	For $i = 1 To 25
		If Not $BRUN Then Return
		Sleep ( 1200 )
		If CHECKCOLORT ( 360 , 350 , 0x99EA4D , 20 ) And CHECKCOLORT ( 440 , 350 , 0x83CD41 , 20 ) Then
			SENDCLICK ( 400 + $APOS [ 0 ] , 350 + $APOS [ 1 ] , $APOS )
			$iOk = 0
			ContinueLoop
		EndIf
		Local $bGrey = False
		If $sWhat = "mis" And CHECKCOLORT ( 700 , 418 , 0x406520 , 15 ) Then $bGrey = True
		If $sWhat = "pre" And CHECKCOLORT ( 760 , 415 , 0x406520 , 15 ) Then $bGrey = True
		If $bGrey Then
			$iOk += 1
			If $iOk >= 3 Then Return
			; loi thoai "You cleared all the missions!" cung lam nut toi -> cham de tat (cham vao danh sach thi vo hai)
			If $sWhat = "mis" Then SENDCLICK ( 400 + $APOS [ 0 ] , 250 + $APOS [ 1 ] , $APOS )
			ContinueLoop
		EndIf
		$iOk = 0
		If $sWhat = "mis" Then SENDCLICK ( 400 + $APOS [ 0 ] , 250 + $APOS [ 1 ] , $APOS )
	Next
EndFunc
; goi khi het luot (da cay xong): ve man hinh chinh roi nhan qua
Func CLAIMGIFTS ( )
	If Not $BRUN Then Return
	If Not ISHOMESCREEN ( ) Then AM_GOHOME ( 60000 )
	If Not ISHOMESCREEN ( ) Then Return
	$HGIFTMIS = 0
	$HGIFTPRE = 0
	; ---- Missions (Regular + Club) ----
	If ( CHECKCOLORT ( 715 , 315 , 0xEE0515 , 40 ) Or CHECKCOLORT ( 720 , 315 , 0xF6848A , 30 ) ) And ( $HGIFTMIS = 0 Or TimerDiff ( $HGIFTMIS ) > 600000 ) Then
		$HGIFTMIS = TimerInit ( )
		_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Nhận quà Missions" , 0 , 0 )
		AUTOLOG ( "Nhan qua Missions" )
		SENDCLICK ( 705 + $APOS [ 0 ] , 330 + $APOS [ 1 ] , $APOS )
		If GIFT_WAIT ( "mis" , 20 ) Then
			Sleep ( 800 )
			If CHECKCOLORT ( 700 , 418 , 0x81CA40 , 15 ) Then
				SENDCLICK ( 656 + $APOS [ 0 ] , 408 + $APOS [ 1 ] , $APOS )
				GIFT_DISMISS ( "mis" )
			EndIf
			; Club Missions (nut vang 656,355)
			If GIFT_WAIT ( "mis" , 5 ) Then
				SENDCLICK ( 656 + $APOS [ 0 ] , 355 + $APOS [ 1 ] , $APOS )
				Sleep ( 2500 )
				If GIFT_WAIT ( "mis" , 10 ) And CHECKCOLORT ( 700 , 418 , 0x81CA40 , 15 ) Then
					SENDCLICK ( 656 + $APOS [ 0 ] , 408 + $APOS [ 1 ] , $APOS )
					GIFT_DISMISS ( "mis" )
				EndIf
			EndIf
			; Close
			If GIFT_WAIT ( "mis" , 5 ) Then SENDCLICK ( 400 + $APOS [ 0 ] , 410 + $APOS [ 1 ] , $APOS )
		EndIf
		GIFT_WAIT ( "home" , 20 )
	EndIf
	If Not $BRUN Or Not ISHOMESCREEN ( ) Then Return
	; ---- Presents ----
	If CHECKCOLORT ( 47 , 185 , 0xF00815 , 40 ) And ( $HGIFTPRE = 0 Or TimerDiff ( $HGIFTPRE ) > 600000 ) Then
		$HGIFTPRE = TimerInit ( )
		_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Nhận quà Presents" , 0 , 0 )
		AUTOLOG ( "Nhan qua Presents" )
		SENDCLICK ( 33 + $APOS [ 0 ] , 200 + $APOS [ 1 ] , $APOS )
		If GIFT_WAIT ( "pre" , 20 ) Then
			Sleep ( 800 )
			If CHECKCOLORT ( 760 , 415 , 0x81CA40 , 15 ) Then
				SENDCLICK ( 717 + $APOS [ 0 ] , 407 + $APOS [ 1 ] , $APOS )
				GIFT_DISMISS ( "pre" )
			EndIf
			; nut Home goc trai duoi
			SENDCLICK ( 143 + $APOS [ 0 ] , 413 + $APOS [ 1 ] , $APOS )
		EndIf
		GIFT_WAIT ( "home" , 30 )
	EndIf
EndFunc
; ===================== Mua ve Skip o Exchange Shop > Coin Exchange Shop =====================
; Moi ngay 1 lan (luu ngay vao auto_done.ini): mua het cac mon "Skip Ticket" con hang,
; bam "Reset for Free" roi mua them 1 luot nua. Vi tri mon thay doi sau moi lan mua nen do tung o.
Func SKIP_ISSHOP ( )
	Return CHECKCOLORT ( 40 , 48 , 0xFED266 , 20 ) And CHECKCOLORT ( 390 , 80 , 0xFFDD2F , 20 )
EndFunc
; tam icon ve Skip mau xanh ngoc (het hang thi icon toi mau)
Func SKIP_FINDSLOT ( )
	For $i = 0 To 5
		If CHECKCOLORT ( $ASKIPSLOT [ $i ] [ 0 ] , $ASKIPSLOT [ $i ] [ 1 ] , 0x1FDAF5 , 40 ) Then Return $i
	Next
	Return - 1
EndFunc
Func SKIP_BUYALL ( )
	For $n = 1 To 6
		If Not $BRUN Then Return
		If Not SKIP_ISSHOP ( ) Then Return
		Local $i = SKIP_FINDSLOT ( )
		If $i < 0 Then Return
		_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Mua vé Skip " & $n , 0 , 0 )
		SENDCLICK ( $ASKIPSLOT [ $i ] [ 0 ] + 75 + $APOS [ 0 ] , $ASKIPSLOT [ $i ] [ 1 ] + $APOS [ 1 ] , $APOS )
		Sleep ( 2000 )
		; "Confirm Exchange": nut Exchange xanh la
		If CHECKCOLORT ( 545 , 392 , 0x93E24B , 25 ) And CHECKCOLORT ( 330 , 57 , 0x3A73D8 , 25 ) Then
			SENDCLICK ( 585 + $APOS [ 0 ] , 392 + $APOS [ 1 ] , $APOS )
			Sleep ( 1500 )
		EndIf
		SKIP_OK ( 8 )
	Next
EndFunc
; cho popup "Exchange Complete" hien ra (toi da $iSec giay) roi bam OK cho toi khi tat
Func SKIP_OK ( $iSec )
	Local $hT = TimerInit ( ) , $bDone = False
	While TimerDiff ( $hT ) < $iSec * 1000
		If Not $BRUN Then Return
		If CHECKCOLORT ( 360 , 368 , 0x99EB4D , 25 ) And CHECKCOLORT ( 400 , 82 , 0x316CE0 , 25 ) Then
			SENDCLICK ( 400 + $APOS [ 0 ] , 368 + $APOS [ 1 ] , $APOS )
			$bDone = True
			Sleep ( 1500 )
			ContinueLoop
		EndIf
		If $bDone Then Return
		Sleep ( 400 )
	WEnd
EndFunc
Func BUYSKIP ( )
	Local $sIni = @ScriptDir & "\auto_done.ini" , $sToday = GAMEDAY ( )
	If IniRead ( $sIni , "Skip" & $STEXT , "Date" , "" ) = $sToday Then Return
	; moi ngay thu toi da 3 lan (tranh lap mai neu khong vao duoc shop)
	If IniRead ( $sIni , "Skip" & $STEXT , "TryDate" , "" ) <> $sToday Then
		IniWrite ( $sIni , "Skip" & $STEXT , "TryDate" , $sToday )
		IniWrite ( $sIni , "Skip" & $STEXT , "Tries" , 0 )
	EndIf
	Local $iTry = Number ( IniRead ( $sIni , "Skip" & $STEXT , "Tries" , 0 ) )
	If $iTry >= 3 Then Return
	If $BRUN And Not ISHOMESCREEN ( ) Then GIFT_WAIT ( "home" , 20 )      ; vua bam Home: cho man chinh hien ra
	If Not $BRUN Or Not ISHOMESCREEN ( ) Then Return
	IniWrite ( $sIni , "Skip" & $STEXT , "Tries" , $iTry + 1 )
	_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Vào Exchange Shop mua vé Skip" , 0 , 0 )
	SENDCLICK ( 400 + $APOS [ 0 ] , 410 + $APOS [ 1 ] , $APOS )     ; Shop
	Sleep ( 4000 )
	; Shop Menu tai cham: bam "Exchange Shop" moi 3s toi khi vao duoc (toi da 90s)
	Local $hT = TimerInit ( ) , $hC = 0
	While Not SKIP_ISSHOP ( )
		If Not $BRUN Then Return
		If TimerDiff ( $hT ) > 90000 Then      ; 18/11: 40s -> 90s (may (0) Exchange Shop tai > 30s)
			IniWrite ( $sIni , "Skip" & $STEXT , "Fail" , _NOW ( ) )
			AUTOLOG ( "Mua ve Skip: KHONG vao duoc Exchange Shop (lan " & ( $iTry + 1 ) & ")" )
			AM_GOHOME ( 60000 )
			Return
		EndIf
		If NETRETRY ( ) Then ContinueLoop
		If $hC = 0 Or TimerDiff ( $hC ) > 3000 Then
			SENDCLICK ( 540 + $APOS [ 0 ] , 170 + $APOS [ 1 ] , $APOS )     ; Exchange Shop
			$hC = TimerInit ( )
		EndIf
		Sleep ( 500 )
	WEnd
	SENDCLICK ( 150 + $APOS [ 0 ] , 215 + $APOS [ 1 ] , $APOS )     ; tab Coin Exchange Shop
	Sleep ( 2500 )
	SKIP_BUYALL ( )
	; Reset for Free (con luot: nut sang mau) -> OK -> OK -> mua them 1 luot
	If $BRUN And CHECKCOLORT ( 270 , 404 , 0xA7B7A5 , 20 ) Then
		SENDCLICK ( 300 + $APOS [ 0 ] , 404 + $APOS [ 1 ] , $APOS )
		Sleep ( 2000 )
		If CHECKCOLORT ( 440 , 299 , 0x98EA4C , 25 ) Then
			SENDCLICK ( 483 + $APOS [ 0 ] , 299 + $APOS [ 1 ] , $APOS )
			Sleep ( 2500 )
			If CHECKCOLORT ( 360 , 299 , 0x98EA4C , 25 ) Then SENDCLICK ( 400 + $APOS [ 0 ] , 299 + $APOS [ 1 ] , $APOS )
			Sleep ( 2000 )
			SKIP_BUYALL ( )
		EndIf
	EndIf
	If $BRUN Then IniWrite ( $sIni , "Skip" & $STEXT , "Date" , $sToday )
	If $BRUN Then AUTOLOG ( "Mua ve Skip: xong" )
	SKIP_OK ( 2 )      ; con popup OK nao thi tat truoc khi bam Home
	SENDCLICK ( 143 + $APOS [ 0 ] , 413 + $APOS [ 1 ] , $APOS )     ; Home
	GIFT_WAIT ( "home" , 30 )
EndFunc
; ===================== Daily Bonus: nhan bi free + xem het quang cao =====================
; Mo Daily Bonus (icon o Home), nhan "Daily Bonus (once per day)" neu con, roi xem lan luot
; cac nut "View Ad" con mau vang. Dong quang cao: doi 60s -> nut Home MEmu -> mo lai game.
Func DB_ISOPEN ( )
	Return CHECKCOLORT ( 300 , 48 , 0x4B88F8 , 15 ) And CHECKCOLORT ( 560 , 48 , 0x365A93 , 20 )
EndFunc
Func DB_OPEN ( )
	For $t = 1 To 3
		If DB_ISOPEN ( ) Then Return True
		If Not ISHOMESCREEN ( ) Then
			If Not AM_GOHOME ( 60000 ) Then Return False
		EndIf
		SENDCLICK ( 90 + $APOS [ 0 ] , 150 + $APOS [ 1 ] , $APOS )
		For $w = 1 To 16
			If Not $BRUN Then Return False
			Sleep ( 500 )
			If DB_ISOPEN ( ) Then Return True
		Next
	Next
	Return DB_ISOPEN ( )
EndFunc
; bam qua cac man "Rewards Earned" cho toi khi thay lai bang Daily Bonus (toi da $iSec giay)
Func DB_WAITBACK ( $iSec )
	Local $hT = TimerInit ( )
	While TimerDiff ( $hT ) < $iSec * 1000
		If Not $BRUN Then Return False
		If DB_ISOPEN ( ) And CHECKCOLORT ( 400 , 411 , 0xDED3D6 , 25 ) Then
			Sleep ( 800 )
			If DB_ISOPEN ( ) Then Return True
		EndIf
		DIALOGHANDLING ( )
		SENDCLICK ( 400 + $APOS [ 0 ] , 250 + $APOS [ 1 ] , $APOS )
		Sleep ( 1500 )
	WEnd
	Return DB_ISOPEN ( )
EndFunc
; ===== 18/11: quet cuoi bang Daily Bonus =====
; Game: 11 quang cao/ngay (rewards 3, Ads Transfer 3, hoi nang luong 1, Story x2 3, them slot 1). Xem du het
; -> chac chan 3 Dreamball (quay thuong) + diem "View ads to get Dreamballs" (10 diem = 1 Dreamball).
; Keo bang Daily Bonus xuong cuoi, cac hang (y): rewards 183, slots 227, Ads Transfer 270, hoi nang luong 314,
; Story x2 358. Nut con luot mau vang (View Ad 0xDBB64A / Story Mode 0xCBA028), het luot mau xam.
Func DB_ROWYELLOW ( $y )
	Local $c = Dec ( MEMORYREADPIXEL ( 570 , $y , $HWND ) )
	Local $r = BitAND ( BitShift ( $c , 16 ) , 255 ) , $g = BitAND ( BitShift ( $c , 8 ) , 255 ) , $b = BitAND ( $c , 255 )
	Return $r > 190 And $g > 140 And $b < 110
EndFunc
Func DB_SCROLLEND ( )
	MEMU_ADB ( "shell input swipe 400 307 400 77 600" )
	Sleep ( 1200 )
	MEMU_ADB ( "shell input swipe 400 307 400 77 600" )
	Sleep ( 1500 )
EndFunc
; xem 1 quang cao tu nut View Ad o hang $y (bang Daily Bonus dang keo xuong cuoi), dong theo cach cu
Func DB_WATCHAD ( $y , $sName )
	AUTOLOG ( "Daily Bonus (quet cuoi): xem quang cao " & $sName )
	_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Daily Bonus: xem quảng cáo " & $sName , 0 , 0 )
	SENDCLICK ( 610 + $APOS [ 0 ] , $y + $APOS [ 1 ] , $APOS )
	Local $hT = TimerInit ( )
	While TimerDiff ( $hT ) < 60000
		If Not $BRUN Then Return
		Sleep ( 500 )
	WEnd
	ControlClick ( $HWND , "" , "[CLASS:Qt5152QWindowIcon; INSTANCE:8]" )
	Sleep ( 5000 )
	SENDCLICK ( 672 + $APOS [ 0 ] , 145 + $APOS [ 1 ] , $APOS )
	Sleep ( 5000 )
	If EXTRATABS ( ) Then
		EXTRATAB_FIX ( )
	ElseIf Not DB_WAITBACK ( 30 ) And Not ISHOMESCREEN ( ) And Not AD_BACKOUT ( ) And Not AM_GOHOME ( 90000 ) Then      ; 18/11: game tai lai sau quang cao co the > 60s
		GAMEERRRESTART ( "Quảng cáo kẹt" )
	EndIf
EndFunc
Func DB_SWEEP ( )
	Local $sIni = @ScriptDir & "\auto_done.ini" , $sSec = "DailySweep" & $STEXT , $sToday = GAMEDAY ( )
	If IniRead ( $sIni , $sSec , "Date" , "" ) <> $sToday Then
		IniWrite ( $sIni , $sSec , "Date" , $sToday )
		IniWrite ( $sIni , $sSec , "Ads" , 0 )
	EndIf
	DAILY_STEP ( 5 , "quét lại Daily Bonus (quảng cáo còn sót)" )
	Local $aY [ 3 ] = [ 183 , 227 , 314 ] , $aN [ 3 ] = [ "rewards" , "slots" , "hoi nang luong" ]
	For $n = 1 To 6
		If Not $BRUN Then Return
		; toi da 6 quang cao/ngay o buoc quet (tranh lap khi nut vang ma khong xem duoc)
		If Number ( IniRead ( $sIni , $sSec , "Ads" , 0 ) ) >= 6 Then ExitLoop
		If Not DB_OPEN ( ) Then Return
		DB_WAITBACK ( 8 )
		If $n = 1 Then DB_FREECLAIM ( )      ; bi mien phi (bang chua keo, nut o tren cung)
		DB_SCROLLEND ( )
		Local $iHit = -1
		For $k = 1 To 5      ; cho nut View Ad hien (quang cao tai cham sau khi mo lai game)
			For $i = 0 To 2
				If DB_ROWYELLOW ( $aY [ $i ] ) Then
					$iHit = $i
					ExitLoop
				EndIf
			Next
			If $iHit >= 0 Or Not $BRUN Then ExitLoop
			Sleep ( 2000 )
		Next
		If $iHit < 0 Then ExitLoop
		IniWrite ( $sIni , $sSec , "Ads" , Number ( IniRead ( $sIni , $sSec , "Ads" , 0 ) ) + 1 )
		DB_WATCHAD ( $aY [ $iHit ] , $aN [ $iHit ] )
	Next
	If Not $BRUN Then Return
	; Ads Transfer / Story x2 con luot (nut vang) -> danh dau chua xong
	If DB_OPEN ( ) Then
		DB_WAITBACK ( 8 )
		DB_SCROLLEND ( )
		If DB_ROWYELLOW ( 270 ) And IniRead ( $sIni , "AdTransfer" & $STEXT , "Date" , "" ) = $sToday Then
			AUTOLOG ( "Daily Bonus (quet cuoi): Ads Transfer con luot -> lam lai" )
			IniWrite ( $sIni , "AdTransfer" & $STEXT , "Date" , "" )
		EndIf
		If DB_ROWYELLOW ( 358 ) And IniRead ( $sIni , "StoryX2" & $STEXT , "Done" , "" ) = "1" Then
			AUTOLOG ( "Daily Bonus (quet cuoi): Story x2 con luot -> lam lai" )
			Local $iAds = Number ( IniRead ( $sIni , "StoryX2" & $STEXT , "Ads" , 0 ) ) - 1
			If $iAds < 0 Then $iAds = 0
			IniWrite ( $sIni , "StoryX2" & $STEXT , "Ads" , $iAds )
			IniWrite ( $sIni , "StoryX2" & $STEXT , "Done" , 0 )
			If Number ( IniRead ( $sIni , "StoryX2" & $STEXT , "Tries" , 0 ) ) > 8 Then IniWrite ( $sIni , "StoryX2" & $STEXT , "Tries" , 8 )
		EndIf
		If DB_ISOPEN ( ) Then SENDCLICK ( 400 + $APOS [ 0 ] , 411 + $APOS [ 1 ] , $APOS )
		Sleep ( 1000 )
	EndIf
EndFunc
; 19/11: bi mien phi "Daily Bonus (once per day)". CON NHAN DUOC = nut XANH SANG chu "Earned" + dau "!"
; (330,118 0xA6F45A; 300,132 0x8EE142); da nhan = "22h left" xanh toi (330,118 0x537B2D).
; Truoc day code cho nut vang "GET" (0xFED946) -> khong bao gio bam, va chi kiem tra khi chua xem het quang cao.
Func DB_FREEREADY ( )
	Return ( CHECKCOLORT ( 330 , 118 , 0xA6F45A , 25 ) And CHECKCOLORT ( 300 , 132 , 0x8EE142 , 25 ) ) Or CHECKCOLORT ( 330 , 118 , 0xFED946 , 25 )
EndFunc
; bang Daily Bonus dang mo: con bi mien phi thi bam nhan, cham qua man "Get the Daily Bonus"
Func DB_FREECLAIM ( )
	For $k = 1 To 3      ; bang vua mo co the chua ve xong nut
		If DB_FREEREADY ( ) Then ExitLoop
		If $k < 3 Then Sleep ( 1500 )
	Next
	If Not DB_FREEREADY ( ) Then Return False
	SENDCLICK ( 338 + $APOS [ 0 ] , 125 + $APOS [ 1 ] , $APOS )
	Sleep ( 2500 )
	AUTOLOG ( "Daily Bonus: nhan 1 bi mien phi hang ngay" )
	DB_WAITBACK ( 10 )      ; cham qua man "Get the Daily Bonus" toi khi thay lai bang
	Return True
EndFunc
Func DAILYBONUSADS ( )
	If $BADS <> 1 Then Return
	Local $sDone = @ScriptDir & "\auto_done.ini" , $sToday = GAMEDAY ( )
	; da xem het quang cao Daily Bonus hom nay (ghi trong auto_done.ini) -> bo qua, sang cac muc ben duoi
	Local $iMax = 8
	If IniRead ( $sDone , "DailyAds" & $STEXT , "Date" , "" ) = $sToday Then $iMax = 0
	_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Daily Bonus: nhận bi + xem quảng cáo" , 0 , 0 )
	; nhan bi mien phi truoc, ke ca khi quang cao da xem het
	If $BRUN And DB_OPEN ( ) Then
		DB_WAITBACK ( 8 )
		DB_FREECLAIM ( )
	EndIf
	For $n = 1 To $iMax
		If Not $BRUN Then Return
		If Not DB_OPEN ( ) Then Return
		DB_WAITBACK ( 8 )
		DB_FREECLAIM ( )
		Local $iY = 0
		; 18/11: game vua mo lai thi nut View Ad chua hien ngay (quang cao chua tai) -> kiem tra lai toi 12s
		; truoc khi ket luan het (truoc day ghi "het" som, con 1 luot chua xem)
		For $k = 1 To 7
			If CHECKCOLORT ( 570 , 323 , 0xDBB64A , 20 ) Then
				$iY = 323
			ElseIf CHECKCOLORT ( 570 , 366 , 0xDBB64C , 20 ) Then
				$iY = 366
			EndIf
			If $iY > 0 Or Not $BRUN Then ExitLoop
			Sleep ( 2000 )
		Next
		If $iY = 0 Then      ; het quang cao -> ghi lai de hom nay khong mo lai
			IniWrite ( $sDone , "DailyAds" & $STEXT , "Date" , $sToday )
			AUTOLOG ( "Daily Bonus: het quang cao -> xong" )
			ExitLoop
		EndIf
		_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Daily Bonus: xem quảng cáo " & $n , 0 , 0 )
		AUTOLOG ( "Daily Bonus: xem quang cao " & $n )
		SENDCLICK ( 610 + $APOS [ 0 ] , $iY + $APOS [ 1 ] , $APOS )
		Local $hT = TimerInit ( )
		While TimerDiff ( $hT ) < 60000
			If Not $BRUN Then Return
			Sleep ( 500 )
		WEnd
		; dong quang cao: Home MEmu -> mo lai game
		ControlClick ( $HWND , "" , "[CLASS:Qt5152QWindowIcon; INSTANCE:8]" )
		Sleep ( 5000 )
		SENDCLICK ( 672 + $APOS [ 0 ] , 145 + $APOS [ 1 ] , $APOS )
		Sleep ( 5000 )
		If EXTRATABS ( ) Then
			; da tat het tab + mo lai game + cho ve man chinh -> khong kiem tra "ket" ngay (truoc day restart 2 lan lien)
			EXTRATAB_FIX ( )
		ElseIf Not DB_WAITBACK ( 30 ) And Not ISHOMESCREEN ( ) And Not AD_BACKOUT ( ) And Not AM_GOHOME ( 90000 ) Then      ; 18/11: game tai lai sau quang cao co the > 60s
			; quang cao ket trong tab game -> khong ve duoc Daily Bonus / man chinh -> tat het, mo lai game
			GAMEERRRESTART ( "Quảng cáo kẹt" )
		EndIf
	Next
	; dong bang Daily Bonus
	If DB_ISOPEN ( ) Then SENDCLICK ( 400 + $APOS [ 0 ] , 411 + $APOS [ 1 ] , $APOS )
	Sleep ( 1000 )
	; cac muc xem quang cao phia duoi Daily Bonus (keo xuong): Rewarded Ads Transfer
	ADTRANSFER ( )
EndFunc
; ---------- lenh ADB cho dung may MEmu dang gan (vuot man hinh ma PostMessage khong lam duoc) ----------
; toa do Android = toa do cua so - (1, 33)  (man hinh game 800x400)
Func MEMU_ADB ( $sCmd )
	If Not UI_BINDING_VALID() Then Return False
	Local $target = $HWND
	If $SMEMUC = "" Then
		Local $sExe = _WINAPI_GETPROCESSFILENAME ( WinGetProcess ( $HWND ) )
		If $sExe = "" Then Return False
		$SMEMUC = StringRegExpReplace ( $sExe , "[^\\]+$" , "" ) & "memuc.exe"
	EndIf
	If Not FileExists ( $SMEMUC ) Then Return False
	If $IMEMUIDX < 0 Or $HMEMUIDXWIN <> $target Then
		$IMEMUIDX = -1
		$HMEMUIDXWIN = 0
		Local $iPid = Run ( '"' & $SMEMUC & '" listvms' , "" , @SW_HIDE , $STDOUT_CHILD )
		ProcessWaitClose ( $iPid , 15 )
		Local $aL = StringSplit ( StringStripCR ( StdoutRead ( $iPid ) ) , @LF )
		For $i = 1 To $aL [ 0 ]
			Local $a = StringSplit ( $aL [ $i ] , "," )
			If $a [ 0 ] >= 3 And Number ( $a [ 3 ] ) = Number ( Int ( $target ) ) Then
				$IMEMUIDX = Number ( $a [ 1 ] )
				$HMEMUIDXWIN = $target
				ExitLoop
			EndIf
		Next
		If $IMEMUIDX < 0 Then Return False
	EndIf
	If $target <> $HWND Or Not UI_BINDING_VALID() Then Return False
	RunWait ( '"' & $SMEMUC & '" -i ' & $IMEMUIDX & ' adb "' & $sCmd & '"' , "" , @SW_HIDE )
	Return True
EndFunc
; dung quang cao kieu chung cua auto: doi 60s -> nut Home MEmu -> mo lai game
Func AD_STOPCOMMON ( )
	Local $hT = TimerInit ( )
	While TimerDiff ( $hT ) < 60000
		If Not $BRUN Then Return False
		Sleep ( 500 )
	WEnd
	ControlClick ( $HWND , "" , "[CLASS:Qt5152QWindowIcon; INSTANCE:8]" )
	Sleep ( 5000 )
	SENDCLICK ( 672 + $APOS [ 0 ] , 145 + $APOS [ 1 ] , $APOS )
	Sleep ( 5000 )
	If EXTRATABS ( ) Then EXTRATAB_FIX ( )
	Return True
EndFunc
; chay lenh adb shell, tra ve ket qua (chuoi)
Func MEMU_ADBOUT ( $sCmd )
	If Not MEMU_ADB ( "shell echo" ) Then Return ""      ; dam bao da co $SMEMUC + $IMEMUIDX
	Local $iPid = Run ( '"' & $SMEMUC & '" -i ' & $IMEMUIDX & ' adb "' & $sCmd & '"' , "" , @SW_HIDE , $STDOUT_CHILD )
	ProcessWaitClose ( $iPid , 15 )
	Return StdoutRead ( $iPid )
EndFunc
; ===================== Story x2: da Main Story map 1 man dau, xem quang cao "2x Rewards" (3 lan/ngay) =====================
Func SX_ISSTAGE ( )       ; man chi tiet stage: nut Play Match cam
	; 17/11 Special Scenario (LA): chu "Play Match" de len 595,395 -> them diem cam 620,400 (0xE88D21)
	Return ( CHECKCOLORT ( 595 , 395 , 0xEE9829 , 25 ) Or CHECKCOLORT ( 620 , 400 , 0xE88D21 , 25 ) ) And CHECKCOLORT ( 690 , 395 , 0xEE9829 , 25 ) And CHECKCOLORT ( 360 , 186 , 0x1B597A , 25 )
EndFunc
Func SX_ISFRIEND ( )      ; Select Friend
	Return CHECKCOLORT ( 120 , 92 , 0x4581F0 , 20 ) And CHECKCOLORT ( 470 , 92 , 0x193A77 , 20 ) And CHECKCOLORT ( 640 , 140 , 0xF4E856 , 25 )
EndFunc
Func SX_ISTEAM ( )        ; Select Team: nut Kick-Off
	Return CHECKCOLORT ( 580 , 330 , 0xFFD8A7 , 25 ) And CHECKCOLORT ( 710 , 350 , 0xFFD932 , 25 ) And CHECKCOLORT ( 640 , 365 , 0x333C42 , 20 )
EndFunc
Func SX_ISCLEAR ( )       ; Clear Rewards (nut Go to Scenario List vang)
	Return CHECKCOLORT ( 300 , 70 , 0x155E9E , 20 ) And CHECKCOLORT ( 445 , 408 , 0xF4C434 , 25 )
EndFunc
Func SX_IS2X ( )          ; nut "2x Rewards" con sang
	Return CHECKCOLORT ( 626 , 409 , 0xCC9900 , 20 ) And CHECKCOLORT ( 731 , 399 , 0xF4C434 , 25 )
EndFunc
Func SX_IS2XCONFIRM ( )   ; "Watch an ad to increase rewards by 2 times?"
	Return CHECKCOLORT ( 442 , 286 , 0xCC9900 , 20 ) And CHECKCOLORT ( 532 , 284 , 0xF4C434 , 25 )
EndFunc
; nhan dien cac man trong Story Mode (deu co nut Back/Home cam o goc trai duoi)
Func SX_SCREEN ( $sWhat )
	If Not ( CHECKCOLORT ( 30 , 413 , 0xC95F13 , 20 ) And CHECKCOLORT ( 130 , 413 , 0xE06B16 , 20 ) ) Then Return False
	Switch $sWhat
		Case "storymenu"
			Return CHECKCOLORT ( 20 , 48 , 0x2D363D , 15 ) And CHECKCOLORT ( 150 , 48 , 0x79B5F4 , 15 )
		Case "mainstory"
			Return CHECKCOLORT ( 20 , 48 , 0x756B49 , 15 ) And CHECKCOLORT ( 150 , 48 , 0x79B5F4 , 15 )
		Case "stagelist"
			Return CHECKCOLORT ( 150 , 48 , 0x72B0C7 , 15 ) And CHECKCOLORT ( 240 , 48 , 0x73ACC0 , 15 )
	EndSwitch
	Return False
EndFunc
Func SX_ATFROM ( $sFrom )
	If $sFrom = "home" Then Return ISHOMESCREEN ( )
	Return SX_SCREEN ( $sFrom )
EndFunc
Func SX_CLICKWAIT ( $iX , $iY , $sWhat , $sFrom )
	Local $hT = TimerInit ( ) , $hC = 0
	While TimerDiff ( $hT ) < 30000
		If Not $BRUN Then Return False
		If SX_SCREEN ( $sWhat ) Then
			Sleep ( 1000 )
			Return True
		EndIf
		If NETRETRY ( ) Then ContinueLoop
		; chi bam (lai) khi van dang o man truoc - tranh bam nham luc dang tai man moi
		If ( $hC = 0 Or TimerDiff ( $hC ) > 6000 ) And SX_ATFROM ( $sFrom ) Then
			SENDCLICK ( $iX + $APOS [ 0 ] , $iY + $APOS [ 1 ] , $APOS )
			$hC = TimerInit ( )
		EndIf
		Sleep ( 500 )
	WEnd
	Return False
EndFunc
; Home -> Story Mode -> Main Story -> map 1 -> keo xuong cuoi -> man dau tien
Func SX_GOSTAGE1 ( )
	If Not ISHOMESCREEN ( ) Then
		If Not AM_GOHOME ( 60000 ) Then Return False
	EndIf
	Sleep ( 2000 )
	If Not ISHOMESCREEN ( ) Then Return False      ; vua bat popup -> lan sau thu lai
	; moi buoc: bam roi cho dung man hien ra (bam lai moi 6s, toi da 30s)
	If Not SX_CLICKWAIT ( 627 , 255 , "storymenu" , "home" ) Then Return False     ; Story Mode
	If Not SX_CLICKWAIT ( 178 , 170 , "mainstory" , "storymenu" ) Then Return False     ; Main Story
	; danh sach map nho vi tri cuon lan truoc (co may dang o map cuoi, map kho) -> vuot ve dau danh sach
	For $k = 1 To 4
		MEMU_ADB ( "shell input swipe 150 180 760 180 300" )
		Sleep ( 800 )
	Next
	Sleep ( 1000 )
	If Not SX_CLICKWAIT ( 120 , 210 , "stagelist" , "mainstory" ) Then Return False     ; map 1 (Middle School Players episodes)
	Sleep ( 1500 )
	If Not $BRUN Then Return False
	MEMU_ADB ( "shell input swipe 743 62 743 395 800" )                ; keo thanh cuon xuong cuoi
	Sleep ( 1500 )
	MEMU_ADB ( "shell input swipe 500 330 500 60 500" )
	Sleep ( 2000 )
	SENDCLICK ( 520 + $APOS [ 0 ] , 367 + $APOS [ 1 ] , $APOS )     ; man duoi cung = man 1
	For $w = 1 To 20
		If Not $BRUN Then Return False
		Sleep ( 500 )
		If SX_ISSTAGE ( ) Then
			Sleep ( 1000 )
			; chac chan dung man 1 map 1 ("Shizuoka Prefecture Final", Normal, the S xanh) - sai thi KHONG da
			If SX_ISSTAGE1 ( ) Then Return True
			IniWrite ( @ScriptDir & "\auto_done.ini" , "StoryX2" & $STEXT , "Wrong" , _NOW ( ) & " vao nham man -> khong da" )
			AUTOLOG ( "Story x2: VAO NHAM MAN (khong phai man 1 map 1) -> khong da" )
			Return False
		EndIf
	Next
	Return False
EndFunc
Func SX_ISSTAGE1 ( )
	Return CHECKCOLORT ( 525 , 135 , 0x299108 , 25 ) And CHECKCOLORT ( 330 , 131 , 0xFFFF9A , 20 ) And CHECKCOLORT ( 150 , 160 , 0xFFC47A , 25 )
EndFunc
; $bForce = True: goi luc het luot Daily -> tu ve man hinh chinh roi lam
Func STORYX2 ( $bForce = False )
	If $BADS <> 1 Or Not $BRUN Then Return
	Local $sIni = @ScriptDir & "\auto_done.ini" , $sToday = GAMEDAY ( )
	If IniRead ( $sIni , "StoryX2" & $STEXT , "Date" , "" ) <> $sToday Then
		IniWrite ( $sIni , "StoryX2" & $STEXT , "Date" , $sToday )
		IniWrite ( $sIni , "StoryX2" & $STEXT , "Ads" , 0 )
		IniWrite ( $sIni , "StoryX2" & $STEXT , "Tries" , 0 )
		IniWrite ( $sIni , "StoryX2" & $STEXT , "Done" , 0 )
	EndIf
	If Number ( IniRead ( $sIni , "StoryX2" & $STEXT , "Done" , 0 ) ) = 1 Then Return
	If Number ( IniRead ( $sIni , "StoryX2" & $STEXT , "Tries" , 0 ) ) >= 10 Then Return
	If $bForce And Not ISHOMESCREEN ( ) Then AM_GOHOME ( 60000 )
	If $BRUN And Not ISHOMESCREEN ( ) Then GIFT_WAIT ( "home" , 20 )
	If Not ISHOMESCREEN ( ) Then Return
	While $BRUN And Number ( IniRead ( $sIni , "StoryX2" & $STEXT , "Ads" , 0 ) ) < 3
		IniWrite ( $sIni , "StoryX2" & $STEXT , "Tries" , Number ( IniRead ( $sIni , "StoryX2" & $STEXT , "Tries" , 0 ) ) + 1 )
		If Number ( IniRead ( $sIni , "StoryX2" & $STEXT , "Tries" , 0 ) ) > 10 Then ExitLoop
		_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Story x2: vào Main Story màn 1" , 0 , 0 )
		AUTOLOG ( "Story x2: vao Main Story man 1 (lan thu " & IniRead ( $sIni , "StoryX2" & $STEXT , "Tries" , 0 ) & ")" )
		If Not SX_GOSTAGE1 ( ) Then
			AM_GOHOME ( 60000 )
			Return
		EndIf
		SENDCLICK ( 642 + $APOS [ 0 ] , 378 + $APOS [ 1 ] , $APOS )     ; Play Match
		Local $hRound = TimerInit ( )
		Local $iRes = SX_PLAYROUND ( )
		IniWrite ( $sIni , "StoryX2" & $STEXT , "Last" , _NOW ( ) & " ket qua=" & $iRes & " (1=xem ad, 2=het luot 2x, 0=loi/qua gio) " & Int ( TimerDiff ( $hRound ) / 1000 ) & "s" )
		AUTOLOG ( "Story x2: luot xong, ket qua=" & $iRes & " (1=xem ad, 2=het luot 2x, 0=loi/qua gio) " & Int ( TimerDiff ( $hRound ) / 1000 ) & "s" )
		If $iRes = 1 Then IniWrite ( $sIni , "StoryX2" & $STEXT , "Ads" , Number ( IniRead ( $sIni , "StoryX2" & $STEXT , "Ads" , 0 ) ) + 1 )
		If $iRes = 2 Then IniWrite ( $sIni , "StoryX2" & $STEXT , "Done" , 1 )    ; het luot 2x
		AM_GOHOME ( 60000 )
		If $iRes = 2 Or $iRes = 0 Then ExitLoop
	WEnd
	If Number ( IniRead ( $sIni , "StoryX2" & $STEXT , "Ads" , 0 ) ) >= 3 Then IniWrite ( $sIni , "StoryX2" & $STEXT , "Done" , 1 )
EndFunc
; 1 tran: chon ban -> Kick-Off -> (tran tu da Auto) -> bam qua ket qua -> 2x Rewards -> xem ad
; tra ve 1 = da xem ad x2, 2 = nut 2x da het, 0 = loi / qua gio
Func SX_PLAYROUND ( )
	Local $hT = TimerInit ( ) , $sSig = "" , $hStatic = TimerInit ( ) , $bAd = False , $hAdBack = TimerInit ( ) , $bAdRestart = False
	While TimerDiff ( $hT ) < 600000      ; toi da 10 phut / tran (tran dai + loi ket noi)
		If Not $BRUN Then Return 0
		DIALOGHANDLING ( )
		; sau quang cao game co the quay ve thang man hinh chinh -> xong luot nay
		If $bAd And ISHOMESCREEN ( ) Then
			Sleep ( 1500 )
			If ISHOMESCREEN ( ) Then Return 1
		EndIf
		If SX_IS2XCONFIRM ( ) Then
			_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Story x2: xem quảng cáo" , 0 , 0 )
			SENDCLICK ( 490 + $APOS [ 0 ] , 287 + $APOS [ 1 ] , $APOS )     ; Watch an ad.
			If Not AD_STOPCOMMON ( ) Then Return 0
			$bAd = True
			$hStatic = TimerInit ( )
			$hAdBack = TimerInit ( )
		ElseIf $bAd And Not $bAdRestart And TimerDiff ( $hAdBack ) > 45000 And TABFIXOLD ( ) And Not ISHOMESCREEN ( ) Then
			; 45s sau khi thoat quang cao van chua ve man game (quang cao choi thu ket trong tab game) -> tat het, mo lai game
			If Not AD_BACKOUT ( ) Then GAMEERRRESTART ( "Quảng cáo kẹt" )
			$bAdRestart = True
		ElseIf SX_ISCLEAR ( ) Then
			If SX_IS2X ( ) And Not $bAd Then
				SENDCLICK ( 675 + $APOS [ 0 ] , 408 + $APOS [ 1 ] , $APOS )  ; 2x Rewards
				Sleep ( 2000 )
				If Not SX_IS2XCONFIRM ( ) And SX_ISCLEAR ( ) Then
					; khong hien hop xac nhan = het luot 2x
					SENDCLICK ( 445 + $APOS [ 0 ] , 408 + $APOS [ 1 ] , $APOS )
					Sleep ( 3000 )
					Return 2
				EndIf
			Else
				SENDCLICK ( 445 + $APOS [ 0 ] , 408 + $APOS [ 1 ] , $APOS )  ; Go to Scenario List
				Sleep ( 3000 )
				If $bAd Then Return 1
				Return 2
			EndIf
		ElseIf SX_ISFRIEND ( ) Then
			SENDCLICK ( 330 + $APOS [ 0 ] , 150 + $APOS [ 1 ] , $APOS )      ; ban dau tien
			Sleep ( 3000 )
		ElseIf SX_ISTEAM ( ) Then
			SENDCLICK ( 645 + $APOS [ 0 ] , 340 + $APOS [ 1 ] , $APOS )      ; Kick-Off
			Sleep ( 5000 )
		ElseIf SX_ISSTAGE ( ) And TimerDiff ( $hT ) > 20000 Then
			SENDCLICK ( 642 + $APOS [ 0 ] , 378 + $APOS [ 1 ] , $APOS )      ; Play Match (bam lai)
			Sleep ( 4000 )
		ElseIf $bAd Then
			; sau quang cao: "Rewards Earned" (phao giay bay lien tuc) -> cham ngay chu "Earned" moi 3s
			SENDCLICK ( 470 + $APOS [ 0 ] , 300 + $APOS [ 1 ] , $APOS )
			Sleep ( 2300 )
		Else
			; man "Tap Screen" (Scenario Clear / diem / Rewards Earned): dung yen > 5s thi cham cho trong ben phai
			; (trong tran man hinh luon chuyen dong nen khong cham -> khong tat High-Speed)
			Local $s = MEMORYREADPIXEL ( 100 , 100 , $HWND ) & MEMORYREADPIXEL ( 400 , 200 , $HWND ) & MEMORYREADPIXEL ( 700 , 300 , $HWND ) & MEMORYREADPIXEL ( 250 , 380 , $HWND )
			If $s <> $sSig Then
				$sSig = $s
				$hStatic = TimerInit ( )
			ElseIf TimerDiff ( $hStatic ) > 5000 Then
				SENDCLICK ( 760 + $APOS [ 0 ] , 250 + $APOS [ 1 ] , $APOS )
				$hStatic = TimerInit ( )
			EndIf
		EndIf
		Sleep ( 700 )
	WEnd
	Return 0
EndFunc
; 18/11: co "da sang Special Scenario hom nay" ([EventNew<may>] Special = ngay) + nhan ra man chon su kien (hub)
Func EVN_SPECIALTODAY ( )
	Return IniRead ( @ScriptDir & "\auto_done.ini" , "EventNew" & $STEXT , "Special" , "" ) = GAMEDAY ( )
EndFunc
Func EVN_SETSPECIAL ( )
	IniWrite ( @ScriptDir & "\auto_done.ini" , "EventNew" & $STEXT , "Special" , GAMEDAY ( ) )
EndFunc
Func EVN_ISSPECMENU ( )
	; nut "Details" vang o day cac the (giong nhau o moi may), khong phai danh sach map / hub
	Return CHECKCOLORT ( 395 , 262 , 0xFCDB4E , 15 ) And CHECKCOLORT ( 395 , 275 , 0x79561A , 15 ) And CHECKCOLORT ( 180 , 275 , 0x7D5A1E , 15 ) And CHECKCOLORT ( 30 , 413 , 0xC95F13 , 20 ) And CHECKCOLORT ( 130 , 413 , 0xE06B16 , 20 ) And Not EVN_ISLIST ( ) And Not EVN_ISHUB ( )
EndFunc
Func EVN_ISHUB ( )
	; man hinh chon su kien: tieu de + nut Back/Home cam + nut vang "Exchange Shop" goc phai duoi, KHONG phai danh sach map
	Return CHECKCOLORT ( 23 , 43 , 0xFDF25F , 15 ) And CHECKCOLORT ( 30 , 413 , 0xC95F13 , 20 ) And CHECKCOLORT ( 130 , 413 , 0xE06B16 , 20 ) And CHECKCOLORT ( 676 , 400 , 0xF9F361 , 25 ) And CHECKCOLORT ( 770 , 400 , 0xF9F361 , 25 ) And Not EVN_ISLIST ( )
EndFunc
; ===================== Event: chon cac map NEW o man "Event Matches" (vao tran do che do Event co san lo) =====================
; man danh sach Event Matches: nut Back/Home cam, chu "Event Matches" vang, nut xanh "To Event Exchange Shop"
; 17/11: them man "Special Scenario" (may LA): cung nut Back/Home cam + chu vang, cho nut xanh la
; la nut xanh duong "Achievement Reward" (80,352 0x3B65EE; 250,380 0x386EEB). Map moi (NEW) nam TREN CUNG,
; phai keo danh sach len moi thay -> EVENTNEW da tu cuon len dau truoc khi do tung trang.
Func EVN_ISLIST ( )
	If Not ( CHECKCOLORT ( 30 , 413 , 0xC95F13 , 20 ) And CHECKCOLORT ( 130 , 413 , 0xE06B16 , 20 ) And CHECKCOLORT ( 23 , 43 , 0xFDF25F , 15 ) ) Then Return False
	If CHECKCOLORT ( 100 , 355 , 0x5DB757 , 20 ) And CHECKCOLORT ( 250 , 355 , 0x2F864C , 20 ) Then Return True      ; Event Matches
	Return EVN_ISSPECIAL ( )      ; Special Scenario
EndFunc
Func EVN_ISSPECIAL ( )
	Return CHECKCOLORT ( 80 , 352 , 0x3B65EE , 20 ) And CHECKCOLORT ( 250 , 380 , 0x386EEB , 20 ) And CHECKCOLORT ( 100 , 355 , 0x1A6EFA , 20 )
EndFunc
Func EVN_PX ( $hDC , $x , $y )      ; tra ve 0xRRGGBB
	Local $a = DllCall ( "gdi32.dll" , "int" , "GetPixel" , "handle" , $hDC , "int" , $x , "int" , $y )
	If @error Then Return 0
	Local $c = $a [ 0 ]
	Return BitOR ( BitShift ( BitAND ( $c , 255 ) , - 16 ) , BitAND ( $c , 0xFF00 ) , BitAND ( BitShift ( $c , 16 ) , 255 ) )
EndFunc
Func EVN_ISRED ( $c )
	Return BitAND ( BitShift ( $c , 16 ) , 255 ) > 200 And BitAND ( BitShift ( $c , 8 ) , 255 ) < 130 And BitAND ( $c , 255 ) < 130
EndFunc
; NHAN "NEW" CHI LA "CHUA MO XEM" (mo ra la mat) -> KHONG dung. Hang da thang co nhan Clear/Complete!
; va dau tich XANH o o huy chuong ben phai; hang chua thang thi o do mau xam.
; Moi hang: o xanh "Recommended Total Power" (x=412) bat dau o y = T (hang cach nhau 95px).
Func EVN_ISBLUE ( $c )
	Local $r = BitAND ( BitShift ( $c , 16 ) , 255 ) , $g = BitAND ( BitShift ( $c , 8 ) , 255 ) , $b = BitAND ( $c , 255 )
	Return $b > 190 And $r < 70 And $g > 90 And $g < 135
EndFunc
Func EVN_ISGREEN ( $c )
	Local $r = BitAND ( BitShift ( $c , 16 ) , 255 ) , $g = BitAND ( BitShift ( $c , 8 ) , 255 ) , $b = BitAND ( $c , 255 )
	Return $g > $r + 50 And $g > $b + 20
EndFunc
; tra ve mang T cua cac hang CHUA THANG hien du tren man ($a[0] = so hang). $bAll = True: tra ve moi hang
Func EVN_SCAN ( $bAll = False )
	; Special Scenario: nut "Story History" (goc phai duoi) che dau tich cua hang sat day -> bo qua hang T > 360
	Local $iMaxT = 400
	If EVN_ISSPECIAL ( ) Then $iMaxT = 360
	Local $hDC = _WINAPI_GETWINDOWDC ( $HWND ) , $s = ""
	Local $y = 88
	While $y <= $iMaxT      ; hang cuoi danh sach (cuon het) co o xanh o y ~395
		If EVN_ISBLUE ( EVN_PX ( $hDC , 412 , $y ) ) And Not EVN_ISBLUE ( EVN_PX ( $hDC , 412 , $y - 1 ) ) And EVN_ISBLUE ( EVN_PX ( $hDC , 412 , $y + 3 ) ) And EVN_ISBLUE ( EVN_PX ( $hDC , 470 , $y + 3 ) ) Then
			; da thang: dau tich xanh tren o cau vong ben phai (>= 2 diem xanh)
			Local $iG = 0
			If EVN_ISGREEN ( EVN_PX ( $hDC , 705 , $y + 1 ) ) Then $iG += 1
			If EVN_ISGREEN ( EVN_PX ( $hDC , 705 , $y + 5 ) ) Then $iG += 1
			If EVN_ISGREEN ( EVN_PX ( $hDC , 710 , $y + 5 ) ) Then $iG += 1
			If EVN_ISGREEN ( EVN_PX ( $hDC , 695 , $y + 10 ) ) Then $iG += 1
			If EVN_ISGREEN ( EVN_PX ( $hDC , 715 , $y + 10 ) ) Then $iG += 1
			If $bAll Or $iG < 2 Then $s &= $y & ","
			$y += 60
		Else
			$y += 1
		EndIf
	WEnd
	_WINAPI_RELEASEDC ( $HWND , $hDC )
	If $s = "" Then
		Local $a [ 1 ] = [ 0 ]
		Return $a
	EndIf
	Return StringSplit ( StringTrimRight ( $s , 1 ) , "," )
EndFunc
; dau van tay 1 hang (ten doi thu + so luc chien) de nhan ra map da thu ma van chua thang (thua)
Func EVN_FP ( $y )
	Local $hDC = _WINAPI_GETWINDOWDC ( $HWND ) , $s = "" , $c
	; chu ten doi thu (T-25, T-21) va so luc chien (T+11, T+15), diem toi = 1
	Local $aL [ 4 ] [ 3 ] = [ [ - 25 , 385 , 520 ] , [ - 21 , 385 , 520 ] , [ 11 , 520 , 650 ] , [ 15 , 520 , 650 ] ]
	For $i = 0 To 3
		For $x = $aL [ $i ] [ 1 ] To $aL [ $i ] [ 2 ] Step 3
			$c = EVN_PX ( $hDC , $x , $y + $aL [ $i ] [ 0 ] )
			If BitAND ( BitShift ( $c , 16 ) , 255 ) + BitAND ( BitShift ( $c , 8 ) , 255 ) + BitAND ( $c , 255 ) < 270 Then
				$s &= "1"
			Else
				$s &= "0"
			EndIf
		Next
	Next
	_WINAPI_RELEASEDC ( $HWND , $hDC )
	Return $s
EndFunc
Func EVN_FPSAME ( $a , $b )
	If StringLen ( $a ) <> StringLen ( $b ) Then Return False
	Local $d = 0 , $n = 0
	For $i = 1 To StringLen ( $a )
		If StringMid ( $a , $i , 1 ) <> StringMid ( $b , $i , 1 ) Then $d += 1
		If StringMid ( $a , $i , 1 ) = "1" Or StringMid ( $b , $i , 1 ) = "1" Then $n += 1
	Next
	If $n < 8 Then Return False      ; hang trong / chua ve xong
	Return $d <= Int ( $n / 4 )
EndFunc
; so lan da bam Play Match hom nay cho map co dau van tay nay ([EventNew<may>] Fn = "ngay|so lan|dau van tay")
Func EVN_TRIES ( $sFp , $bAdd = False )
	Local $sIni = @ScriptDir & "\auto_done.ini" , $sSec = "EventNew" & $STEXT , $sToday = GAMEDAY ( )
	Local $aS = IniReadSection ( $sIni , $sSec ) , $a , $iFree = 0
	If Not @error Then
		For $i = 1 To $aS [ 0 ] [ 0 ]
			$a = StringSplit ( $aS [ $i ] [ 1 ] , "|" )
			If $a [ 0 ] < 3 Or $a [ 1 ] <> $sToday Then
				If $iFree = 0 Then $iFree = $i
				ContinueLoop
			EndIf
			If EVN_FPSAME ( $a [ 3 ] , $sFp ) Then
				If $bAdd Then IniWrite ( $sIni , $sSec , $aS [ $i ] [ 0 ] , $sToday & "|" & ( Number ( $a [ 2 ] ) + 1 ) & "|" & $a [ 3 ] )
				Return Number ( $a [ 2 ] )
			EndIf
		Next
	EndIf
	If $bAdd Then
		Local $sKey = "F1"
		If $iFree > 0 Then
			$sKey = $aS [ $iFree ] [ 0 ]
		ElseIf IsArray ( $aS ) Then
			; ten khoa chua dung
			Local $iK = $aS [ 0 ] [ 0 ] + 1
			While IniRead ( $sIni , $sSec , "F" & $iK , "" ) <> ""
				$iK += 1
			WEnd
			$sKey = "F" & $iK
		EndIf
		IniWrite ( $sIni , $sSec , $sKey , $sToday & "|1|" & $sFp )
	EndIf
	Return 0
EndFunc
; so lan toi da da 1 map/ngay. 18/11 user chon "da toi khi thang" -> mac dinh KHONG gioi han.
; Muon gioi han: [Config] EventMaxTries=N trong custom_clicks.ini (0 = khong gioi han)
Func EVN_MAXTRY ( )
	Local $n = Number ( IniRead ( $SCUSTOMINI , "Config" , "EventMaxTries" , "0" ) )
	If $n <= 0 Then Return 1000000
	Return $n
EndFunc
; tim hang chua thang dau tien, chua thua qua EVN_MAXTRY lan hom nay -> tra ve T (0 = khong co)
Func EVN_PICK ( )
	Local $aY = EVN_SCAN ( )
	For $i = 1 To $aY [ 0 ]
		Local $y = Number ( $aY [ $i ] )
		If EVN_TRIES ( EVN_FP ( $y ) ) < EVN_MAXTRY ( ) Then Return $y
	Next
	Return 0
EndFunc
; chu ky man hinh danh sach (de biet da cuon toi cuoi chua)
Func EVN_SIG ( )
	Return MEMORYREADPIXEL ( 450 , 120 , $HWND ) & MEMORYREADPIXEL ( 600 , 200 , $HWND ) & MEMORYREADPIXEL ( 500 , 300 , $HWND ) & MEMORYREADPIXEL ( 743 , 250 , $HWND ) & MEMORYREADPIXEL ( 743 , 380 , $HWND )
EndFunc
; hang dang mo (co nut Play Match): hang do nam tren cung, o xanh T < 135. Tra ve T neu hang do CHUA THANG, 0 neu da thang
Func EVN_OPENROW ( )
	Local $aA = EVN_SCAN ( True )
	If $aA [ 0 ] < 1 Or Number ( $aA [ 1 ] ) >= 135 Then Return - 1      ; khong thay hang
	Local $aY = EVN_SCAN ( )
	If $aY [ 0 ] >= 1 And Number ( $aY [ 1 ] ) = Number ( $aA [ 1 ] ) Then Return Number ( $aY [ 1 ] )
	Return 0
EndFunc
; bang "Energy Recovered" (sau khi Restore): bam OK. 17/11: diem 400,300 nam tren CHU "OK" (trang/xam)
; nen truoc day khong khop -> dung nen xanh cua nut (360,290 0xA6F45A; 440,305 0x81CA40) + thanh tieu de xanh
; 250,152 0x3E7CED + o "Owned" xam toi 500,258. Goi ca trong DIALOGHANDLING (moi che do).
Func EVN_ENERGYOK ( )
	If CHECKCOLORT ( 360 , 290 , 0xA6F45A , 25 ) And CHECKCOLORT ( 440 , 305 , 0x81CA40 , 25 ) And CHECKCOLORT ( 250 , 152 , 0x3E7CED , 25 ) And CHECKCOLORT ( 500 , 258 , 0x3A434A , 25 ) Then
		SENDCLICK ( 400 + $APOS [ 0 ] , 300 + $APOS [ 1 ] , $APOS )
		Sleep ( 1000 )
		Return True
	EndIf
	Return False
EndFunc
; bang "Recover Energy" (Cancel / Restore / Watch an ad)
Func EVN_ISRECOVER ( )
	Return CHECKCOLORT ( 400 , 68 , 0x3063C5 , 20 ) And CHECKCOLORT ( 400 , 382 , 0xFFFFFF , 10 ) And CHECKCOLORT ( 250 , 382 , 0x997680 , 30 )
EndFunc
; user chon: che do Event thieu bong -> Restore bang 1 Dreamball. Toi da 10 lan/ngay ([EventNew<may>] Restore).
; Tat: [Config] EventDreamball=0 trong custom_clicks.ini
Func EVN_RESTORE ( )
	If IniRead ( $SCUSTOMINI , "Config" , "EventDreamball" , "1" ) <> "1" Then Return False
	Local $sIni = @ScriptDir & "\auto_done.ini" , $sSec = "EventNew" & $STEXT , $sToday = GAMEDAY ( )
	Local $a = StringSplit ( IniRead ( $sIni , $sSec , "Restore" , "" ) , "|" )
	Local $n = 0
	If $a [ 0 ] >= 2 And $a [ 1 ] = $sToday Then $n = Number ( $a [ 2 ] )
	If $n >= 10 Then Return False
	IniWrite ( $sIni , $sSec , "Restore" , $sToday & "|" & ( $n + 1 ) )
	SENDCLICK ( 400 + $APOS [ 0 ] , 382 + $APOS [ 1 ] , $APOS )      ; Restore
	; bang "Energy Recovered" -> OK (400,300)
	Local $hT = TimerInit ( )
	While TimerDiff ( $hT ) < 10000
		Sleep ( 800 )
		If EVN_ENERGYOK ( ) Then ExitLoop
	WEnd
	AUTOLOG ( "Event: thieu nang luong -> Restore bang 1 Dreamball (lan " & ( $n + 1 ) & " hom nay)" )
	_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Event: hồi bóng bằng Dreamball" , 0 , 0 )
	Sleep ( 1500 )
	Return True
EndFunc
; dang mo hang chua thang $T: bam Play Match -> Solo Play. Chi tinh 1 lan thu khi vao duoc man chon ban (du nang luong).
; Thieu nang luong -> bang Recover Energy: de che do Event co san xu ly.
Func EVN_START ( $T , $sWhy )
	Local $sFp = EVN_FP ( $T )
	Local $n = EVN_TRIES ( $sFp )
	If $n >= EVN_MAXTRY ( ) Then
		AUTOLOG ( "Event: map nay da thua " & $n & " lan hom nay -> bo qua" )
		Return False
	EndIf
	_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Event: đá map chưa clear (lần " & ( $n + 1 ) & ")" , 0 , 0 )
	AUTOLOG ( "Event: " & $sWhy & " -> Play Match (lan thu " & ( $n + 1 ) & " hom nay)" )
	SENDCLICK ( 642 + $APOS [ 0 ] , 378 + $APOS [ 1 ] , $APOS )      ; Play Match
	Local $hT = TimerInit ( ) , $bSolo = False , $iRestore = 0
	While TimerDiff ( $hT ) < 15000
		If Not $BRUN Then Return True
		If Not $bSolo And CHECKCOLORT ( 100 , 120 , 0xA2F800 , 25 ) And CHECKCOLORT ( 153 , 170 , 0xAA0112 , 20 ) Then
			SENDCLICK ( 160 + $APOS [ 0 ] , 230 + $APOS [ 1 ] , $APOS )      ; Solo Play
			$bSolo = True
			Sleep ( 1000 )
		EndIf
		If SX_ISFRIEND ( ) Then
			EVN_TRIES ( $sFp , True )
			Return True
		EndIf
		If EVN_ISRECOVER ( ) Then
			If $iRestore >= 1 Or Not EVN_RESTORE ( ) Then
				AUTOLOG ( "Event: thieu nang luong (Recover Energy) -> de che do Event xu ly" )
				Return True
			EndIf
			$iRestore += 1
			$bSolo = False
			$hT = TimerInit ( )
		EndIf
		Sleep ( 400 )
	WEnd
	Return True
EndFunc
; goi dau AUTOVEN: dang o man Event Matches thi chon map CHUA CLEAR. Tra ve True neu da bam vao 1 map
Func EVENTNEW ( )
	If Not EVN_ISLIST ( ) Then Return False
	If $HEVNWAIT <> 0 And TimerDiff ( $HEVNWAIT ) < 1200000 Then Return False
	Sleep ( 1000 )
	If Not EVN_ISLIST ( ) Then Return False
	Local $T
	; dang mo san 1 hang (hien nut Play Match)
	If SX_ISSTAGE ( ) Then
		$T = EVN_OPENROW ( )
		If $T > 0 And EVN_TRIES ( EVN_FP ( $T ) ) < EVN_MAXTRY ( ) Then Return EVN_START ( $T , "hang dang mo chua clear" )
		SENDCLICK ( 520 + $APOS [ 0 ] , 100 + $APOS [ 1 ] , $APOS )      ; dong hang lai
		Sleep ( 1500 )
		If SX_ISSTAGE ( ) Then
			AUTOLOG ( "Event: dong hang dang mo khong duoc" )
			Return False
		EndIf
	EndIf
	_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Event: tìm map chưa clear" , 0 , 0 )
	Local $y = EVN_PICK ( )
	If $y = 0 And EVN_ISSPECIAL ( ) Then
		; Special Scenario (~100 map): map moi luon nam TREN CUNG -> keo len toi dau (man hinh het doi)
		; roi chi xem trang dau, khong do xuong tung trang
		Local $sTop = "" , $sNow
		For $k = 1 To 60
			If Not $BRUN Or Not EVN_ISLIST ( ) Then Return False
			; keo NHANH (150-300ms) danh sach nay khong nhuc nhich -> keo cham 600ms
			MEMU_ADB ( "shell input swipe 450 150 450 380 600" )
			Sleep ( 900 )
			$sNow = EVN_SIG ( )
			If $k >= 3 And $sNow = $sTop Then ExitLoop
			$sTop = $sNow
		Next
		Sleep ( 1500 )
		If Not $BRUN Or Not EVN_ISLIST ( ) Then Return False
		$y = EVN_PICK ( )
	ElseIf $y = 0 Then
		; cuon len dau danh sach roi xuong tung trang
		; 17/11 (EU): keo nhanh 200ms KHONG cuon -> keo cham 600ms toi khi man hinh het doi (= dau danh sach)
		Local $sTop2 = "" , $sNow2
		For $k = 1 To 60
			If Not $BRUN Or Not EVN_ISLIST ( ) Then Return False
			MEMU_ADB ( "shell input swipe 450 150 450 380 600" )
			Sleep ( 900 )
			$sNow2 = EVN_SIG ( )
			If $k >= 3 And $sNow2 = $sTop2 Then ExitLoop
			$sTop2 = $sNow2
		Next
		Sleep ( 1500 )
		Local $sSig = "" , $sNew , $iSame = 0
		For $p = 1 To 50      ; moi lan keo xuong ~2 hang
			If Not $BRUN Or Not EVN_ISLIST ( ) Then Return False
			$y = EVN_PICK ( )
			If $y > 0 Then ExitLoop
			$sNew = EVN_SIG ( )
			; 17/11 (EU): 1 lan keo co the khong an -> phai 2 lan lien khong doi moi coi la cuoi danh sach
			If $sNew = $sSig Then
				$iSame += 1
				If $iSame >= 2 Then ExitLoop
			Else
				$iSame = 0
			EndIf
			$sSig = $sNew
			MEMU_ADB ( "shell input swipe 450 380 450 150 600" )
			Sleep ( 1800 )
		Next
	EndIf
	If $y = 0 And Not EVN_ISSPECIAL ( ) And Not EVN_SPECIALTODAY ( ) Then
		; 18/11: Dream Championship (Event Matches) het map -> chuyen sang Special Scenario (~100 map) roi moi dung
		EVN_SETSPECIAL ( )
		AUTOLOG ( "Event: het map Event Matches -> chuyen sang Special Scenario" )
		_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Event: hết map Event Matches -> sang Special Scenario" , 0 , 0 )
		SENDCLICK ( 50 + $APOS [ 0 ] , 413 + $APOS [ 1 ] , $APOS )      ; Back
		Sleep ( 3000 )
		Return True
	EndIf
	If $y = 0 Then
		$HEVNWAIT = TimerInit ( )
		; user chon 16/11: het map chua clear -> TU DUNG auto (khong de che do Event cu da lai map cu)
		_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Event: đã clear hết map -> dừng" , 0 , 0 )
		AUTOLOG ( "Event: khong con map chua clear (hoac da thua 2 lan hom nay) -> DUNG AUTO" )
		$BRUN = False
		_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Sẵn sàng" , 1 , 0 )
		UI_RUN_BUTTON(False)
		AM_QUEUENEXT ( )   ; chay lan luot: sang che do ke (neu co)
		Return True
	EndIf
	; bam vao hang -> hang mo ra, nhay len tren cung
	Local $sFc = EVN_FP ( $y )      ; dau van tay luc dong (lay TRUOC khi bam, sau do danh sach doi cho)
	SENDCLICK ( 520 + $APOS [ 0 ] , $y - 20 + $APOS [ 1 ] , $APOS )
	Local $hT = TimerInit ( )
	While Not SX_ISSTAGE ( )
		If Not $BRUN Then Return False
		If TimerDiff ( $hT ) > 8000 Then
			AUTOLOG ( "Event: bam hang T=" & $y & " nhung khong thay nut Play Match" )
			Return False
		EndIf
		Sleep ( 400 )
	WEnd
	Sleep ( 1000 )
	$T = EVN_OPENROW ( )
	If $T <= 0 Then
		AUTOLOG ( "Event: hang vua mo khong phai hang chua clear -> dong lai" )
		SENDCLICK ( 520 + $APOS [ 0 ] , 100 + $APOS [ 1 ] , $APOS )
		Sleep ( 1500 )
		Return False
	EndIf
	If EVN_TRIES ( EVN_FP ( $T ) ) >= EVN_MAXTRY ( ) Then
		; dau van tay luc dong khac luc mo -> ghi them ban "dong" de lan quet sau khong chon lai
		For $k = 1 To EVN_MAXTRY ( )
			If $k > 50 Or EVN_TRIES ( $sFc ) >= EVN_MAXTRY ( ) Then ExitLoop
			EVN_TRIES ( $sFc , True )
		Next
		AUTOLOG ( "Event: map nay da thua nhieu lan hom nay -> bo qua" )
		SENDCLICK ( 520 + $APOS [ 0 ] , 100 + $APOS [ 1 ] , $APOS )
		Sleep ( 1500 )
		Return False
	EndIf
	Return EVN_START ( $T , "chon hang chua clear T=" & $y )
EndFunc
; ===================== Rewarded Ads Transfer (Daily Bonus > keo xuong > Go to Transfers) =====================
Func AT_ISBANNER ( )      ; man "Rewarded Ads Transfer" luc moi vao (nut Ad Transfer goc phai)
	Return CHECKCOLORT ( 610 , 340 , 0xA1DDFF , 25 ) And CHECKCOLORT ( 660 , 335 , 0xCEF5FD , 25 )
EndFunc
Func AT_ISRESULT ( )      ; man ket qua sau khi quay (nut Ad Transfer giua duoi; het luot thi nut xam "Max number of ads viewed")
	If CHECKCOLORT ( 330 , 375 , 0x93D9FF , 25 ) And CHECKCOLORT ( 335 , 390 , 0x00225E , 25 ) Then Return True
	Return CHECKCOLORT ( 330 , 375 , 0x3A5564 , 20 ) And CHECKCOLORT ( 335 , 390 , 0x000D24 , 15 ) And CHECKCOLORT ( 400 , 362 , 0x5F5F5F , 20 )
EndFunc
Func AT_ISCONFIRM ( )     ; "Watch an ad to spin." Cancel / Perform Transfer
	Return CHECKCOLORT ( 425 , 306 , 0xA9F75D , 25 ) And CHECKCOLORT ( 265 , 306 , 0xF87A5B , 25 ) And CHECKCOLORT ( 180 , 135 , 0x3C75D8 , 25 )
EndFunc
Func AT_ISSHOOT ( )       ; man "SHOOT!" phai vuot bong len
	Return CHECKCOLORT ( 250 , 210 , 0x1643AE , 20 ) And CHECKCOLORT ( 600 , 120 , 0xD0D5E0 , 20 ) And CHECKCOLORT ( 400 , 300 , 0xFFAD00 , 30 )
EndFunc
Func AT_ISSKIP ( )
	Return CHECKCOLORT ( 700 , 405 , 0xFED63D , 25 ) And CHECKCOLORT ( 690 , 418 , 0xFDCD29 , 25 )
EndFunc
Func ADTRANSFER ( )
	If $BADS <> 1 Or Not $BRUN Then Return
	Local $sIni = @ScriptDir & "\auto_done.ini" , $sToday = GAMEDAY ( )
	If IniRead ( $sIni , "AdTransfer" & $STEXT , "Date" , "" ) = $sToday Then Return
	_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Rewarded Ads Transfer" , 0 , 0 )
	If Not DB_OPEN ( ) Then Return
	DB_WAITBACK ( 8 )
	; keo danh sach Daily Bonus xuong cuoi
	For $k = 1 To 2
		If Not MEMU_ADB ( "shell input swipe 400 307 400 77 400" ) Then
			IniWrite ( $sIni , "AdTransfer" & $STEXT , "Fail" , "khong chay duoc memuc/adb " & _NOW ( ) )
			SENDCLICK ( 400 + $APOS [ 0 ] , 411 + $APOS [ 1 ] , $APOS )
			Return
		EndIf
		Sleep ( 1200 )
	Next
	; nut "Go to Transfers" con vang = con luot
	If Not CHECKCOLORT ( 565 , 262 , 0xFEDA47 , 25 ) Then
		IniWrite ( $sIni , "AdTransfer" & $STEXT , "Date" , $sToday )
		SENDCLICK ( 400 + $APOS [ 0 ] , 411 + $APOS [ 1 ] , $APOS )
		Sleep ( 1000 )
		Return
	EndIf
	SENDCLICK ( 608 + $APOS [ 0 ] , 270 + $APOS [ 1 ] , $APOS )
	Local $hT = TimerInit ( )
	While Not ( AT_ISBANNER ( ) Or AT_ISRESULT ( ) )
		If Not $BRUN Then Return
		If TimerDiff ( $hT ) > 45000 Then
			AM_GOHOME ( 60000 )
			Return
		EndIf
		Sleep ( 500 )
	WEnd
	Sleep ( 1000 )
	For $n = 1 To 3
		If Not $BRUN Then Return
		_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Ads Transfer " & $n , 0 , 0 )
		AUTOLOG ( "Ads Transfer " & $n )
		If AT_ISBANNER ( ) Then
			SENDCLICK ( 630 + $APOS [ 0 ] , 350 + $APOS [ 1 ] , $APOS )
		Else
			SENDCLICK ( 400 + $APOS [ 0 ] , 385 + $APOS [ 1 ] , $APOS )
		EndIf
		; hop "Watch an ad to spin" -> Perform Transfer (khong hien = het luot)
		Local $bOk = False
		For $w = 1 To 10
			Sleep ( 500 )
			If AT_ISCONFIRM ( ) Then
				$bOk = True
				ExitLoop
			EndIf
		Next
		If Not $bOk Then ExitLoop
		SENDCLICK ( 483 + $APOS [ 0 ] , 318 + $APOS [ 1 ] , $APOS )
		If Not AD_STOPCOMMON ( ) Then Return
		; Rewards Earned -> SHOOT (vuot bong qua ADB) -> Skip -> man ket qua
		Local $hR = TimerInit ( ) , $bShot = False
		While TimerDiff ( $hR ) < 60000
			If Not $BRUN Then Return
			If NETRETRY ( ) Then Return       ; da tat het, mo lai game -> de lan thu lai sau lam tiep (chua ghi Date)
			If Not $bShot And TimerDiff ( $hR ) > 40000 And TABFIXOLD ( ) And Not AT_ISRESULT ( ) Then
				; quang cao ket trong tab game -> tat het, mo lai game; lan thu lai sau lam tiep
				If Not AD_BACKOUT ( ) Then GAMEERRRESTART ( "Quảng cáo kẹt" )
				Return
			EndIf
			If AT_ISSHOOT ( ) Then
				MEMU_ADB ( "shell input swipe 400 290 400 40 250" )
				$bShot = True
				Sleep ( 2500 )
			ElseIf AT_ISSKIP ( ) Then
				SENDCLICK ( 690 + $APOS [ 0 ] , 410 + $APOS [ 1 ] , $APOS )
				Sleep ( 2000 )
			ElseIf AT_ISRESULT ( ) And $bShot Then
				ExitLoop
			Else
				; Rewards Earned: cham vao cuoi chu "Earned" (555,300) - nam ngoai the cau thu (the o x 293-515)
				SENDCLICK ( 555 + $APOS [ 0 ] , 300 + $APOS [ 1 ] , $APOS )
				Sleep ( 2500 )
			EndIf
		WEnd
		Sleep ( 1000 )
	Next
	IniWrite ( $sIni , "AdTransfer" & $STEXT , "Date" , $sToday )
	SENDCLICK ( 143 + $APOS [ 0 ] , 413 + $APOS [ 1 ] , $APOS )     ; Home
	GIFT_WAIT ( "home" , 30 )
EndFunc
Func EVOLSOLO ( )
	If ISHOMESCREEN ( ) Then
		CLICKPIXEL ( 626 , 236 , 14776414 , $APOS )
		CLICKPIXEL ( 622 , 234 , 16118258 , $APOS )
