If @Compiled Then
    AdlibRegister("UPDATE_AUTO_CHECK", 21600000)
    UPDATE_AUTO_CHECK()
EndIf
; chay thu rieng phan Daily Bonus: AutoIt3.exe CTDT_auto_custom.au3 /testads
If $CmdLine[0] >= 1 And $CmdLine[1] = "/testads" Then
	$BRUN = True
	$BADS = 1
	DAILYBONUSADS ( )
	$BRUN = False
	_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Test Daily Bonus: xong" , 0 , 0 )
EndIf
; chay thu rieng Rewarded Ads Transfer: AutoIt3.exe CTDT_auto_custom.au3 /testat
If $CmdLine[0] >= 1 And $CmdLine[1] = "/testat" Then
	$BRUN = True
	$BADS = 1
	ADTRANSFER ( )
	$BRUN = False
	_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Test Ads Transfer: xong (idx=" & $IMEMUIDX & ")" , 0 , 0 )
EndIf
; chay thu rieng phan chon map NEW o man Event Matches: /testevn
If $CmdLine[0] >= 1 And $CmdLine[1] = "/testevn" Then
	$BRUN = True
	Local $bEvnOk = EVENTNEW ( )
	$BRUN = False
	_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Test Event NEW: " & $bEvnOk , 0 , 0 )
	AUTOLOG ( "Test Event NEW: ket qua " & $bEvnOk )
EndIf
While 1
	Sleep ( 150 )
	UI_REFRESH_BINDING()
	If $BRUN Then
		If $TREO = 1 Then
			CHECKTREO ( )
		Else
			$FREEZEGO = 0
			$ILASTSEC = - 1
			_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Đang chạy" , 1 , 0 )
		EndIf
		; loi ket noi -> Retry (moi che do)
		NETRETRY ( )
		; trang bao loi KLab ("There was an error", mo trong Chrome) -> tat het tab, mo lai game
		If ISGAMEERROR ( ) Then GAMEERRRESTART ( )
		Switch $IMODE
		Case 1
			AUTOCUPCHAMPIONSHIP ( )
		Case 2
			AUTOTRAINSSR ( )
		Case 3
			AUTOWORLDCHANLLENGE ( )
		Case 4
			AUTOVEN ( )
		Case 5
			AUTOSTORY ( )
		Case 6
			AUTOLEAGUE ( )
		Case 7
			AUTORAID ( )
		Case 8
			AUTORANKMATCH ( )
		Case 9
			AUTOEVOL ( )
		EndSwitch
		; cac option bo sung / che do tu tao (Mode Editor)
		AM_RUNFORMODE ( $IMODE )
	EndIf
WEnd
Func FTIME3 ( )
	AUTOLOG ( "Chong treo: man hinh dung yen qua lau -> dong tab app" )
	Local $I , $J
	_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Đang đóng ứng dụng lỗi" , 1 , 0 )
	Sleep ( 400 )
	For $J = 1 To 5
		If $BRUN = False Then ExitLoop
		For $I = 600 To 400 Step - 1
			If $BRUN = False Then ExitLoop
			If CLICKPIXEL ( $I , 16 , 13421772 , $APOS ) Then ExitLoop 2
		Next
	Next
	CLICKPIXEL ( 441 , 209 , 1285520 , $APOS )
	Sleep ( 400 )
	Local $root = $HWND, $wait = TimerInit()
	While $BRUN And UI_BINDING_VALID() And $root = $HWND And TimerDiff($wait) < 10000
		Local $dialogs = WinList()
		For $k = 1 To $dialogs[0][0]
			Local $dialog = $dialogs[$k][1], $title = StringLower($dialogs[$k][0])
			If $title <> "hội thoại" And $title <> "hộp thoại" And $title <> "dialog" Then ContinueLoop
			If WinGetProcess($dialog) <> $boundPid Or _WinAPI_GetAncestor($dialog, $GA_ROOTOWNER) <> $root Then ContinueLoop
			SENDCLICK4(198 + $APOS[0], 187 + $APOS[1], $APOS, $dialog)
			ExitLoop 2
		Next
		Sleep(150)
	WEnd
	SAVELOG ( "Freeze" )
	_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Đang chạy" , 1 , 0 )
EndFunc
Func BASSIGNCLICK ( )
	Local $tPt = DllStructCreate ( "long X;long Y" )
	Local $aC , $hW , $hRoot , $sT , $sLast = ""
	While 1
		$aC = CUSTOM_GETCURSOR ( )
		DllStructSetData ( $tPt , "X" , $aC [ 0 ] )
		DllStructSetData ( $tPt , "Y" , $aC [ 1 ] )
		$hW = _WINAPI_WINDOWFROMPOINT ( $tPt )
		If $hW <> 0 Then
			$hRoot = _WINAPI_GETANCESTOR ( $hW , 2 )
			If $hRoot <> 0 Then $hW = $hRoot
		EndIf
		$sT = WinGetTitle ( $hW )
		If $sT <> $sLast Then
			$sLast = $sT
			ToolTip ( "Nhấp vào giả lập để gán. Nhấn Esc để hủy." & @CRLF & "Cửa sổ: " & $sT )
		EndIf
		If _ISPRESSED ( "1B" ) Then
			While _ISPRESSED ( "1B" )
				Sleep ( 20 )
			WEnd
			ExitLoop
		EndIf
		If _ISPRESSED ( "01" ) Then
			While _ISPRESSED ( "01" )
				Sleep ( 20 )
			WEnd
			Local $processes = ProcessList()
			If Not IsArray($processes) Or Not IS_EMULATOR_WINDOW($hW, $sT, $processes) Then
				_GUICTRLSTATUSBAR_SETTEXT($SSTATUS, "Hãy chọn cửa sổ giả lập đang mở.", 0)
				ExitLoop
			EndIf
			If $HWND <> $hW Then
				If IS_CLAIMED_BY_OTHER($hW) Then
					_GUICTRLSTATUSBAR_SETTEXT($SSTATUS, "Giả lập này đã được một cửa sổ Auto khác sử dụng.", 0)
					ExitLoop
				EndIf
				; Apply a manual reassignment only after the previous mode returns.
				$pickedPid = WinGetProcess($hW)
				$pickedWindow = $hW
				$BRUN = False
				$AMTESTING = False
				AdlibUnRegister("PROCESS_CUSTOM_CLICKS")
				UI_RUN_BUTTON(False)
			EndIf
			ExitLoop
		EndIf
		Sleep ( 60 )
	WEnd
	ToolTip ( "" )
EndFunc
Func BEXITCLICK ( )
	RELEASE_WINDOW ( )
	Exit
EndFunc
Func BRESIZECLICK()
	If Not $HWND Or Not WinExists($HWND) Then
		_GUICtrlStatusBar_SetText($SSTATUS, "Hãy gán cửa sổ giả lập trước khi chỉnh kích thước.", 0)
		Return
	EndIf
	Local $pos = WinGetPos($HWND)
	If Not IsArray($pos) Then Return
	If WinMove($HWND, "", $pos[0], $pos[1], 841, 433) Then _GUICtrlStatusBar_SetText($SSTATUS, "Đã chỉnh kích thước · " & $STEXT, 0)
EndFunc
Func WINCHECKSIZE ( )
	Dim $ASIZE = WinGetClientSize ( $HWND )
	If $ASIZE [ 0 ] = 841 And $ASIZE [ 1 ] = 433 Then
		Return True
	Else
		Return False
	EndIf
EndFunc
Func BSTARTCLICK ( $bSilent = False )
	$BINSTART = True
	If Not UI_BINDING_VALID() Then GET_GAME_WINDOW(True)
	$BINSTART = False
	If Not UI_BINDING_VALID() Then
		If Not $bSilent Then MsgBox ( 48 , "Chưa tìm thấy giả lập" , "Hãy mở MEmu hoặc nhấn Gán cửa sổ để chọn giả lập." )
		Return
	EndIf
	If Not WINCHECKSIZE ( ) Then
		If Not $bSilent Then MsgBox ( 0 , "Kích thước cửa sổ" , "CTDT Auto sẽ chỉnh kích thước cửa sổ giả lập để chạy." )
		WinMove ( $HWND , "" , $APOS [ 0 ] , $APOS [ 1 ] , 841 , 433 )
	EndIf
	If $BRUN Then
		$BRUN = False
		AdlibUnRegister ( "PROCESS_CUSTOM_CLICKS" )
		; Khong tu mo rong cua so khi Stop - muon mo thi bam nut Expand
		_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Sẵn sàng" , 1 , 0 )
		UI_RUN_BUTTON(False)
		$FREEZEGO = 0
		$ILASTSEC = - 1
	Else
		AM_QUEUESTART ( )      ; chay lan luot: chon che do dau neu che do dang chon khong nam trong hang
		AUTOLOG ( "=== Bat dau chay (che do " & $IMODE & ") ===" )
		$BRUN = True
		CUSTOM_RELOAD ( )
		AdlibRegister ( "PROCESS_CUSTOM_CLICKS" , 250 )
		SET_COLLAPSED ( True )
		_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Đang chạy" , 1 , 0 )
		UI_RUN_BUTTON(True)
		$CNTTRANSFER = 0
		$CNTREFILL = 0
		$CNTSTORY = 0
		$CNTBALL = 0
		$FREEZEGO = 0
		$ILASTSEC = - 1
	EndIf
EndFunc
