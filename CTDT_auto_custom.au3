; tham so dong lenh /win=<ten cua so MEmu>, vd: CTDT_auto_custom.exe /win=(1)
Global $SWANTWIN = ""
For $iArg = 1 To $CmdLine[0]
	If StringLeft ( $CmdLine[$iArg] , 5 ) = "/win=" Then $SWANTWIN = StringMid ( $CmdLine[$iArg] , 6 )
	; /mode=N : chon san che do goc N (1 Cup, 2 Training, 3 World Challenge, 4 Events, 5 Story, 6 League, 7 Raid, 8 Rank, 9 Daily)
	If StringLeft ( $CmdLine[$iArg] , 6 ) = "/mode=" Then
		Local $iWantMode = AM_FINDBUILTIN ( Number ( StringMid ( $CmdLine[$iArg] , 7 ) ) )
		If $iWantMode > 0 Then
			AM_FILLMAINLIST ( $iWantMode )
			AM_APPLYMODE ( False )
		EndIf
	EndIf
Next
