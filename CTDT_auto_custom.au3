Func POSTMESSAGEDRAGUP ( $HWND , $X1 , $Y1 , $X2 , $Y2 )
	Local $WM_LBUTTONDOWN = 513
	Local $WM_LBUTTONUP = 514
	Local $WM_MOUSEMOVE = 512
	Local $MK_LBUTTON = 1
	Local $ISTEPDISTANCE = 100
	Local $IPAUSETIME = 3000
	Local $ISMOOTHSTEPS = 10
	Local $ISMOOTHDELAY = 200
	Local $ICURRENTY = $Y1
	Local $INEXTY
	While $ICURRENTY > $Y2
		If Not $BRUN Then Return
		$INEXTY = $ICURRENTY - $ISTEPDISTANCE
		Local $IY_DRAGSTART = $ICURRENTY
		Local $IY_DRAGEND
		If $INEXTY > $Y2 Then
			$IY_DRAGEND = $INEXTY
		Else
			$IY_DRAGEND = $Y2
		EndIf
		Local $IACTUALDRAGDISTANCE = $IY_DRAGSTART - $IY_DRAGEND
		If $IACTUALDRAGDISTANCE <= 0 Then ExitLoop
		DllCall ( "user32.dll" , "int" , "PostMessage" , "hwnd" , $HWND , "int" , $WM_MOUSEMOVE , "int" , 0 , "long" , _MAKELONG ( $X1 , $IY_DRAGSTART ) )
		DllCall ( "user32.dll" , "int" , "PostMessage" , "hwnd" , $HWND , "int" , $WM_LBUTTONDOWN , "int" , $MK_LBUTTON , "long" , _MAKELONG ( $X1 , $IY_DRAGSTART ) )
		Sleep ( 50 )
		Local $ISMOOTHSTEPY = $IACTUALDRAGDISTANCE / $ISMOOTHSTEPS
		For $K = 1 To $ISMOOTHSTEPS
			If Not $BRUN Then
				DllCall ( "user32.dll" , "int" , "PostMessage" , "hwnd" , $HWND , "int" , $WM_LBUTTONUP , "int" , 0 , "long" , _MAKELONG ( $X1 , $IY_DRAGSTART ) )
				Return
			EndIf
			$IY_DRAGSTART -= $ISMOOTHSTEPY
			DllCall ( "user32.dll" , "int" , "PostMessage" , "hwnd" , $HWND , "int" , $WM_MOUSEMOVE , "int" , $MK_LBUTTON , "long" , _MAKELONG ( $X1 , $IY_DRAGSTART ) )
			Sleep ( $ISMOOTHDELAY )
		Next
		DllCall ( "user32.dll" , "int" , "PostMessage" , "hwnd" , $HWND , "int" , $WM_LBUTTONUP , "int" , 0 , "long" , _MAKELONG ( $X1 , $IY_DRAGEND ) )
		$ICURRENTY = $IY_DRAGEND
		If $ICURRENTY > $Y2 Then
			Sleep ( $IPAUSETIME )
		EndIf
	WEnd
	Return
EndFunc
