	Else
		Return StringFormat ( "%02d/%02d/%04d %02d:%02d:%02d" , $AINFO [ 0 ] , $AINFO [ 1 ] , $AINFO [ 2 ] , $AINFO [ 3 ] , $AINFO [ 4 ] , $AINFO [ 5 ] )
	EndIf
EndFunc
