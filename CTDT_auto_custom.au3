Func ISHOMEPRESENTSICON ( )
	If CHECKCOLOR ( 43 , 190 , 5921884 ) Or CHECKCOLOR ( 43 , 188 , 16645887 ) Or CHECKCOLOR ( 43 , 188 , 4803660 ) Or CHECKCOLOR ( 43 , 187 , 10000801 ) Then Return True
	If CHECKCOLOR ( 48 , 181 , 16520999 ) Or CHECKCOLOR ( 43 , 190 , 16031653 ) Or CHECKCOLOR ( 48 , 190 , 15075351 ) Or CHECKCOLOR ( 48 , 190 , 15008787 ) Or CHECKCOLOR ( 48 , 190 , 14813204 ) Or CHECKCOLOR ( 48 , 190 , 15008017 ) Or CHECKCOLOR ( 47 , 182 , 16391724 ) Or CHECKCOLOR ( 47 , 182 , 16471392 ) Or CHECKCOLOR ( 47 , 182 , 16397119 ) Or CHECKCOLOR ( 47 , 182 , 16464711 ) Or CHECKCOLOR ( 47 , 182 , 16321306 ) Or CHECKCOLOR ( 47 , 189 , 15014183 ) Or CHECKCOLOR ( 47 , 189 , 14877201 ) Or CHECKCOLOR ( 47 , 189 , 14619164 ) Or CHECKCOLOR ( 47 , 189 , 14947101 ) Or CHECKCOLOR ( 42 , 185 , 15614542 ) Or CHECKCOLOR ( 47 , 189 , 14881565 ) Then Return True
	Return False
EndFunc
