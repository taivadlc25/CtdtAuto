			Sleep ( 300 )
		ElseIf CHECKCOLOR ( 39 , 128 , 8044031 ) Then
			CLICKPIXEL ( 118 , 189 , 11116703 , $APOS )
			Sleep ( 300 )
		EndIf
		If CHECKCOLOR ( 43 , 129 , 3560551 ) Or CHECKCOLOR ( 335 , 190 , 8274738 ) Then
			; Het luot Daily (da cay xong): danh dau roi chay cac buoc sau khi cay (xem DAILY_FINISH)
			IniWrite ( @ScriptDir & "\auto_done.ini" , "Daily" & $STEXT , "Date" , GAMEDAY ( ) )
			AUTOLOG ( "Daily: het luot (da cay xong)" )
			DAILY_FINISH ( )
		EndIf
	Case 1
		If CHECKCOLOR ( 492 , 377 , 3497263 ) Then
			SENDCLICK ( 790 + $APOS [ 0 ] , 377 + $APOS [ 1 ] , $APOS )
			Sleep ( 300 )
		EndIf
		If CHECKCOLOR ( 101 , 170 , 10621473 ) Then
			CLICKPIXEL ( 75 , 226 , 16748632 , $APOS )
		EndIf
		If CHECKCOLOR ( 39 , 139 , 9043993 ) Then
			CLICKPIXEL ( 12 , 171 , 8123 , $APOS )
		EndIf
	Case 2
		If CHECKCOLOR ( 249 , 227 , 16694019 ) Then
			CLICKPIXEL ( 327 , 172 , 16773322 , $APOS )
		EndIf
	Case 3
		If CHECKCOLOR ( 472 , 207 , 15998003 ) Then
			CLICKPIXEL ( 545 , 135 , 9242905 , $APOS )
		EndIf
	EndSwitch
EndFunc
Func SOLONEW ( )
	If CHECKCOLOR ( 17 , 40 , 13749335 ) And CHECKCOLOR ( 22 , 63 , 15564717 ) Then
		If $TEMPOPT1 = 0 Then
			If GUICtrlRead ( $CAYEVEN3 ) = $GUI_CHECKED Then
				$TEMPOPT1 = 3
				GUICtrlSetState ( $CAYEVEN2 , $GUI_CHECKED )
				If GUICtrlRead ( $KHONGMUA ) = $GUI_UNCHECKED Then
					$TEMPOPT2 = 1
					GUICtrlSetState ( $KHONGMUA , $GUI_CHECKED )
				EndIf
			EndIf
		EndIf
		RELOADMODE ( )
	ElseIf CHECKCOLOR ( 17 , 40 , 13749335 ) And Not ( CHECKCOLOR ( 22 , 63 , 15564717 ) ) Then
		If $TEMPOPT1 = 3 Then
			GUICtrlSetState ( $CAYEVEN3 , $GUI_CHECKED )
			If $TEMPOPT2 = 1 Then
				GUICtrlSetState ( $KHONGMUA , $GUI_UNCHECKED )
			EndIf
			$TEMPOPT1 = 0
			$TEMPOPT2 = 0
			RELOADMODE ( )
		EndIf
	EndIf
	If $BSKIPTICKET = 1 Then
		CLICKPIXEL ( 542 , 389 , 2875129 , $APOS )
		CLICKPIXEL ( 542 , 389 , 2875385 , $APOS )
		CLICKPIXEL ( 542 , 389 , 2875641 , $APOS )
		CLICKPIXEL ( 550 , 365 , 16044891 , $APOS )
		Sleep ( 300 )
		If CLICKPIXEL ( 558 , 216 , 16182105 , $APOS ) Then Sleep ( 300 )
		If CLICKPIXEL ( 537 , 203 , 11638571 , $APOS ) Then Sleep ( 300 )
		If CLICKPIXEL ( 536 , 202 , 8676918 , $APOS ) Then Sleep ( 300 )
		If CLICKPIXEL ( 536 , 194 , 16050519 , $APOS ) Then Sleep ( 300 )
		If CHECKCOLOR ( 519 , 227 , 7629859 ) Or CHECKCOLOR ( 518 , 203 , 7629859 ) Then
			CLICKPIXEL ( 532 , 355 , 8505920 , $APOS )
		EndIf
		If CHECKCOLOR ( 171 , 50 , 4028378 ) And ( CHECKCOLOR ( 611 , 348 , 6020863 ) Or CHECKCOLOR ( 611 , 348 , 16777215 ) Or CHECKCOLOR ( 612 , 362 , 8892916 ) ) Then
			CLICKPIXEL ( 438 , 388 , 8505920 , $APOS )
		EndIf
		CLICKPIXEL ( 444 , 365 , 8505920 , $APOS )
	Else
		CLICKPIXEL ( 692 , 379 , 5705744 , $APOS )
		CLICKPIXEL ( 604 , 377 , 5706001 , $APOS )
		CLICKPIXEL ( 530 , 395 , 5837330 , $APOS )
		CLICKPIXEL ( 530 , 395 , 5771794 , $APOS )
		CLICKPIXEL ( 530 , 394 , 5771280 , $APOS )
		CLICKPIXEL ( 531 , 383 , 5705744 , $APOS )
		CLICKPIXEL ( 603 , 382 , 5705744 , $APOS )
		CLICKPIXEL ( 700 , 400 , 14979368 , $APOS )
		CLICKPIXEL ( 695 , 398 , 15372580 , $APOS )
		Sleep ( 300 )
	EndIf
	If $IMODE = 5 Or $IMODE = 7 Then
		CLICKPIXEL ( 153 , 170 , 11141394 , $APOS )
		CLICKPIXEL ( 236 , 188 , 9180954 , $APOS )
	Else
		Switch $FARMMODE
		Case 1
			CLICKPIXEL ( 153 , 170 , 11141394 , $APOS )
			CLICKPIXEL ( 236 , 188 , 9180954 , $APOS )
		Case 2
			CLICKPIXEL ( 153 , 170 , 11141394 , $APOS )
			CLICKPIXEL ( 236 , 188 , 9180954 , $APOS )
		Case 3
			CLICKPIXEL ( 401 , 131 , 5397087 , $APOS )
		Case 4
			CLICKPIXEL ( 169 , 109 , 15658751 , $APOS )
		Case 5
			CLICKPIXEL ( 645 , 150 , 11099222 , $APOS )
			CLICKPIXEL ( 552 , 153 , 10110787 , $APOS )
		Case 6
			CLICKPIXEL ( 399 , 255 , 3752777 , $APOS )
		EndSwitch
	EndIf
	Switch $HOSTMODE
	Case 0
		If CHECKCOLOR ( 446 , 114 , 15658751 ) Then
			Sleep ( 500 )
			CLICKPIXEL ( 622 , 376 , 5705744 , $APOS )
		EndIf
	Case 1
		If CHECKCOLOR ( 446 , 185 , 15658751 ) Then
			Sleep ( 500 )
			CLICKPIXEL ( 622 , 376 , 5705744 , $APOS )
		EndIf
	Case 2
		If CHECKCOLOR ( 446 , 256 , 15658751 ) Then
			CLICKPIXEL ( 622 , 376 , 5705744 , $APOS )
		EndIf
	Case 3
		If CHECKCOLOR ( 446 , 256 , 15658751 ) Then
			CLICKPIXEL ( 622 , 376 , 5705744 , $APOS )
			$HOSTTYPE = 0
			$HOSTCD = 0
		ElseIf CHECKCOLOR ( 446 , 185 , 15658751 ) Then
			If $HOSTTYPE <> 2 Then
				$HOSTCD = 10
				$HOSTTYPE = 2
			EndIf
			Sleep ( 1000 )
			If $HOSTCD = 1 Then
				CLICKPIXEL ( 622 , 376 , 5705744 , $APOS )
				$HOSTTYPE = 0
			EndIf
			$HOSTCD = $HOSTCD - 1
		ElseIf CHECKCOLOR ( 446 , 114 , 15658751 ) Then
			If $HOSTTYPE <> 1 Then
				$HOSTCD = 15
				$HOSTTYPE = 1
			EndIf
			Sleep ( 1000 )
			If $HOSTCD = 1 Then
				CLICKPIXEL ( 622 , 376 , 5705744 , $APOS )
				$HOSTTYPE = 0
			EndIf
			$HOSTCD = $HOSTCD - 1
		EndIf
	EndSwitch
	If CHECKCOLOR ( 361 , 145 , 3489349 ) Then
		CLICKPIXEL ( 457 , 288 , 8505920 , $APOS )
	EndIf
	If CHECKCOLOR ( 337 , 145 , 4409936 ) Then
		CLICKPIXEL ( 374 , 288 , 12932927 , $APOS )
	EndIf
	If GUICtrlRead ( $CAYEVEN2 ) = 1 Then
		If CHECKCOLOR ( 492 , 262 , 3554368 ) Then
			CLICKHOME ( )
		EndIf
	EndIf
EndFunc
