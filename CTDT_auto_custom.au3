; ===================== Lich cong viec che do Daily/Evolve (danh dau trong auto_done.ini) =====================
; Ngay game = gio may tru ResetHour (mac dinh 7h sang) - [Config] ResetHour trong auto_done.ini
Func GAMEDAY ( )

	Local $iH = Number ( IniRead ( @ScriptDir & "\auto_done.ini" , "Config" , "ResetHour" , 7 ) )
	Return StringReplace ( StringLeft ( _DATEADD ( "h" , - $iH , _NOWCALC ( ) ) , 10 ) , "/" , "" )
EndFunc
; Nhat ky auto_log.txt (chung moi may): "YYYY-MM-DD HH:MM:SS [ten MEmu] su kien". File > 3MB thi doi ten .old
Func AUTOLOG ( $s )
	Local $f = @ScriptDir & "\auto_log.txt"
	If FileGetSize ( $f ) > 3000000 Then FileMove ( $f , $f & ".old" , 1 )
	FileWriteLine ( $f , @YEAR & "-" & @MON & "-" & @MDAY & " " & @HOUR & ":" & @MIN & ":" & @SEC & " [" & $STEXT & "] " & $s )
EndFunc
; Cac buoc (moi buoc ghi ngay da xong vao auto_done.ini, muc [<buoc><ten MEmu>]):
; Thu tu do user sap xep (13/11):
;   1. Daily     : cay Daily/Evolve (3 man League + 3 man lay point) toi het luot -> [Daily]  Date
;   (13/14-11: user chuyen nhan qua xuong cuoi - khong nhan o buoc 2 nua)
;   2. Skip      : mua ve Skip o Exchange Shop + reset mua them 1 luot -> [Skip] Date
;   3. DailyAds  : Daily Bonus: bi free + xem het quang cao          -> [DailyAds] Date
;   4. AdTransfer: Rewarded Ads Transfer 3 lan                       -> [AdTransfer] Date
;   5. StoryX2   : Main Story man 1, 3 quang cao 2x Rewards          -> [StoryX2] Done
;   6. Gifts2    : nhan qua Missions + Presents (sau khi xong het)  -> [Daily] Gifts2
;   7. Finish    : option "Khi che do xong" (Mode Editor) roi dung -> [Daily] Finish
Func DAILY_STEP ( $i , $s )
	_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Bước " & $i & "/7: " & $s , 0 , 0 )
	AUTOLOG ( "Buoc " & $i & "/7: " & $s )
EndFunc
Func DAILY_FINISH ( )
	Local $sIni = @ScriptDir & "\auto_done.ini" , $sSec = "Daily" & $STEXT , $sToday = GAMEDAY ( )
	DAILY_STEP ( 2 , "mua vé Skip" )
	If Not ISHOMESCREEN ( ) Then AM_GOHOME ( 60000 )
	BUYSKIP ( )
	If Not $BRUN Then Return
	DAILY_STEP ( 3 , "Daily Bonus + quảng cáo" )
	DAILYBONUSADS ( )      ; buoc 3 + 4 (ADTRANSFER o cuoi), tu danh dau
	If Not $BRUN Then Return
	DAILY_STEP ( 5 , "Story x2" )
	STORYX2 ( True )
	If Not $BRUN Then Return
	; 18/11: quet lai bang Daily Bonus (keo xuong cuoi): con luot quang cao nao (rewards / slots / hoi nang luong)
	; thi xem tiep; Ads Transfer / Story x2 con luot -> danh dau chua xong de phan thu lai ben duoi lam tiep
	If $BADS = 1 Then DB_SWEEP ( )
	If Not $BRUN Then Return
	; con buoc quang cao chua xong (vd quang cao mo Google Play/Chrome lam lac) -> chua dung, thu lai toi da 3 lan
	If True Then
		Local $sMiss = ""
		; mua ve Skip chua xong (va chua het 3 lan thu trong ngay)
		If IniRead ( $sIni , "Skip" & $STEXT , "Date" , "" ) <> $sToday And Number ( IniRead ( $sIni , "Skip" & $STEXT , "Tries" , 0 ) ) < 3 Then $sMiss &= " Skip"
		If $BADS = 1 Then
			If IniRead ( $sIni , "DailyAds" & $STEXT , "Date" , "" ) <> $sToday Then $sMiss &= " DailyAds"
			If IniRead ( $sIni , "AdTransfer" & $STEXT , "Date" , "" ) <> $sToday Then $sMiss &= " AdTransfer"
			If IniRead ( $sIni , "StoryX2" & $STEXT , "Done" , "" ) <> "1" Then $sMiss &= " StoryX2"
		EndIf
		If $sMiss <> "" Then
			If IniRead ( $sIni , $sSec , "RetryDate" , "" ) <> $sToday Then
				IniWrite ( $sIni , $sSec , "RetryDate" , $sToday )
				IniWrite ( $sIni , $sSec , "Retry" , 0 )
			EndIf
			Local $iRetry = Number ( IniRead ( $sIni , $sSec , "Retry" , 0 ) )
			If $iRetry < 5 Then      ; 18/11: 3 -> 5 (DB_SWEEP biet chinh xac muc con thieu)
				IniWrite ( $sIni , $sSec , "Retry" , $iRetry + 1 )
				IniWrite ( $sIni , $sSec , "Missing" , $sMiss )
				DAILY_STEP ( 7 , "chưa xong:" & $sMiss & " -> thử lại lần " & ( $iRetry + 1 ) )
				Sleep ( 3000 )
				Return      ; $BRUN van True -> vong lap chinh goi lai DAILY_FINISH
			EndIf
		EndIf
	EndIf
	; Sau khi xong het (mua ve, quang cao, Story x2 lai sinh them qua nhiem vu) -> nhan qua Missions + Presents lan cuoi
	If IniRead ( $sIni , $sSec , "Gifts2" , "" ) <> $sToday Then
		DAILY_STEP ( 6 , "nhận quà Missions + Presents" )
		CLAIMGIFTS ( )
		If Not $BRUN Then Return
		IniWrite ( $sIni , $sSec , "Gifts2" , $sToday )
	EndIf
	If IniRead ( $sIni , $sSec , "Finish" , "" ) <> $sToday Then
		DAILY_STEP ( 7 , "option khi xong (Mode Editor)" )
		AM_ONFINISH ( $IMODE )
		IniWrite ( $sIni , $sSec , "Finish" , $sToday )
	EndIf
	DAILY_STEP ( 7 , "xong hết việc hôm nay" )
	$BRUN = False
	_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Sẵn sàng" , 1 , 0 )
	UI_RUN_BUTTON(False)
	AM_QUEUENEXT ( )   ; chay lan luot: sang che do ke (neu co)
EndFunc
Func AUTOEVOL ( )
	; Daily hom nay da cay het (danh dau) -> khong vao Daily nua, lam tiep cac buoc con lai
	If IniRead ( @ScriptDir & "\auto_done.ini" , "Daily" & $STEXT , "Date" , "" ) = GAMEDAY ( ) Then
		DAILY_FINISH ( )
		Return
	EndIf
	GOTOHOME ( )
	If CHECKCOLOR ( 419 , 45 , 16737135 ) Or CHECKCOLOR ( 419 , 45 , 16737136 ) Then
		AUTOLEAGUECON ( )
	Else
		EVOLSOLO ( )
	EndIf
	; League het luot ("Maximum number reached") -> bam Home de sang Daily/Evolve
	If CHECKCOLOR ( 22 , 40 , 4212540 ) And CHECKCOLOR ( 421 , 44 , 8754852 ) Then
		If Not CLICKPIXELT ( 143 , 413 , 9069386 , 20 ) Then SENDCLICK ( 143 + $APOS [ 0 ] , 413 + $APOS [ 1 ] , $APOS )
		Sleep ( 2000 )
	EndIf
	If $FARMMODE = 1 Then
		AUTOCLICKMATCH2 ( )
	EndIf
	If ( $FARMMODE = 2 ) Or ( $FARMMODE = 3 ) Or ( $FARMMODE = 5 ) Or ( $FARMMODE = 6 ) Then
		AUTOCLICKMATCH ( )
	EndIf
	SOLONEW ( )
	PREPAREMATCH ( )
	SELLALL ( )
EndFunc
; Nut Back + Home cam o goc trai duoi (2 kieu: Story/Daily/Shop Menu va Exchange Shop/Transfers)
Func HOMEBTN ( )
	If CHECKCOLORT ( 30 , 413 , 0xC95F13 , 20 ) And CHECKCOLORT ( 130 , 413 , 0xE06B16 , 20 ) And CHECKCOLORT ( 175 , 405 , 0xF4B02F , 25 ) Then Return True
	Return CHECKCOLORT ( 60 , 405 , 0xF07E22 , 20 ) And CHECKCOLORT ( 175 , 405 , 0xF07E22 , 20 ) And CHECKCOLORT ( 130 , 413 , 0xEB9F1F , 20 )
EndFunc
; Trang loi KLab mo trong Chrome: logo KLabGames xanh + khung "Error Code" vien hong, nen trang
Func ISGAMEERROR ( )
	Return CHECKCOLORT ( 170 , 122 , 0x115FAD , 20 ) And CHECKCOLORT ( 260 , 290 , 0xE5107D , 25 ) And CHECKCOLORT ( 260 , 350 , 0xE5107D , 25 ) And CHECKCOLORT ( 245 , 320 , 0xE5107D , 25 ) And CHECKCOLORT ( 400 , 215 , 0xFFFFFF , 8 )
EndFunc
; Dau X tren thanh tab MEmu (y=16): tra ve so tab ung dung va vi tri X xa nhat ben phai.
; Chi co tab game: 1 X o x ~487-504. Quang cao mo them Chrome / Google Play -> X xuat hien o x >= 520 hoac >= 2 X.
Func TABXCOUNT ( ByRef $iRight )
	Local $n = 0 , $iLast = - 10
	$iRight = 0
	For $x = 150 To 640
		If CHECKCOLORT ( $x , 16 , 0xCCCCCC , 6 ) Then
			If $x - $iLast > 6 Then $n += 1
			$iLast = $x
			$iRight = $x
		EndIf
	Next
	Return $n
EndFunc
Func EXTRATABS ( )
	Local $iR , $n = TABXCOUNT ( $iR )
	Return $n >= 2 Or $iR >= 520
EndFunc
; Tat het: dong moi tab ung dung tren thanh tab MEmu (FTIME3 = bam X tab + xac nhan), roi bam icon game
; 18/11 user chon: quang cao tu mo Chrome (tab thu 2) -> CHI dong tab Chrome, quay lai tab game (giu man nhan thuong
; dang do, vd Ads Transfer con buoc SHOOT). Dong >= 3 lan trong 3 phut hoac mat luon tab game -> tat het, mo lai game.
; 19/11 user chon: thoat quang cao bang Home MEmu + icon game ma van ket o trang cuoi quang cao
; (vd "Your Gift Is Ready") -> bam phim BACK cua Android toi da 3 lan (KHONG bam X quang cao).
; Tra ve True neu da ve duoc man game (Daily Bonus / man chinh / ket qua Story / ket qua Ads Transfer)
Func AD_GAMEBACK ( )
	Return DB_ISOPEN ( ) Or ISHOMESCREEN ( ) Or SX_ISCLEAR ( ) Or AT_ISRESULT ( )
EndFunc
; o "Now Loading" goc phai duoi (0x222222) -> game dang tai, khong phai quang cao
Func ISLOADING ( )
	If CHECKCOLORT ( 605 , 412 , 0x222222 , 8 ) And CHECKCOLORT ( 790 , 412 , 0x222222 , 8 ) And CHECKCOLORT ( 700 , 420 , 0x222222 , 8 ) Then Return True
	; luc moi tai: man den hoan toan (chua hien o "Now Loading")
	Return CHECKCOLORT ( 150 , 100 , 0x000000 , 4 ) And CHECKCOLORT ( 400 , 250 , 0x000000 , 4 ) And CHECKCOLORT ( 650 , 150 , 0x000000 , 4 ) And CHECKCOLORT ( 700 , 412 , 0x000000 , 4 ) And CHECKCOLORT ( 100 , 400 , 0x000000 , 4 )
EndFunc
Func AD_BACKOUT ( )
	If Not $BRUN Then Return False
	If AD_GAMEBACK ( ) Then Return True
	; game dang tai lai (sau khi dong Chrome / mo lai) -> cho toi 60s, KHONG bam Back luc dang tai
	Local $hL = TimerInit ( )
	While ISLOADING ( ) And TimerDiff ( $hL ) < 60000
		If Not $BRUN Then Return False
		Sleep ( 2000 )
		If AD_GAMEBACK ( ) Then Return True
	WEnd
	; 19/11: toi da 2 lan Back (lan 2-3 tung day game ra man hinh chinh Android)
	For $k = 1 To 2
		If Not $BRUN Then Return False
		If ISLOADING ( ) Then
			Sleep ( 5000 )
			If AD_GAMEBACK ( ) Then Return True
			ContinueLoop
		EndIf
		If ISANDROIDHOME ( ) Then ExitLoop
		AUTOLOG ( "Quang cao van con -> bam Back Android (lan " & $k & ")" )
		MEMU_ADB ( "shell input keyevent 4" )
		Sleep ( 4000 )
		If AD_GAMEBACK ( ) Then Return True
		Sleep ( 3000 )      ; KHONG cham giua man hinh (de bam nham nut cua quang cao)
		If AD_GAMEBACK ( ) Then Return True
		If ISANDROIDHOME ( ) Then ExitLoop
	Next
	; Back da day game xuong nen (hien man hinh chinh Android) -> bam icon game mo lai, cho ve man game
	If ISANDROIDHOME ( ) Then
		AUTOLOG ( "Back Android ra man hinh chinh Android -> bam icon game" )
		SENDCLICK ( 672 + $APOS [ 0 ] , 145 + $APOS [ 1 ] , $APOS )
		Local $hW = TimerInit ( )
		While TimerDiff ( $hW ) < 60000
			If Not $BRUN Then Return False
			Sleep ( 2000 )
			If AD_GAMEBACK ( ) Then Return True
		WEnd
	EndIf
	Return AD_GAMEBACK ( )
EndFunc
; man hinh chinh Android (launcher MEmu): thanh tim kiem xanh dam + icon Settings trang
Func ISANDROIDHOME ( )
	Return CHECKCOLORT ( 300 , 82 , 0x374B64 , 10 ) And CHECKCOLORT ( 400 , 82 , 0x1E3A60 , 10 ) And CHECKCOLORT ( 536 , 145 , 0xFFFFFF , 6 )
EndFunc
; da qua 90s tu lan dong tab Chrome gan nhat (game dang tai lai thi chua duoc ket luan "quang cao ket")
Func TABFIXOLD ( )
	Return $HTABFIXLAST = 0 Or TimerDiff ( $HTABFIXLAST ) > 90000
EndFunc
Func EXTRATAB_FIX ( )
	If $BINRESTART Then Return
	If $HTABFIX = 0 Or TimerDiff ( $HTABFIX ) > 180000 Then
		$HTABFIX = TimerInit ( )
		$ITABFIX = 0
	EndIf
	$ITABFIX += 1
	If $ITABFIX >= 3 Then
		$ITABFIX = 0
		GAMEERRRESTART ( "Quảng cáo mở app khác (đóng tab không ăn)" )
		Return
	EndIf
	$HTABFIXLAST = TimerInit ( )
	AUTOLOG ( "Quang cao mo Chrome -> chi dong tab Chrome, quay lai game" )
	_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Quảng cáo mở Chrome -> đóng tab Chrome" , 0 , 0 )
	FTIME3 ( )      ; bam X tab ngoai cung ben phai (Chrome) + xac nhan
	Sleep ( 3000 )
	Local $iR , $n = TABXCOUNT ( $iR )
	If $n = 0 Then
		; mat ca tab game -> mo lai game tu icon, cho ve man chinh
		GAMEERRRESTART ( "Quảng cáo mở app khác (mất tab game)" )
		Return
	EndIf
	If $n >= 2 Then
		FTIME3 ( )      ; con tab la nua -> dong tiep 1 lan
		Sleep ( 3000 )
		$n = TABXCOUNT ( $iR )
	EndIf
	; bam vao chu tren tab game (ben trai dau X) de dua tab game len truoc
	SENDCLICK ( $iR - 80 + $APOS [ 0 ] , 16 + $APOS [ 1 ] , $APOS )
	Sleep ( 3000 )
	; 18/11: tab game van dang o man cuoi cua quang cao -> thoat quang cao Y NHU CU (user quy dinh):
	; nut Home MEmu -> bam icon game (KHONG bam X quang cao)
	ControlClick ( $HWND , "" , "[CLASS:Qt5152QWindowIcon; INSTANCE:8]" )
	Sleep ( 5000 )
	SENDCLICK ( 672 + $APOS [ 0 ] , 145 + $APOS [ 1 ] , $APOS )
	Sleep ( 5000 )
EndFunc
Func GAMEERRRESTART ( $sWhy = "Game báo lỗi" )
	If $BINRESTART Then Return      ; dang cho game tai lai sau 1 lan restart -> khong tat mo lai long nhau
	_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , $sWhy & " -> tắt hết, mở lại game" , 0 , 0 )
	SAVELOG ( $sWhy & " -> restart" )
	AUTOLOG ( $sWhy & " -> tat het tab, mo lai game" )
	For $i = 1 To 5
		If Not $BRUN Then Return
		Local $iR
		If TABXCOUNT ( $iR ) = 0 Then ExitLoop
		FTIME3 ( )
		Sleep ( 3000 )
	Next
	SENDCLICK ( 672 + $APOS [ 0 ] , 145 + $APOS [ 1 ] , $APOS )     ; icon game o man hinh Android
	Sleep ( 10000 )
	; 18/11: game tai lai mat 60-90s (man tieu de, qua dang nhap). Truoc day tra ve ngay sau 10s -> ham goi
	; cho 30-40s khong thay man chinh/Daily Bonus -> tat mo lai game lien tuc, Daily lam khong het.
	; Cho toi khi ve man chinh (toi da 90s), bam qua man "Touch Screen to Start" / popup bang GOTOHOME.
	$BINRESTART = True
	Local $hW = TimerInit ( )
	While TimerDiff ( $hW ) < 90000
		If Not $BRUN Then ExitLoop
		If ISHOMESCREEN ( ) Or DB_ISOPEN ( ) Then ExitLoop
		If TABXCOUNT ( $iR ) = 0 Then SENDCLICK ( 672 + $APOS [ 0 ] , 145 + $APOS [ 1 ] , $APOS )     ; game chua mo -> bam icon lai
		GOTOHOME ( )
		Sleep ( 2000 )
	WEnd
	$BINRESTART = False
EndFunc
; Popup "A connection error has occurred. Do you want to try again?" [Restart App] [Retry] -> bam Retry
; Kem: moi 5s kiem tra quang cao mo app khac (Chrome / Google Play) de len game -> tat het, mo lai game.
; (NETRETRY duoc goi trong moi vong cho: vong lap chinh, DIALOGHANDLING, Story x2, Ads Transfer, Shop...)
Func NETRETRY ( )
	; Android "CaptainTsubasa isn't responding" [Close app] [Wait] -> Close app roi bam icon mo lai game
	If CHECKCOLORT ( 183 , 242 , 0x008577 , 20 ) And CHECKCOLORT ( 183 , 282 , 0x369F94 , 20 ) And CHECKCOLORT ( 400 , 230 , 0xFFFFFF , 5 ) And CHECKCOLORT ( 100 , 100 , 0x000000 , 10 ) Then
		_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Game treo (isn't responding) -> Close app, mở lại game" , 0 , 0 )
		AUTOLOG ( "Game treo (isn't responding) -> Close app, mo lai game" )
		SAVELOG ( "ANR -> Close app" )
		SENDCLICK ( 250 + $APOS [ 0 ] , 242 + $APOS [ 1 ] , $APOS )
		Sleep ( 4000 )
		SENDCLICK ( 672 + $APOS [ 0 ] , 145 + $APOS [ 1 ] , $APOS )
		Sleep ( 10000 )
		Return True
	EndIf
	If $BRUN And TimerDiff ( $HTABCHK ) > 5000 Then
		$HTABCHK = TimerInit ( )
		If EXTRATABS ( ) Then
			EXTRATAB_FIX ( )
			Return True
		EndIf
	EndIf
	If CHECKCOLORT ( 262 , 155 , 0xE3EBF0 , 20 ) And CHECKCOLORT ( 533 , 155 , 0xE4EDF1 , 20 ) And CHECKCOLORT ( 255 , 155 , 0x3D7CED , 25 ) And CHECKCOLORT ( 540 , 155 , 0x4578E1 , 25 ) And CHECKCOLORT ( 303 , 222 , 0x333B41 , 20 ) And CHECKCOLORT ( 414 , 222 , 0x353D43 , 20 ) And CHECKCOLORT ( 260 , 299 , 0xED694A , 25 ) And CHECKCOLORT ( 440 , 299 , 0x98EA4C , 25 ) Then
		_GUICTRLSTATUSBAR_SETTEXT ( $SSTATUS , "Lỗi kết nối -> Retry" , 0 , 0 )
		AUTOLOG ( "Loi ket noi -> Retry" )
		SENDCLICK ( 483 + $APOS [ 0 ] , 299 + $APOS [ 1 ] , $APOS )
		Sleep ( 3000 )
		Return True
	EndIf
	Return False
EndFunc
Func DIALOGHANDLING ( )
	If NETRETRY ( ) Then Return
	If EVN_ENERGYOK ( ) Then Return      ; "Energy Recovered" -> OK
	; Popup 1 nut OK (vd "Dreamball Lottery - Ad viewing is complete. Go get your reward!")
	; khung xanh duong + nen trang + nut OK xanh la giua -> bam OK (truoc day bi dung tai day)
	If CHECKCOLORT ( 170 , 152 , 0x4282EE , 25 ) And CHECKCOLORT ( 630 , 152 , 0x4478EB , 25 ) And CHECKCOLORT ( 230 , 222 , 0xFFFFFF , 6 ) And CHECKCOLORT ( 360 , 290 , 0xA6F55A , 30 ) Then
		SENDCLICK ( 400 + $APOS [ 0 ] , 299 + $APOS [ 1 ] , $APOS )
		Sleep ( 1000 )
		Return
	EndIf
	If CHECKCOLOR ( 111 , 301 , 2233873 ) And ( CHECKCOLOR ( 145 , 335 , 16768451 ) Or CHECKCOLOR ( 145 , 335 , 16768452 ) ) Then
		SENDCLICK ( 349 + $APOS [ 0 ] , 293 + $APOS [ 1 ] , $APOS )
		Return
	EndIf
	If CHECKCOLOR ( 205 , 187 , 16777149 ) And CHECKCOLOR ( 293 , 227 , 16766174 ) Then
		CLICKPIXEL ( 539 , 316 , 8505920 , $APOS )
		Return
	EndIf
	If CHECKCOLOR ( 101 , 317 , 16776440 ) And CHECKCOLOR ( 160 , 327 , 9614151 ) Then
		SENDCLICK ( 349 + $APOS [ 0 ] , 293 + $APOS [ 1 ] , $APOS )
		Return
	EndIf
	If CHECKCOLOR ( 78 , 669 , 16764896 ) Then CLICKPIXEL ( 78 , 669 , 16764896 , $APOS )
	If CHECKCOLOR ( 325 , 395 , 16760524 ) And CHECKCOLOR ( 866 , 560 , 8505920 ) Then CLICKPIXEL ( 866 , 560 , 8505920 , $APOS )
EndFunc
