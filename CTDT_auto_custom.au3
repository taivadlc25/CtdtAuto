Func AMED_CLOSE()
	If $HAMFORM <> 0 Then
		GUIDelete($HAMFORM)
		$HAMFORM = 0
	EndIf
EndFunc

Func AMED_TOUCH()
	$AMRTTIME = ""            ; ep Auto doc lai auto_modes.ini
EndFunc

Func AMED_INFO($s)
	If $HAMFORM <> 0 Then GUICtrlSetData($AMLBLINFO, $s)
EndFunc

Func AMED_CLEAN($s)
	Return StringStripWS(StringReplace($s, "|", "/"), 3)
EndFunc

Func AMED_ASK($sPrompt, $sDef)
	Local $s = InputBox("Trình sửa chế độ", $sPrompt, $sDef, "", 340, 140, Default, Default, 0, $HAMFORM)
	If @error Then Return ""
	Return AMED_CLEAN($s)
EndFunc

Func AMED_CONFIRM($sMsg)
	Return (MsgBox(4 + 32 + 262144, "Trình sửa chế độ", $sMsg, 0, $HAMFORM) = 6)
EndFunc

Func AMED_LISTSET($idList, $s, $iIdx)
	GUICtrlSendMsg($idList, 0x184, 0, 0)                  ; LB_RESETCONTENT
	If $s <> "" Then GUICtrlSetData($idList, StringTrimLeft($s, 1))
	UI_LIST_WIDTH($idList, $s)
	If $iIdx >= 0 Then GUICtrlSendMsg($idList, 0x186, $iIdx, 0)
EndFunc

; ---- cot 1 ----
Func AMED_FILLMODES($iSel = 0)
	$AMEDMODES = AM_MODES(False)
	Local $s = "", $iIdx = -1
	For $i = 1 To $AMEDMODES[0]
		Local $id = $AMEDMODES[$i]
		Local $sL = AM_MODELABEL($id)
		If IniRead($SAMINI, "M" & $id, "Hidden", "0") = "1" Then $sL &= "   (ẩn)"
		$s &= "|" & $sL
		If $id = $iSel Then $iIdx = $i - 1
	Next
	If $iIdx = -1 And $AMEDMODES[0] > 0 Then $iIdx = 0
	AMED_LISTSET($AMLMODE, $s, $iIdx)
	AMED_ONMODE()
EndFunc

Func AMED_ONMODE()
	Local $iIdx = GUICtrlSendMsg($AMLMODE, 0x188, 0, 0)
	$AMSELMODE = 0
	If $iIdx >= 0 And $iIdx < $AMEDMODES[0] Then $AMSELMODE = $AMEDMODES[$iIdx + 1]
	Local $sInfo = ""
	If $AMSELMODE <> 0 Then
		Local $iB = Number(IniRead($SAMINI, "M" & $AMSELMODE, "Builtin", "0"))
		If $iB < 0 Then
			$sInfo = "Các quy tắc về màn hình chính chạy cùng mọi chế độ." & @CRLF & "Khi chọn nút Home hoặc Back, hãy thêm một điểm màu riêng của màn hình, chẳng hạn màu tiêu đề." & @CRLF & "Với “Đây là màn hình chính”, hãy chọn điểm màu chỉ có trên màn hình chính."
		ElseIf $iB > 0 And $iB <= 9 Then
			$sInfo = "Chế độ gốc (" & $AMBASENAMES[$iB] & ") chạy cùng các tùy chọn đã bật." & @CRLF & @CRLF & "Bạn có thể ẩn chế độ gốc khỏi danh sách."
		Else
			$sInfo = "Chế độ tự tạo chạy các tùy chọn đã bật." & @CRLF & @CRLF & "Dùng kiểu “Luôn quét” cho chế độ này. Thêm bước “Dừng auto” để kết thúc."
		EndIf
	EndIf
	GUICtrlSetData($AMLMODEINFO, $sInfo)
	AMED_FILLOPTS()
EndFunc

; sua xong danh sach che do -> cap nhat ca 2 noi
Func AMED_MODESCHANGED($iSel)
	AMED_TOUCH()
	AMED_FILLMODES($iSel)
	Local $iOld = $AMCURMODE
	AM_FILLMAINLIST(0)
	If $AMCURMODE <> $iOld And Not $BRUN Then RELOADMODE()
EndFunc

Func AMED_MODEADD()
	Local $s = AMED_ASK("Tên chế độ mới:", "")
	If $s = "" Then Return
	Local $id = AM_NEWID("M")
	IniWriteSection($SAMINI, "M" & $id, "Name=" & $s & @LF & "Builtin=0" & @LF & "Hidden=0" & @LF & "Order=" & (AM_MAXORDER() + 1))
	AMED_MODESCHANGED($id)
EndFunc

Func AMED_MODERENAME()
	If $AMSELMODE = 0 Then Return
	Local $s = AMED_ASK("Tên mới:", IniRead($SAMINI, "M" & $AMSELMODE, "Name", ""))
	If $s = "" Then Return
	IniWrite($SAMINI, "M" & $AMSELMODE, "Name", $s)
	AMED_MODESCHANGED($AMSELMODE)
EndFunc

Func AMED_MODEHIDE()
	If $AMSELMODE = 0 Then Return
	If Number(IniRead($SAMINI, "M" & $AMSELMODE, "Builtin", "0")) < 0 Then Return   ; muc ★ Ve man hinh chinh
	Local $sSec = "M" & $AMSELMODE
	If IniRead($SAMINI, $sSec, "Hidden", "0") = "1" Then
		IniWrite($SAMINI, $sSec, "Hidden", "0")
	Else
		Local $aV = AM_MODES(True)
		If $aV[0] <= 1 Then
			AMED_INFO("Cần giữ ít nhất một chế độ hiển thị trong danh sách.")
			Return
		EndIf
		IniWrite($SAMINI, $sSec, "Hidden", "1")
	EndIf
	AMED_MODESCHANGED($AMSELMODE)
EndFunc

Func AMED_MODEMOVE($iDir)
	If $AMSELMODE = 0 Then Return
	Local $a = AM_MODES(False)
	Local $iPos = 0
	For $i = 1 To $a[0]
		If $a[$i] = $AMSELMODE Then $iPos = $i
	Next
	Local $iTo = $iPos + $iDir
	If $iPos = 0 Or $iTo < 1 Or $iTo > $a[0] Then Return
	Local $t = $a[$iPos]
	$a[$iPos] = $a[$iTo]
	$a[$iTo] = $t
	For $i = 1 To $a[0]                    ; danh lai Order 1..N
		IniWrite($SAMINI, "M" & $a[$i], "Order", $i)
	Next
	AMED_MODESCHANGED($AMSELMODE)
EndFunc

Func AMED_MODEUP()
	AMED_MODEMOVE(-1)
EndFunc

Func AMED_MODEDOWN()
	AMED_MODEMOVE(1)
EndFunc

Func AMED_MODEDEL()
	If $AMSELMODE = 0 Then Return
	If Number(IniRead($SAMINI, "M" & $AMSELMODE, "Builtin", "0")) <> 0 Then
		AMED_INFO("Bạn có thể dùng nút Ẩn / hiện cho chế độ gốc này.")
		Return
	EndIf
	If Not AMED_CONFIRM("Xoá chế độ '" & IniRead($SAMINI, "M" & $AMSELMODE, "Name", "") & "' và toàn bộ tùy chọn đi kèm?") Then Return
	Local $aO = AM_IDS("O", "Mode", String($AMSELMODE))
	For $i = 1 To $aO[0]
		IniDelete($SAMINI, "O" & $aO[$i])
	Next
	IniDelete($SAMINI, "M" & $AMSELMODE)
	AMED_MODESCHANGED(0)
EndFunc

; ---- cot 2 ----
Func AMED_FILLOPTS($iSel = 0)
	If $AMSELMODE = 0 Then
		Local $aE[1] = [0]
		$AMEDOPTS = $aE
	Else
		$AMEDOPTS = AM_IDS("O", "Mode", String($AMSELMODE))
	EndIf
	Local $s = "", $iIdx = -1
	For $i = 1 To $AMEDOPTS[0]
		Local $sSec = "O" & $AMEDOPTS[$i]
		Local $sOn = (IniRead($SAMINI, $sSec, "Enabled", "0") = "1") ? "[Bật] " : "[Tắt] "
		$s &= "|" & $sOn & IniRead($SAMINI, $sSec, "Name", "?")
		If $AMEDOPTS[$i] = $iSel Then $iIdx = $i - 1
	Next
	If $iIdx = -1 And $AMEDOPTS[0] > 0 Then $iIdx = 0
	AMED_LISTSET($AMLOPT, $s, $iIdx)
	AMED_ONOPT()
EndFunc

Func AMED_ONOPT()
	GUICtrlSetData($AMITESTFROM, "")               ; doi option -> chay thu lai tu dau
	GUICtrlSetData($AMITESTTO, "")
	Local $iIdx = GUICtrlSendMsg($AMLOPT, 0x188, 0, 0)
	$AMSELOPT = 0
	If $iIdx >= 0 And $iIdx < $AMEDOPTS[0] Then $AMSELOPT = $AMEDOPTS[$iIdx + 1]
	If $AMSELOPT = 0 Then
		GUICtrlSetState($AMCHKEN, $GUI_UNCHECKED)
		GUICtrlSendMsg($AMCTYPE, 0x14E, -1, 0)
		GUICtrlSetState($AMCHKHOME, $GUI_UNCHECKED)
		GUICtrlSetState($AMCHKBLOCK, $GUI_UNCHECKED)
	Else
		Local $sSec = "O" & $AMSELOPT
		GUICtrlSetState($AMCHKEN, (IniRead($SAMINI, $sSec, "Enabled", "0") = "1") ? $GUI_CHECKED : $GUI_UNCHECKED)
		GUICtrlSendMsg($AMCTYPE, 0x14E, AM_TYPEIDX(IniRead($SAMINI, $sSec, "Type", "loop")), 0)
		GUICtrlSetState($AMCHKHOME, (IniRead($SAMINI, $sSec, "GoHome", "0") = "1") ? $GUI_CHECKED : $GUI_UNCHECKED)
		GUICtrlSetState($AMCHKBLOCK, AM_OPTBLOCK($AMSELOPT) ? $GUI_CHECKED : $GUI_UNCHECKED)
	EndIf
	AMED_FILLSTEPS()
EndFunc

Func AMED_OPTPROP()
	If $AMSELOPT = 0 Then Return
	Local $sSec = "O" & $AMSELOPT
	IniWrite($SAMINI, $sSec, "Enabled", (BitAND(GUICtrlRead($AMCHKEN), $GUI_CHECKED) = $GUI_CHECKED) ? "1" : "0")
	Local $iT = GUICtrlSendMsg($AMCTYPE, 0x147, 0, 0)            ; CB_GETCURSEL
	If $iT >= 0 Then IniWrite($SAMINI, $sSec, "Type", AM_TYPENAME($iT))
	IniWrite($SAMINI, $sSec, "GoHome", (BitAND(GUICtrlRead($AMCHKHOME), $GUI_CHECKED) = $GUI_CHECKED) ? "1" : "0")
	IniWrite($SAMINI, $sSec, "BlockCustom", (BitAND(GUICtrlRead($AMCHKBLOCK), $GUI_CHECKED) = $GUI_CHECKED) ? "1" : "0")
	AMED_TOUCH()
	AMED_FILLOPTS($AMSELOPT)
EndFunc

Func AMED_OPTADD()
	If $AMSELMODE = 0 Then Return
	Local $s = AMED_ASK("Tên tùy chọn mới:", "")
	If $s = "" Then Return
	Local $id = AM_NEWID("O")
	IniWriteSection($SAMINI, "O" & $id, "Mode=" & $AMSELMODE & @LF & "Name=" & $s & @LF & "Enabled=1" & @LF & _
		"Type=loop" & @LF & "GoHome=0" & @LF & "Steps=0")
	AMED_TOUCH()
	AMED_FILLOPTS($id)
EndFunc

Func AMED_OPTRENAME()
	If $AMSELOPT = 0 Then Return
	Local $s = AMED_ASK("Tên mới:", IniRead($SAMINI, "O" & $AMSELOPT, "Name", ""))
	If $s = "" Then Return
	IniWrite($SAMINI, "O" & $AMSELOPT, "Name", $s)
	AMED_TOUCH()
	AMED_FILLOPTS($AMSELOPT)
EndFunc

Func AMED_OPTDEL()
	If $AMSELOPT = 0 Then Return
	If Not AMED_CONFIRM("Xóa tùy chọn '" & IniRead($SAMINI, "O" & $AMSELOPT, "Name", "") & "' và các bước của nó?") Then Return
	IniDelete($SAMINI, "O" & $AMSELOPT)
	AMED_TOUCH()
	AMED_FILLOPTS()
EndFunc

; ---- cot 3 ----
Func AMED_STEPTEXT($s)
	Local $a = AM_PARSESTEP($s)
	Local $sT = AM_ACTTEXT($a[3])
	If $a[5] <> "" Then $sT &= "  - " & $a[5]
	Local $sC = ""
	For $i = 0 To 2
		If $a[$i] <> "" Then $sC &= "  " & $a[$i]
	Next
	If $sC = "" Then $sC = "  (không có)"
	Return $sT & "     màu:" & $sC
EndFunc

Func AMED_FILLSTEPS($iSel = 0)
	If $AMSELOPT = 0 Then
		AMED_LISTSET($AMLSTEP, "", -1)
		Return
	EndIf
	Local $aS = AM_GETSTEPS($AMSELOPT)
	Local $s = ""
	For $i = 1 To $aS[0]
		$s &= "|" & $i & ". " & AMED_STEPTEXT($aS[$i])
	Next
	Local $iIdx = -1
	If $iSel > 0 And $iSel <= $aS[0] Then $iIdx = $iSel - 1
	AMED_LISTSET($AMLSTEP, $s, $iIdx)
EndFunc

Func AMED_CURSTEP()
	Return GUICtrlSendMsg($AMLSTEP, 0x188, 0, 0) + 1     ; 0 = chua chon
EndFunc

Func AMED_ONSTEP()
	If $AMSELOPT = 0 Then Return
	Local $i = AMED_CURSTEP()
	Local $aS = AM_GETSTEPS($AMSELOPT)
	If $i < 1 Or $i > $aS[0] Then Return
	Local $a = AM_PARSESTEP($aS[$i])
	GUICtrlSetData($AMIP1, $a[0])
	GUICtrlSetData($AMIP2, $a[1])
	GUICtrlSetData($AMIP3, $a[2])
	Local $iA = 0, $sXY = $a[3]
	If StringUpper(StringLeft($a[3], 4)) = "END:" Then
		$iA = 1
		$sXY = StringMid($a[3], 5)
	EndIf
	Switch StringUpper($a[3])
		Case "WAIT"
			$sXY = ""
		Case "HOME"
			$iA = 2
			$sXY = ""
		Case "STOP"
			$iA = 3
			$sXY = ""
		Case "HOMEOK"
			$iA = 4
			$sXY = ""
	EndSwitch
	GUICtrlSendMsg($AMCACT, 0x14E, $iA, 0)
	GUICtrlSetData($AMICLICK, $sXY)
	GUICtrlSetData($AMINOTE, $a[5])
	GUICtrlSetData($AMITESTFROM, $i)             ; chon buoc nao thi chay thu tu buoc do
	GUICtrlSetData($AMITESTTO, "")
EndFunc

; doc o nhap -> chuoi buoc, "" neu thieu/sai (bao o dong thong tin)
Func AMED_READSTEP()
	Local $aIn[3] = [$AMIP1, $AMIP2, $AMIP3]
	Local $aC[3]
	Local $bHas = False
	For $i = 0 To 2
		$aC[$i] = StringStripWS(AMED_CLEAN(GUICtrlRead($aIn[$i])), 8)
		If $aC[$i] = "" Then ContinueLoop
		If Not StringRegExp($aC[$i], "^\d+,\d+,0[xX][0-9A-Fa-f]{6}$") Then
			AMED_INFO("Điểm màu " & ($i + 1) & " sai dạng. Đúng dạng: x,y,0xRRGGBB (bấm nút Chọn cho nhanh).")
			Return ""
		EndIf
		$bHas = True
	Next
	; quet lien tuc -> buoc nao cung phai co diem mau, khong thi lam lien tuc
	If Not $bHas Then
		AMED_INFO("Bước nào cũng phải có ít nhất 1 điểm màu để nhận đúng màn hình (tránh bấm mù).")
		Return ""
	EndIf
	Local $sAct = ""
	Local $iA = GUICtrlSendMsg($AMCACT, 0x147, 0, 0)
	Switch $iA
		Case 2
			$sAct = "HOME"
		Case 3
			$sAct = "STOP"
		Case 4
			$sAct = "HOMEOK"       ; chi de nhan ra man hinh chinh (muc ★ Ve man hinh chinh)
		Case Else      ; 0 = Click, 1 = Click roi xong
			$sAct = StringStripWS(AMED_CLEAN(GUICtrlRead($AMICLICK)), 8)
			If Not StringRegExp($sAct, "^\d+,\d+$") Then
				AMED_INFO("Chưa có điểm CLICK (bấm nút Chọn cạnh ô Hành động).")
				Return ""
			EndIf
			If $iA = 1 Then $sAct = "END:" & $sAct
	EndSwitch
	Return $aC[0] & "|" & $aC[1] & "|" & $aC[2] & "|" & $sAct & "|300|" & AMED_CLEAN(GUICtrlRead($AMINOTE))
EndFunc

Func AMED_STEPADD()
	If $AMSELOPT = 0 Then
		AMED_INFO("Chọn hoặc thêm một tùy chọn trước khi thêm bước.")
		Return
	EndIf
	Local $s = AMED_READSTEP()
	If $s = "" Then Return
	Local $aS = AM_GETSTEPS($AMSELOPT)
	$aS[0] += 1
	ReDim $aS[$aS[0] + 1]
	$aS[$aS[0]] = $s
	AM_SAVESTEPS($AMSELOPT, $aS)
	AMED_FILLSTEPS($aS[0])
	AMED_CLEARSTEP()               ; xoa trang o nhap cho buoc tiep theo, do nham
	AMED_INFO("Đã thêm bước " & $aS[0] & ".")
EndFunc

; nut "Buoc moi": bo chon buoc trong danh sach + xoa trang o nhap
Func AMED_STEPNEW()
	GUICtrlSendMsg($AMLSTEP, 0x186, -1, 0)     ; LB_SETCURSEL -1 = bo chon
	AMED_CLEARSTEP()
	GUICtrlSetData($AMITESTFROM, "")
	GUICtrlSetData($AMITESTTO, "")
	AMED_INFO("Nhập bước mới rồi bấm Thêm bước.")
EndFunc

Func AMED_CLEARSTEP()
	GUICtrlSetData($AMIP1, "")
	GUICtrlSetData($AMIP2, "")
	GUICtrlSetData($AMIP3, "")
	GUICtrlSetData($AMICLICK, "")
	GUICtrlSendMsg($AMCACT, 0x14E, 0, 0)       ; ve "Click vao diem"
	GUICtrlSetData($AMINOTE, "")
EndFunc

Func AMED_STEPUPDATE()
	If $AMSELOPT = 0 Then Return
	Local $i = AMED_CURSTEP()
	Local $aS = AM_GETSTEPS($AMSELOPT)
	If $i < 1 Or $i > $aS[0] Then
		AMED_INFO("Chọn 1 bước trong danh sách để cập nhật.")
		Return
	EndIf
	Local $s = AMED_READSTEP()
	If $s = "" Then Return
	$aS[$i] = $s
	AM_SAVESTEPS($AMSELOPT, $aS)
	AMED_FILLSTEPS($i)
	AMED_INFO("Đã cập nhật bước " & $i & ".")
EndFunc

Func AMED_STEPDEL()
	If $AMSELOPT = 0 Then Return
	Local $i = AMED_CURSTEP()
	Local $aS = AM_GETSTEPS($AMSELOPT)
	If $i < 1 Or $i > $aS[0] Then Return
	For $j = $i To $aS[0] - 1
		$aS[$j] = $aS[$j + 1]
	Next
	$aS[0] -= 1
	ReDim $aS[$aS[0] + 1]
	AM_SAVESTEPS($AMSELOPT, $aS)
	If $i > $aS[0] Then $i = $aS[0]
	AMED_FILLSTEPS($i)
EndFunc

Func AMED_STEPMOVE($iDir)
	If $AMSELOPT = 0 Then Return
	Local $i = AMED_CURSTEP()
	Local $aS = AM_GETSTEPS($AMSELOPT)
	Local $iTo = $i + $iDir
	If $i < 1 Or $i > $aS[0] Or $iTo < 1 Or $iTo > $aS[0] Then Return
	Local $t = $aS[$i]
	$aS[$i] = $aS[$iTo]
	$aS[$iTo] = $t
	AM_SAVESTEPS($AMSELOPT, $aS)
	AMED_FILLSTEPS($iTo)
EndFunc

Func AMED_STEPUP()
	AMED_STEPMOVE(-1)
EndFunc

Func AMED_STEPDOWN()
	AMED_STEPMOVE(1)
EndFunc

Func AMED_PICK1()
	Local $s = CUSTOM_PICK(True)
	If $s <> "" Then GUICtrlSetData($AMIP1, $s)
EndFunc

Func AMED_PICK2()
	Local $s = CUSTOM_PICK(True)
	If $s <> "" Then GUICtrlSetData($AMIP2, $s)
EndFunc

Func AMED_PICK3()
	Local $s = CUSTOM_PICK(True)
	If $s <> "" Then GUICtrlSetData($AMIP3, $s)
EndFunc

Func AMED_PICKCLICK()
	Local $s = CUSTOM_PICK(False)
	If $s = "" Then Return
	GUICtrlSetData($AMICLICK, $s)
	; dang de "Ve man hinh chinh"/"Dung auto" thi chuyen ve Click; giu "Click roi xong"
	If GUICtrlSendMsg($AMCACT, 0x147, 0, 0) > 1 Then GUICtrlSendMsg($AMCACT, 0x14E, 0, 0)
EndFunc

Func AMED_HAVEWIN()
	If $HWND = "" Or $HWND = 0 Or Not WinExists($HWND) Then
		AMED_INFO("Hãy gán cửa sổ trò chơi trong bảng điều khiển trước.")
		Return False
	EndIf
	$APOS = WinGetPos($HWND)
	Return IsArray($APOS)
EndFunc

; "xac nhan": so tung diem mau voi man hinh game ngay luc nay
Func AMED_TESTCOND()
	If Not AMED_HAVEWIN() Then Return
	Local $aIn[3] = [$AMIP1, $AMIP2, $AMIP3]
	Local $s = ""
	For $i = 0 To 2
		Local $c = StringStripWS(GUICtrlRead($aIn[$i]), 8)
		If $c = "" Then ContinueLoop
		Local $a = StringSplit($c, ",", 2)
		If UBound($a) < 3 Then
			$s &= "Điểm " & ($i + 1) & ": sai dạng" & @CRLF
			ContinueLoop
		EndIf
		Local $sNow = "0x" & MEMORYREADPIXEL(Number($a[0]), Number($a[1]), $HWND)
		If CUSTOM_CONDOK($c) Then
			$s &= "Điểm " & ($i + 1) & ": ĐÚNG  (đang là " & $sNow & ")" & @CRLF
		Else
			$s &= "Điểm " & ($i + 1) & ": SAI - cần " & $a[2] & ", đang là " & $sNow & @CRLF
		EndIf
	Next
	If $s = "" Then $s = "Chưa có điểm màu nào để kiểm tra."
	AMED_INFO($s)
EndFunc

Func AMED_TESTRUN()
	; bam "Chay thu" trong luc dang chay thu -> su kien xep hang, chay ngay khi vua xong -> bo qua
	If $AMTESTEND <> 0 And TimerDiff($AMTESTEND) < 1000 Then Return
	If $AMSELOPT = 0 Then Return
	If $BRUN Then
		AMED_INFO("Hãy dừng tự động trong bảng điều khiển trước khi chạy thử.")
		Return
	EndIf
	If Not AMED_HAVEWIN() Then Return
	Local $aS = AM_GETSTEPS($AMSELOPT)
	If $aS[0] = 0 Then
		AMED_INFO("Tùy chọn này chưa có bước nào.")
		Return
	EndIf
	Local $sSec = "O" & $AMSELOPT
	Local $sName = IniRead($SAMINI, $sSec, "Name", "")
	; doan chay thu: tu buoc .. den buoc .. (trong = tu dau / toi het)
	Local $iFrom = Number(GUICtrlRead($AMITESTFROM)), $iTo = Number(GUICtrlRead($AMITESTTO))
	If $iFrom < 1 Or $iFrom > $aS[0] Then $iFrom = 1
	If $iTo < $iFrom Or $iTo > $aS[0] Then $iTo = $aS[0]
	$AMTESTING = True
	GUICtrlSetState($AMBSTOPTEST, $GUI_ENABLE)
	GUICtrlSetState($AMBTESTRUN, $GUI_DISABLE)
	HotKeySet("{ESC}", "AM_TESTESC")
	CUSTOM_RELOAD()
	AdlibRegister("PROCESS_CUSTOM_CLICKS", 250)      ; Custom Click chay kem luc chay thu
	AM_LOG($sName & ": --- CHAY THU buoc " & $iFrom & " -> " & $iTo & " ---")
	; quet lien tuc toi khi gap "Click roi xong" / "Dung auto" / bam Dung. Ve Home chi voi kieu "het luot".
	Local $bHome = (AM_TYPEIDX(IniRead($SAMINI, $sSec, "Type", "loop")) = 1) And (IniRead($SAMINI, $sSec, "GoHome", "0") = "1")
	AM_RULESRUN($aS, $bHome, $sName, $iFrom, $iTo, AM_OPTBLOCK($AMSELOPT))
	HotKeySet("{ESC}")
	If Not $BRUN Then AdlibUnRegister("PROCESS_CUSTOM_CLICKS")
	If Not $AMTESTING Then
		AMED_INFO($sName & ": đã dừng chạy thử.")
		AM_LOG($sName & ": dung chay thu")
	EndIf
	$AMTESTING = False
	GUICtrlSetState($AMBSTOPTEST, $GUI_DISABLE)
	GUICtrlSetState($AMBTESTRUN, $GUI_ENABLE)
	$AMTESTEND = TimerInit()
EndFunc


; =============================================================================
;  WINDOW DOCKING / AUTO-DETECT / COLLAPSE MODULE
;
;  1. DOCK      : the Auto window sticks to the bottom-left corner of the
;                 assigned emulator window and follows it when it is moved.
;  2. AUTO-SCAN : on Start, if no window is assigned yet, look for an emulator
;                 window that no other running Auto instance has claimed.
;  3. COLLAPSE  : shrink the Auto window to a slim button bar while running,
;                 with a button to toggle back.
;
;  Instances coordinate through auto_assign.ini:  [Assigned] <pid>=<hwnd>
;  Stale entries (dead PIDs) are ignored and cleaned up automatically.
; =============================================================================

Func DOCK_TO_GAME($a = Default)
	If Not $HWND Or Not WinExists($HWND) Then Return
	Local $state = WinGetState($HWND)
	If BitAND($state, 16) Or Not BitAND($state, 2) Or BitAND(WinGetState($MAINFORM), 16) Then Return
	If Not IsArray($a) Then $a = WinGetPos($HWND)
	If Not IsArray($a) Then Return
	$APOS = $a
	Local $m = WinGetPos($MAINFORM)
	If Not IsArray($m) Then Return
	; Use the emulator's work area, including monitors left of the primary screen.
	Local $left = 0, $top = 0, $right = @DesktopWidth, $bottom = @DesktopHeight
	Local $monitor = _WinAPI_GetMonitorInfo(_WinAPI_MonitorFromWindow($HWND, $MONITOR_DEFAULTTONEAREST))
	If IsArray($monitor) Then
		$left = DllStructGetData($monitor[1], "Left")
		$top = DllStructGetData($monitor[1], "Top")
		$right = DllStructGetData($monitor[1], "Right")
		$bottom = DllStructGetData($monitor[1], "Bottom")
	EndIf
	Local $nx = $a[0], $ny = $a[1] + $a[3]
	If $ny + $m[3] > $bottom Then
		Select
			Case $a[1] - $m[3] >= $top
				$ny = $a[1] - $m[3]
			Case $a[0] + $a[2] + $m[2] <= $right
				$nx = $a[0] + $a[2]
				$ny = $a[1]
			Case $a[0] - $m[2] >= $left
				$nx = $a[0] - $m[2]
				$ny = $a[1]
			Case $a[1] - $top > $bottom - $ny
				$ny = $a[1] - $m[3]
		EndSelect
	EndIf
	If $nx + $m[2] > $right Then $nx = $right - $m[2]
	If $ny + $m[3] > $bottom Then $ny = $bottom - $m[3]
	If $nx < $left Then $nx = $left
	If $ny < $top Then $ny = $top
	If $m[0] <> $nx Or $m[1] <> $ny Then _WinAPI_SetWindowPos($MAINFORM, 0, $nx, $ny, 0, 0, BitOR($SWP_NOACTIVATE, $SWP_NOZORDER, $SWP_NOSIZE))
	If $uiDockWindow <> $HWND And $BCOLLAPSED Then UI_STATUS_LAYOUT()
	$uiDockWindow = $HWND
	$uiDockRect = $a
EndFunc

; ---------------------------------------------------------------------------
;  Claim bookkeeping so several Auto instances never grab the same emulator
; ---------------------------------------------------------------------------
Func CLAIM_WINDOW($hW)
    ; The kernel claim closes the gap between checking the INI and assigning the window.
    Local $mutex = DllCall("kernel32.dll", "handle", "CreateMutexW", "ptr", 0, "bool", False, "wstr", "Local\CTDT_Auto_Window_" & String($hW))
    Local $apiError = @error, $lastError = _WinAPI_GetLastError()
    If $apiError Or Not IsArray($mutex) Or Not $mutex[0] Then Return 0
    If $lastError = 183 Or IS_CLAIMED_BY_OTHER($hW) Then
        _WinAPI_CloseHandle($mutex[0])
        Return 0
    EndIf
    Return $mutex[0]
EndFunc

Func RELEASE_WINDOW()
    If $claimMutex Then
        IniDelete($SASSIGNINI, "Assigned", String(@AutoItPID))
        _WinAPI_CloseHandle($claimMutex)
        $claimMutex = 0
    EndIf
EndFunc

Func IS_CLAIMED_BY_OTHER($hW)
	Local $aSec = IniReadSection($SASSIGNINI, "Assigned")
	If @error Then Return False
	For $i = 1 To $aSec[0][0]
		Local $iPid = Number($aSec[$i][0])
		If $iPid = @AutoItPID Then ContinueLoop
		If Not ProcessExists($iPid) Then
			IniDelete($SASSIGNINI, "Assigned", $aSec[$i][0])   ; stale entry
			ContinueLoop
		EndIf
		If String($aSec[$i][1]) = String($hW) Then Return True
	Next
	Return False
EndFunc

; ---------------------------------------------------------------------------
;  Is this window an Android emulator we can drive?
; ---------------------------------------------------------------------------
Func IS_EMULATOR_WINDOW($hW, $sTitle, ByRef $processes)
    If $sTitle = "" Or Not BitAND(WinGetState($hW), 2) Then Return False
    If _WinAPI_GetWindow($hW, $GW_OWNER) Then Return False
    Local $pid = WinGetProcess($hW)
    For $i = 1 To $processes[0][0]
        If $processes[$i][1] <> $pid Then ContinueLoop
        Switch StringLower($processes[$i][0])
            Case "memu.exe", "memuheadless.exe", "nox.exe", "noxvmhandle.exe", "dnplayer.exe", "ldplayer.exe"
                Local $pos = WinGetPos($hW)
                Return IsArray($pos) And $pos[2] >= 600 And $pos[3] >= 300
        EndSwitch
        ExitLoop
    Next
    Return False
EndFunc

; ---------------------------------------------------------------------------
;  Find a free emulator window and assign it. Returns True on success.
; ---------------------------------------------------------------------------
Func UI_BINDING_VALID()
    Return $HWND <> 0 And $boundPid > 0 And WinExists($HWND) And WinGetProcess($HWND) = $boundPid
EndFunc

Func UI_BIND_LOST()
    If Not $HWND Then Return
    $uiBindingBusy = True
    $resumeOnBind = $BRUN
    $BRUN = False
    $AMTESTING = False
    AdlibUnRegister("PROCESS_CUSTOM_CLICKS")
    ; Keep the last geometry available to operations that are returning from Sleep.
    $HWND = 0
    $boundPid = 0
    $IMEMUIDX = -1
    $HMEMUIDXWIN = 0
    $SMEMUC = ""
    RELEASE_WINDOW()
    UI_RUN_BUTTON(False)
    WinSetTitle($MAINFORM, "", "CTDT Auto")
    _GUICtrlStatusBar_SetText($SSTATUS, "Đang chờ giả lập · " & $boundTitle, 0)
    _GUICtrlStatusBar_SetText($SSTATUS, "Mất kết nối", 1)
    $uiBindingBusy = False
EndFunc

Func UI_ATTACH_WINDOW($hW, $title, $autoStart)
    If UI_BINDING_VALID() And $hW = $HWND Then Return True
    Local $pid = WinGetProcess($hW), $pos = WinGetPos($hW)
    If $pid < 1 Or Not IsArray($pos) Then Return False
    Local $mutex = CLAIM_WINDOW($hW)
    If Not $mutex Then Return False
    If Not WinExists($hW) Or WinGetProcess($hW) <> $pid Then
        _WinAPI_CloseHandle($mutex)
        Return False
    EndIf
    $uiBindingBusy = True
    RELEASE_WINDOW()
    $claimMutex = $mutex
    $boundPid = $pid
    $boundTitle = $title
    $STEXT = $title
    $SINITEXT = $title
    $APOS = $pos
    $SMEMUC = ""
    $IMEMUIDX = -1
    $HMEMUIDXWIN = 0
    $HWND = $hW
    IniWrite($SASSIGNINI, "Assigned", String(@AutoItPID), String($hW))
    If Not VD_SAMEDESKTOP($MAINFORM, $hW) Then VD_MOVETOWINDOW($MAINFORM, $hW)
    WinSetTitle($MAINFORM, "", "CTDT Auto - " & $title)
    _GUICtrlStatusBar_SetText($SSTATUS, "Giả lập · " & $title, 0)
    _GUICtrlStatusBar_SetText($SSTATUS, "Sẵn sàng", 1)
    DOCK_TO_GAME()
    $uiBindingBusy = False
    If $autoStart Then AUTO_START_IF_IDLE()
    Return True
EndFunc

Func UI_REFRESH_BINDING()
    If $uiBindingBusy Then Return
    If $HWND And Not UI_BINDING_VALID() Then UI_BIND_LOST()
    If $pickedWindow Then
        Local $picked = $pickedWindow
        $pickedWindow = 0
        If WinExists($picked) And WinGetProcess($picked) = $pickedPid Then
            If Not UI_ATTACH_WINDOW($picked, WinGetTitle($picked), True) Then _GUICtrlStatusBar_SetText($SSTATUS, "Giả lập đã được một cửa sổ Auto khác sử dụng.", 0)
        EndIf
        Return
    EndIf
    If $HWND Or TimerDiff($bindingScanTime) < 1200 Then Return
    GET_GAME_WINDOW()
EndFunc

Func GET_GAME_WINDOW($bForce = False)
    If UI_BINDING_VALID() Then Return True
    If $HWND Then UI_BIND_LOST()
    $bindingScanTime = TimerInit()
    Local $wanted = ($boundTitle <> "" ? $boundTitle : $SWANTWIN)
    Local $windows = WinList(), $processes = ProcessList()
    If Not IsArray($windows) Or Not IsArray($processes) Then Return False
    For $pass = 1 To 2
        For $i = 1 To $windows[0][0]
            Local $title = $windows[$i][0], $hW = $windows[$i][1]
            If $wanted <> "" And $wanted <> $title Then ContinueLoop
            If Not IS_EMULATOR_WINDOW($hW, $title, $processes) Then ContinueLoop
            If $wanted = "" And $pass = 1 And Not VD_SAMEDESKTOP($MAINFORM, $hW) Then ContinueLoop
            If UI_ATTACH_WINDOW($hW, $title, $resumeOnBind And Not $bForce) Then Return True
        Next
        If $wanted <> "" Then ExitLoop
    Next
    Return False
EndFunc

; ---------------------------------------------------------------------------
;  Desktop ao cua Windows (IVirtualDesktopManager). Loi / Windows cu -> coi nhu cung desktop.
; ---------------------------------------------------------------------------
Func VD_MGR()
	If IsObj($VDMGR) Then Return $VDMGR
	Local $sTag = "IsWindowOnCurrentVirtualDesktop hresult(hwnd;ptr);GetWindowDesktopId hresult(hwnd;ptr);MoveWindowToDesktop hresult(hwnd;ptr);"
	$VDMGR = ObjCreateInterface("{AA509086-5CA9-4C25-8F95-589D3C07B48A}", "{A5CD92FF-29BE-454C-8D04-D82879FB3F1B}", $sTag)
	Return $VDMGR
EndFunc

; GUID desktop cua cua so (struct byte[16]), 0 neu khong lay duoc
Func VD_IDSTRUCT($hW)
	Local $o = VD_MGR()
	If Not IsObj($o) Then Return 0
	Local $t = DllStructCreate("byte[16]")
	If $o.GetWindowDesktopId($hW, DllStructGetPtr($t)) <> 0 Then Return 0
	If DllStructGetData($t, 1) = Binary("0x00000000000000000000000000000000") Then Return 0
	Return $t
EndFunc

Func VD_SAMEDESKTOP($hA, $hB)
	Local $tA = VD_IDSTRUCT($hA), $tB = VD_IDSTRUCT($hB)
	If Not IsDllStruct($tA) Or Not IsDllStruct($tB) Then Return True
	Return DllStructGetData($tA, 1) = DllStructGetData($tB, 1)
EndFunc

; chuyen cua so cua Auto (chinh process nay) sang desktop cua $hTarget
Func VD_MOVETOWINDOW($hMine, $hTarget)
	Local $o = VD_MGR()
	If Not IsObj($o) Then Return
	Local $t = VD_IDSTRUCT($hTarget)
	If Not IsDllStruct($t) Then Return
	$o.MoveWindowToDesktop($hMine, DllStructGetPtr($t))
EndFunc

; Di chuyen control bang toa do client TUYET DOI.
; Khong dung GUICtrlSetPos vi ham do phu thuoc Opt("GUICoordMode"),
; ma ban goc co UDF thay doi tuy chon nay -> toa do bi dien giai sai.
Func MOVE_CTRL($idCtrl, $x, $y, $w, $h)
	ControlMove($MAINFORM, "", GUICtrlGetHandle($idCtrl), $x, $y, $w, $h)
EndFunc
; Dat kich thuoc VUNG CLIENT (WinMove dat kich thuoc cua so NGOAI,
; nen phai bu them phan vien + thanh tieu de, neu khong form se co dan lai
; sau moi lan thu gon/mo rong va cac nut o duoi bi day ra ngoai).
Func SET_CLIENT_SIZE($hWin, $iW, $iH)
	Local $aW = WinGetPos($hWin)
	Local $aC = WinGetClientSize($hWin)
	If Not IsArray($aW) Or Not IsArray($aC) Then Return
	Local $dx = $aW[2] - $aC[0]
	Local $dy = $aW[3] - $aC[1]
	WinMove($hWin, "", $aW[0], $aW[1], $iW + $dx, $iH + $dy)
EndFunc

Func UI_BLOCK($x, $y, $w, $h, $color)
    Local $id = GUICtrlCreateLabel("", $x, $y, $w, $h)
    GUICtrlSetBkColor($id, $color)
    GUICtrlSetState($id, $GUI_DISABLE)
    Return $id
EndFunc

Func UI_HEADER($title, $subtitle, $w, $textWidth = Default)
    If $textWidth = Default Then $textWidth = $w - 44
    UI_BLOCK(0, 0, $w, 38, $UI_NAVY)
    UI_BLOCK(0, 0, 4, 38, 0x38C9B2)
    Local $id = GUICtrlCreateLabel($title, 14, 2, $textWidth, 20, BitOR($SS_NOPREFIX, $SS_CENTERIMAGE))
    GUICtrlSetFont($id, 11, 600, 0, "Segoe UI")
    GUICtrlSetColor($id, 0xFFFFFF)
    GUICtrlSetBkColor($id, $UI_NAVY)
    $id = GUICtrlCreateLabel($subtitle, 14, 20, $textWidth, 16, $SS_NOPREFIX)
    GUICtrlSetFont($id, 8.5, 400, 0, "Segoe UI")
    GUICtrlSetColor($id, 0xBFD9DA)
    GUICtrlSetBkColor($id, $UI_NAVY)
    Return $id
EndFunc

Func UI_TITLE($text, $x, $y, $w, $background = $UI_BG)
    Local $id = GUICtrlCreateLabel($text, $x, $y, $w, 20, $SS_NOPREFIX)
    GUICtrlSetFont($id, 10.5, 600, 0, "Segoe UI")
    GUICtrlSetColor($id, $UI_INK)
    GUICtrlSetBkColor($id, $background)
    Return $id
EndFunc

Func UI_CAPTION($text, $x, $y, $w)
    Local $id = GUICtrlCreateLabel($text, $x, $y, $w, 18, $SS_NOPREFIX)
    GUICtrlSetFont($id, 8.5, 600, 0, "Segoe UI")
    GUICtrlSetColor($id, $UI_MUTED)
    Return $id
EndFunc

Func UI_BUTTON($text, $x, $y, $w, $h, $callback, $primary = False)
    Local $id = GUICtrlCreateButton($text, $x, $y, $w, $h)
    GUICtrlSetFont($id, 9, 600, 0, "Segoe UI")
    GUICtrlSetColor($id, ($primary ? 0xFFFFFF : $UI_INK))
    GUICtrlSetBkColor($id, ($primary ? $UI_TEAL : $UI_BUTTON_BG))
    If $callback <> "" Then GUICtrlSetOnEvent($id, $callback)
    Return $id
EndFunc

Func UI_HEADER_LINK($text, $x, $w, $callback)
    Local $id = UI_BUTTON($text, $x, 6, $w, 26, $callback)
    GUICtrlSetColor($id, 0xFFFFFF)
    GUICtrlSetBkColor($id, 0x284B58)
    Return $id
EndFunc

Func UI_CHECK($text, $x, $y, $w, $callback = "", $checked = False)
    Local $id = GUICtrlCreateCheckbox($text, $x, $y, $w, 20)
    If $checked Then GUICtrlSetState($id, $GUI_CHECKED)
    If $callback <> "" Then GUICtrlSetOnEvent($id, $callback)
    Return $id
EndFunc

Func UI_RADIO($text, $x, $y, $w, $callback, $checked = False)
    Local $id = GUICtrlCreateRadio($text, $x, $y, $w, 20)
    If $checked Then GUICtrlSetState($id, $GUI_CHECKED)
    GUICtrlSetOnEvent($id, $callback)
    Return $id
EndFunc

Func UI_TOOLBAR($compact)
    If $compact Then
        MOVE_CTRL($BSTART,       8, 6,  80, 30)
        MOVE_CTRL($BASSIGN,     92, 6,  88, 30)
        MOVE_CTRL($BRESIZE,    184, 6, 110, 30)
        MOVE_CTRL($BCUSTOMBTN, 298, 6, 105, 30)
        MOVE_CTRL($BTOGGLE,    408, 6,  70, 30)
        MOVE_CTRL($BEXIT,      482, 6,  50, 30)
    Else
        MOVE_CTRL($BSTART,      10, 284, 100, 30)
        MOVE_CTRL($BASSIGN,    116, 284,  90, 30)
        MOVE_CTRL($BRESIZE,    212, 284, 115, 30)
        MOVE_CTRL($BCUSTOMBTN, 333, 284, 110, 30)
        MOVE_CTRL($BTOGGLE,    465, 284,  85, 30)
        MOVE_CTRL($BEXIT,      556, 284,  84, 30)
    EndIf
EndFunc

Func UI_RUN_BUTTON($running)
    GUICtrlSetData($BSTART, ($running ? "Dừng" : "Bắt đầu"))
    GUICtrlSetBkColor($BSTART, ($running ? 0xA7363C : $UI_TEAL))
    GUICtrlSetColor($BSTART, 0xFFFFFF)
EndFunc

Func UI_LIST_WIDTH($id, $items)
    Local $hList = GUICtrlGetHandle($id)
    Local $dc = _WinAPI_GetDC($hList)
    If Not $dc Then Return
    Local $oldFont = _WinAPI_SelectObject($dc, _SendMessage($hList, $WM_GETFONT))
    Local $rows = StringSplit($items, "|", 2), $width = 0
    For $row In $rows
        If $row = "" Then ContinueLoop
        Local $size = _WinAPI_GetTextExtentPoint32($dc, $row)
        If IsDllStruct($size) Then
            Local $pixels = DllStructGetData($size, 1) + 6
            If $pixels > $width Then $width = $pixels
        EndIf
    Next
    If $oldFont Then _WinAPI_SelectObject($dc, $oldFont)
    _WinAPI_ReleaseDC($hList, $dc)
    GUICtrlSendMsg($id, 0x194, $width, 0) ; LB_SETHORIZONTALEXTENT
EndFunc

Func UI_MODE_CAPTION()
    Local $name = GUICtrlRead($LAMMODE)
    GUICtrlSetData($uiModeCaption, ($name = "" ? "Chưa chọn chế độ" : "Chế độ đã chọn  ·  " & $name))
EndFunc

Func UI_STATUS_LAYOUT()
    If $BCOLLAPSED And $HWND Then
        Local $partsMini[3] = [$UI_COMPACT_W - 240, $UI_COMPACT_W - 120, -1]
        _GUICtrlStatusBar_SetParts($SSTATUS, $partsMini)
        _GUICtrlStatusBar_SetText($SSTATUS, $STEXT, 2)
        _GUICtrlStatusBar_SetTipText($SSTATUS, 2, $STEXT)
    Else
        Local $width = ($BCOLLAPSED ? $UI_COMPACT_W : $UI_MAIN_W)
        Local $parts[2] = [$width - 140, -1]
        _GUICtrlStatusBar_SetParts($SSTATUS, $parts)
    EndIf
EndFunc

Func SET_COLLAPSED($bOn)
    If $uiChangingLayout Or $BCOLLAPSED = $bOn Then Return
    $uiChangingLayout = True
    $BCOLLAPSED = $bOn
    Local $w = ($bOn ? $UI_COMPACT_W : $UI_MAIN_W)
    Local $h = ($bOn ? $UI_COMPACT_H : $UI_MAIN_H)
    ; Freeze painting until the toolbar and expanded settings are in position.
    _SendMessage($MAINFORM, $WM_SETREDRAW, False)
    ; Preserve visibility and other live style bits, replacing only the window frame.
    Local $style = _WinAPI_GetWindowLong($MAINFORM, $GWL_STYLE)
    Local $frame = ($bOn ? $WS_POPUP : $uiExpandedFrame)
    _WinAPI_SetWindowLong($MAINFORM, $GWL_STYLE, BitOR(BitAND($style, BitNOT($uiFrameMask)), $frame))
    _WinAPI_SetWindowPos($MAINFORM, 0, 0, 0, 0, 0, BitOR($SWP_FRAMECHANGED, $SWP_NOMOVE, $SWP_NOSIZE, $SWP_NOACTIVATE, $SWP_NOZORDER))
    SET_CLIENT_SIZE($MAINFORM, $w, $h)
    For $id = $uiFirstSetting To $uiLastSetting
        GUICtrlSetState($id, ($bOn ? $GUI_HIDE : $GUI_SHOW))
    Next
    UI_TOOLBAR($bOn)
    GUICtrlSetData($BTOGGLE, ($bOn ? "Mở rộng" : "Thu gọn"))
    UI_STATUS_LAYOUT()
    _SendMessage($MAINFORM, $WM_SETREDRAW, True)
    _WinAPI_RedrawWindow($MAINFORM, 0, 0, BitOR($RDW_INVALIDATE, $RDW_ERASE, $RDW_ALLCHILDREN))
    DOCK_TO_GAME()
    $uiChangingLayout = False
EndFunc


; Tu dong bam Start ngay sau khi gan duoc cua so.
; Chi chay khi Auto dang dung, va co the tat bang custom_clicks.ini:
;   [Config] AutoStart=0
Func AUTO_START_IF_IDLE()
	If $BINSTART Then Return
	If Not $BAUTOSTART Then Return
	If $BRUN Then Return
	If $HWND = "" Or $HWND = 0 Then Return
	If Not WinExists($HWND) Then Return
	Sleep(400)
	BSTARTCLICK(True)
EndFunc
Func BTOGGLECLICK()
	SET_COLLAPSED(Not $BCOLLAPSED)
EndFunc
