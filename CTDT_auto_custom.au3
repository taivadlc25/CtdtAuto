; Icon Presents (thuong / co cham do) + icon Missions HOAC Battle Pass.
; Missions / Battle Pass hay co cham do "1" de len diem kiem tra (719,313) / (779,315)
; nen chi can 1 trong 2 icon khop, va chap nhan ca mau luc co cham do cua Missions.
Func ISHOMESCREEN ( )
	; diem mau "Day la man hinh chinh" nguoi dung ghi trong Mode Editor (moi MEmu hien thi lech nhau)
	If AM_ISHOMEUSER ( ) Then Return True
	If Not ISHOMEPRESENTSICON ( ) Then Return False
	If CHECKCOLOR ( 779 , 315 , 16775304 ) Then Return True
	If CHECKCOLOR ( 719 , 313 , 16775048 ) Or CHECKCOLOR ( 720 , 315 , 16773768 ) Or CHECKCOLOR ( 715 , 315 , 16774792 ) Or CHECKCOLOR ( 719 , 313 , 16774536 ) Then Return True
	; Missions dang co cham do (do tren may JP 28/09)
	If CHECKCOLOR ( 720 , 315 , 0xF6848A ) Or CHECKCOLOR ( 715 , 315 , 0xEE0515 ) Then Return True
	Return False
EndFunc
