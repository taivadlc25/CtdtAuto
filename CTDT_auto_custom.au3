		$TFSI = DllStructCreate ( "ulong;ulong;int64;int64;wchar[" & ( DllStructGetData ( DllStructCreate ( "ulong" , $PDATA + $ILENGTH + 4 ) , 1 ) / 2 ) & "]" , $PDATA + $ILENGTH )
