; =============================================================================
;  CUSTOM CLICK MODULE  -  written for the original 20260903_CTDT_auto base
;
;  COORDINATE RULE (this is where it usually goes wrong):
;    The base uses MEMORYREADPIXEL(x, y, $HWND) with _WinAPI_GetWindowDC
;      -> (x, y) are RELATIVE TO THE GAME WINDOW top-left corner.
;    The base uses SENDCLICK(x, y, $APOS) where x, y are SCREEN coordinates.
;    CLICKPIXEL bridges both: SENDCLICK(x + $APOS[0], y + $APOS[1], $APOS)
;
;    => The point picker MUST return WINDOW-RELATIVE coordinates:
;         wx = cursorScreenX - $APOS[0]
;         wy = cursorScreenY - $APOS[1]
;    => CUSTOM_CLICKAT() adds $APOS back before calling SENDCLICK.
;
;  custom_clicks.ini format (shared by every Auto instance):
;    [Config]
;    Enabled=1
;    Total=N
;    [CustomClicks]
;    1=x,y,0xRRGGBB|x,y,0xRRGGBB|x,y,0xRRGGBB|clickX,clickY|delayMs|note
;      - 3 condition points, any may be empty, but AT LEAST ONE is required
;      - clickX,clickY is mandatory
;      - delayMs defaults to 200 when left blank
; =============================================================================


; -----------------------------------------------------------------------------
;  Reload the INI when the file has changed
;  (so several Auto instances can share one file)
; -----------------------------------------------------------------------------
Func CUSTOM_RELOAD()
	If Not FileExists($SCUSTOMINI) Then
		IniWrite($SCUSTOMINI, "Config", "Enabled", "1")
		IniWrite($SCUSTOMINI, "Config", "Total", "0")
	EndIf
	$SCUSTOMINITIME = FileGetTime($SCUSTOMINI, 0, 1)
	$BCUSTOMENABLED = (IniRead($SCUSTOMINI, "Config", "Enabled", "1") = "1")
	$BAUTOSTART = (IniRead($SCUSTOMINI, "Config", "AutoStart", "1") = "1")

	Local $aSec = IniReadSection($SCUSTOMINI, "CustomClicks")
	If @error Then
		$ICUSTOMCOUNT = 0
		ReDim $ACUSTOM[1][6]
		Return
	EndIf
	$ICUSTOMCOUNT = $aSec[0][0]
	ReDim $ACUSTOM[$ICUSTOMCOUNT + 1][6]
	For $i = 1 To $ICUSTOMCOUNT
		Local $aP = StringSplit($aSec[$i][1], "|", 2)
		$ACUSTOM[$i][0] = (UBound($aP) > 0) ? StringStripWS($aP[0], 3) : ""
		$ACUSTOM[$i][1] = (UBound($aP) > 1) ? StringStripWS($aP[1], 3) : ""
		$ACUSTOM[$i][2] = (UBound($aP) > 2) ? StringStripWS($aP[2], 3) : ""
		$ACUSTOM[$i][3] = (UBound($aP) > 3) ? StringStripWS($aP[3], 3) : ""
		$ACUSTOM[$i][4] = (UBound($aP) > 4 And Number($aP[4]) > 0) ? Number($aP[4]) : 200
		$ACUSTOM[$i][5] = (UBound($aP) > 5) ? StringStripWS($aP[5], 3) : ""
	Next
EndFunc

Func CUSTOM_CHECKRELOAD()
	If Not FileExists($SCUSTOMINI) Then Return
	Local $sT = FileGetTime($SCUSTOMINI, 0, 1)
	If $sT <> $SCUSTOMINITIME Then CUSTOM_RELOAD()
EndFunc


; -----------------------------------------------------------------------------
;  Colour match: uses the base MEMORYREADPIXEL, tolerance +/- 5 per RGB channel
; -----------------------------------------------------------------------------
Func CUSTOM_COLOROK($iX, $iY, $sHex)
	Local $sGot = MEMORYREADPIXEL($iX, $iY, $HWND)
	Local $sWant = StringUpper(StringReplace(StringStripWS($sHex, 3), "0x", ""))
	If StringLen($sWant) < 6 Then Return False
	If $sGot = $sWant Then Return True
	Local $r1 = Dec(StringMid($sGot, 1, 2)), $g1 = Dec(StringMid($sGot, 3, 2)), $b1 = Dec(StringMid($sGot, 5, 2))
	Local $r2 = Dec(StringMid($sWant, 1, 2)), $g2 = Dec(StringMid($sWant, 3, 2)), $b2 = Dec(StringMid($sWant, 5, 2))
	Return (Abs($r1 - $r2) <= 5 And Abs($g1 - $g2) <= 5 And Abs($b1 - $b2) <= 5)
EndFunc

; Check one condition string "x,y,0xRRGGBB"
Func CUSTOM_CONDOK($sCond)
	If StringStripWS($sCond, 3) = "" Then Return True       ; empty = skip this point
	Local $a = StringSplit($sCond, ",", 2)
	If UBound($a) < 3 Then Return False                     ; malformed = DO NOT click
	Local $sC = StringStripWS($a[2], 3)
	If $sC = "" Then Return False
	Return CUSTOM_COLOROK(Number($a[0]), Number($a[1]), $sC)
EndFunc

; Click at a window-relative coordinate
Func CUSTOM_CLICKAT($sXY)
	Local $a = StringSplit($sXY, ",", 2)
	If UBound($a) < 2 Then Return False
	Local $x = Number($a[0]), $y = Number($a[1])
	SENDCLICK($x + $APOS[0], $y + $APOS[1], $APOS)
	Return True
EndFunc


; -----------------------------------------------------------------------------
;  Background worker: walk every rule
; -----------------------------------------------------------------------------
Func PROCESS_CUSTOM_CLICKS()
	If $BCUSTOMBUSY Then Return
	If Not ($BRUN Or $AMTESTING) Then Return      ; chay ca luc Chay thu option (Mode Editor)
	If $HWND = "" Or $HWND = 0 Then Return
	If Not IsArray($APOS) Then Return

	$BCUSTOMBUSY = True
	CUSTOM_CHECKRELOAD()

	If $BCUSTOMENABLED And $ICUSTOMCOUNT > 0 Then
		For $i = 1 To $ICUSTOMCOUNT
			If Not ($BRUN Or $AMTESTING) Then ExitLoop

			Local $c1 = $ACUSTOM[$i][0], $c2 = $ACUSTOM[$i][1], $c3 = $ACUSTOM[$i][2]
			Local $sClick = $ACUSTOM[$i][3]

			; MANDATORY: at least one condition point AND a click target
			If $c1 = "" And $c2 = "" And $c3 = "" Then ContinueLoop
			If StringStripWS($sClick, 3) = "" Then ContinueLoop

			If Not CUSTOM_CONDOK($c1) Then ContinueLoop
			If Not CUSTOM_CONDOK($c2) Then ContinueLoop
			If Not CUSTOM_CONDOK($c3) Then ContinueLoop

			If CUSTOM_CLICKAT($sClick) Then
				Local $sNote = $ACUSTOM[$i][5]
				If $sNote = "" Then $sNote = $sClick
				_GUICtrlStatusBar_SetText($SSTATUS, "Custom: " & $sNote, 0, 0)
				Local $iD = Number($ACUSTOM[$i][4])
				If $iD < 100 Then $iD = 100
				Sleep($iD)
			EndIf
		Next
	EndIf

	$BCUSTOMBUSY = False
EndFunc


; -----------------------------------------------------------------------------
;  Absolute screen cursor position.
;  Do NOT use MouseGetPos(): the base sets Opt("MouseCoordMode", 0), so it
;  returns coordinates relative to the active window, not to the screen.
;  GetCursorPos always returns screen coordinates and ignores that option.
; -----------------------------------------------------------------------------
Func CUSTOM_GETCURSOR()
	Local $tP = DllStructCreate("int X;int Y")
	DllCall("user32.dll", "bool", "GetCursorPos", "struct*", $tP)
	Local $a[2] = [DllStructGetData($tP, "X"), DllStructGetData($tP, "Y")]
	Return $a
EndFunc


; =============================================================================
;  POINT PICKER
;    - Move the mouse: the magnifier follows, showing live coordinates + colour
;    - RIGHT-CLICK : pick the point  (left-click is not used, it would be
;                    delivered to the game underneath)
;    - ESC         : cancel
;  Returns "x,y,0xRRGGBB" when $bColor = True, otherwise "x,y". "" on cancel.
;
;  The magnified image is grabbed from the GAME WINDOW DC (_WinAPI_GetWindowDC),
;  not from the screen DC. That way it:
;    - shows exactly the pixels MEMORYREADPIXEL will later compare
;    - keeps working over Remote Desktop and when the window is partly covered
; =============================================================================
Func CUSTOM_PICK($bColor = True)
	If $HWND = "" Or $HWND = 0 Then
		MsgBox(48 + 262144, "Chưa gắn cửa sổ game", "Hãy gắn cửa sổ game trong bảng điều khiển trước khi lấy điểm.")
		Return ""
	EndIf
	$APOS = WinGetPos($HWND)
	If Not IsArray($APOS) Then Return ""

	Local $bHid = False
	If $HCUSTOMFORM <> 0 And WinExists($HCUSTOMFORM) Then
		GUISetState(@SW_HIDE, $HCUSTOMFORM)
		$bHid = True
	EndIf
	; an ca Mode Editor de khong che man hinh game khi chon diem
	Local $bHidAM = False
	If $HAMFORM <> 0 And WinExists($HAMFORM) And BitAND(WinGetState($HAMFORM), 2) Then
		GUISetState(@SW_HIDE, $HAMFORM)
		$bHidAM = True
	EndIf

	$HZOOMGUI = GUICreate("Lấy điểm", 170, 196, -1, -1, $WS_POPUP, BitOR($WS_EX_TOPMOST, $WS_EX_TOOLWINDOW))
	GUISetBkColor($UI_NAVY, $HZOOMGUI)
	$IZOOMLBL = GUICtrlCreateLabel("", 0, 170, 170, 26, BitOR($SS_CENTER, $SS_CENTERIMAGE))
	GUICtrlSetColor($IZOOMLBL, 0xFFFFFF)
	GUICtrlSetBkColor($IZOOMLBL, $UI_NAVY)
	GUICtrlSetFont($IZOOMLBL, 9, 600, 0, "Consolas")
	GUISetState(@SW_SHOWNOACTIVATE, $HZOOMGUI)

	ToolTip("Nhấp chuột phải để lấy điểm. Nhấn Esc để hủy.")

	While _IsPressed("02")
		Sleep(20)
	WEnd

	Local $sRet = "", $iSrc = 17, $iBox = 170
	Local $aC, $wx, $wy, $sCol, $iZX, $iZY, $aWin

	While 1
		; the game window may be moved while picking
		$aWin = WinGetPos($HWND)
		If IsArray($aWin) Then $APOS = $aWin

		$aC = CUSTOM_GETCURSOR()

		; window-relative coordinates - same frame MEMORYREADPIXEL uses
		$wx = $aC[0] - $APOS[0]
		$wy = $aC[1] - $APOS[1]

		; park the magnifier next to the cursor (WinMove always uses screen coords)
		$iZX = $aC[0] + 26
		$iZY = $aC[1] + 26
		If $iZX + 170 > @DesktopWidth  Then $iZX = $aC[0] - 196
		If $iZY + 196 > @DesktopHeight Then $iZY = $aC[1] - 222
		WinMove($HZOOMGUI, "", $iZX, $iZY)

		CUSTOM_DRAWZOOM($wx, $wy, $iSrc, $iBox)

		$sCol = MEMORYREADPIXEL($wx, $wy, $HWND)
		GUICtrlSetData($IZOOMLBL, $wx & "," & $wy & "  0x" & $sCol)

		If _IsPressed("02") Then
			While _IsPressed("02")
				Sleep(20)
			WEnd
			If $bColor Then
				$sRet = $wx & "," & $wy & ",0x" & $sCol
			Else
				$sRet = $wx & "," & $wy
			EndIf
			ExitLoop
		EndIf

		If _IsPressed("1B") Then
			While _IsPressed("1B")
				Sleep(20)
			WEnd
			$sRet = ""
			ExitLoop
		EndIf

		Sleep(25)
	WEnd

	ToolTip("")
	GUIDelete($HZOOMGUI)
	$HZOOMGUI = 0
	If $bHid Then
		GUISetState(@SW_SHOW, $HCUSTOMFORM)
		WinSetOnTop($HCUSTOMFORM, "", 1)
		WinActivate($HCUSTOMFORM)
	EndIf
	If $bHidAM Then
		GUISetState(@SW_SHOW, $HAMFORM)
		WinActivate($HAMFORM)
	EndIf
	Return $sRet
EndFunc

; Draw the magnified patch taken from the GAME WINDOW DC.
; ($iWX, $iWY) are window-relative coordinates.
Func CUSTOM_DRAWZOOM($iWX, $iWY, $iSrc, $iBox)
	Local $hWinDC = _WinAPI_GetDC($HZOOMGUI)
	Local $hGameDC = _WinAPI_GetWindowDC($HWND)

	Local $aMem = DllCall("gdi32.dll", "handle", "CreateCompatibleDC", "handle", $hWinDC)
	Local $hMem = $aMem[0]
	Local $aBmp = DllCall("gdi32.dll", "handle", "CreateCompatibleBitmap", "handle", $hWinDC, "int", $iBox, "int", $iBox)
	Local $hBmp = $aBmp[0]
	Local $aOld = DllCall("gdi32.dll", "handle", "SelectObject", "handle", $hMem, "handle", $hBmp)

	; COLORONCOLOR = 3: keep hard pixel edges when scaling up, no blur
	DllCall("gdi32.dll", "int", "SetStretchBltMode", "handle", $hMem, "int", 3)
	Local $iHalf = Int($iSrc / 2)
	_WinAPI_StretchBlt($hMem, 0, 0, $iBox, $iBox, $hGameDC, $iWX - $iHalf, $iWY - $iHalf, $iSrc, $iSrc, $SRCCOPY)

	; red crosshair + box around the exact pixel being picked
	Local $iPx = Int($iBox / $iSrc)
	Local $aPen = DllCall("gdi32.dll", "handle", "CreatePen", "int", 0, "int", 1, "dword", 0x0000FF)
	Local $hPen = $aPen[0]
	Local $aOldPen = DllCall("gdi32.dll", "handle", "SelectObject", "handle", $hMem, "handle", $hPen)
	Local $x0 = $iHalf * $iPx, $y0 = $iHalf * $iPx
	DllCall("gdi32.dll", "bool", "MoveToEx", "handle", $hMem, "int", $x0, "int", 0, "ptr", 0)
	DllCall("gdi32.dll", "bool", "LineTo",   "handle", $hMem, "int", $x0, "int", $iBox)
	DllCall("gdi32.dll", "bool", "MoveToEx", "handle", $hMem, "int", 0, "int", $y0, "ptr", 0)
	DllCall("gdi32.dll", "bool", "LineTo",   "handle", $hMem, "int", $iBox, "int", $y0)
	DllCall("gdi32.dll", "bool", "MoveToEx", "handle", $hMem, "int", $x0, "int", $y0, "ptr", 0)
	DllCall("gdi32.dll", "bool", "LineTo",   "handle", $hMem, "int", $x0 + $iPx, "int", $y0)
	DllCall("gdi32.dll", "bool", "LineTo",   "handle", $hMem, "int", $x0 + $iPx, "int", $y0 + $iPx)
	DllCall("gdi32.dll", "bool", "LineTo",   "handle", $hMem, "int", $x0, "int", $y0 + $iPx)
	DllCall("gdi32.dll", "bool", "LineTo",   "handle", $hMem, "int", $x0, "int", $y0)
	DllCall("gdi32.dll", "handle", "SelectObject", "handle", $hMem, "handle", $aOldPen[0])
	DllCall("gdi32.dll", "bool", "DeleteObject", "handle", $hPen)

	_WinAPI_BitBlt($hWinDC, 0, 0, $iBox, $iBox, $hMem, 0, 0, $SRCCOPY)

	DllCall("gdi32.dll", "handle", "SelectObject", "handle", $hMem, "handle", $aOld[0])
	DllCall("gdi32.dll", "bool", "DeleteObject", "handle", $hBmp)
	DllCall("gdi32.dll", "bool", "DeleteDC", "handle", $hMem)
	_WinAPI_ReleaseDC($HWND, $hGameDC)
	_WinAPI_ReleaseDC($HZOOMGUI, $hWinDC)
EndFunc


; =============================================================================
;  CONFIGURATION FORM
; =============================================================================
Func BCUSTOMCLICKOPEN()
    If $HCUSTOMFORM <> 0 And WinExists($HCUSTOMFORM) Then
        GUISetState(@SW_SHOW, $HCUSTOMFORM)
        WinActivate($HCUSTOMFORM)
        Return
    EndIf

    $HCUSTOMFORM = GUICreate("Quy tắc bấm • CTDT Auto", 824, 510, -1, -1, -1, $WS_EX_TOPMOST)
    GUISetFont(9, 400, 0, "Segoe UI")
    GUISetBkColor($UI_BG)
    GUISetOnEvent($GUI_EVENT_CLOSE, "CUSTOM_FORMCLOSE", $HCUSTOMFORM)
    UI_HEADER("Quy tắc bấm", "Tự động bấm vào một vị trí khi các điểm màu đã chọn cùng khớp.", 824)

    UI_TITLE("Điều kiện màu", 22, 84, 360)
    GUICtrlCreateLabel("Chọn ít nhất một điểm trên cửa sổ game.", 22, 110, 364, 20)
    GUICtrlSetColor(-1, $UI_MUTED)
    GUICtrlCreateLabel("Điểm 1", 22, 144, 54, 20)
    $IP1 = GUICtrlCreateInput("", 81, 139, 195, 28)
    UI_BUTTON("Lấy điểm", 284, 138, 96, 30, "CUSTOM_PICK1")
    GUICtrlCreateLabel("Điểm 2", 22, 181, 54, 20)
    $IP2 = GUICtrlCreateInput("", 81, 176, 195, 28)
    UI_BUTTON("Lấy điểm", 284, 175, 96, 30, "CUSTOM_PICK2")
    GUICtrlCreateLabel("Điểm 3", 22, 218, 54, 20)
    $IP3 = GUICtrlCreateInput("", 81, 213, 195, 28)
    UI_BUTTON("Lấy điểm", 284, 212, 96, 30, "CUSTOM_PICK3")

    UI_TITLE("Hành động", 424, 84, 360)
    GUICtrlCreateLabel("Chọn vị trí sẽ bấm khi thỏa điều kiện màu.", 424, 110, 378, 20)
    GUICtrlSetColor(-1, $UI_MUTED)
    GUICtrlCreateLabel("Vị trí bấm", 424, 144, 92, 20)
    $IPCLICK = GUICtrlCreateInput("", 524, 139, 174, 28)
    UI_BUTTON("Lấy vị trí", 706, 138, 96, 30, "CUSTOM_PICKCLICK")
    GUICtrlCreateLabel("Chờ sau bấm", 424, 181, 96, 20)
    $IPDELAY = GUICtrlCreateInput("200", 524, 176, 80, 28)
    GUICtrlCreateLabel("ms", 612, 181, 30, 20)
    GUICtrlSetColor(-1, $UI_MUTED)
    GUICtrlCreateLabel("Ghi chú", 424, 218, 92, 20)
    $IPNOTE = GUICtrlCreateInput("", 524, 213, 278, 28)

    UI_TITLE("Danh sách quy tắc", 22, 262, 340)
    GUICtrlCreateLabel("Mỗi dòng là một quy tắc. Bạn có thể sửa trực tiếp trước khi lưu.", 22, 286, 599, 20)
    GUICtrlSetColor(-1, $UI_MUTED)
    UI_BUTTON("Thêm vào danh sách", 640, 268, 162, 32, "CUSTOM_ADD")

    $ECUSTOMLIST = GUICtrlCreateEdit("", 22, 312, 780, 136, BitOR($WS_VSCROLL, $WS_HSCROLL, $ES_WANTRETURN, $ES_MULTILINE, $ES_AUTOHSCROLL, $ES_AUTOVSCROLL))
    GUICtrlSetFont($ECUSTOMLIST, 10, 400, 0, "Consolas")
    GUICtrlCreateLabel("custom_clicks.ini", 22, 472, 150, 20)
    GUICtrlSetColor(-1, $UI_MUTED)
    GUICtrlSetTip(-1, $SCUSTOMINI)
    UI_BUTTON("Tải lại từ tệp", 182, 462, 114, 32, "CUSTOM_LOADUI")
    UI_BUTTON("Đóng", 592, 462, 82, 32, "CUSTOM_FORMCLOSE")
    UI_BUTTON("Lưu quy tắc", 682, 462, 120, 32, "CUSTOM_SAVE", True)

    CUSTOM_LOADUI()
    GUISetState(@SW_SHOW, $HCUSTOMFORM)
EndFunc

Func CUSTOM_FORMCLOSE()
	If $HCUSTOMFORM <> 0 Then
		GUIDelete($HCUSTOMFORM)
		$HCUSTOMFORM = 0
	EndIf
EndFunc

Func CUSTOM_PICK1()
	Local $s = CUSTOM_PICK(True)
	If $s <> "" Then GUICtrlSetData($IP1, $s)
EndFunc
Func CUSTOM_PICK2()
	Local $s = CUSTOM_PICK(True)
	If $s <> "" Then GUICtrlSetData($IP2, $s)
EndFunc
Func CUSTOM_PICK3()
	Local $s = CUSTOM_PICK(True)
	If $s <> "" Then GUICtrlSetData($IP3, $s)
EndFunc
Func CUSTOM_PICKCLICK()
	Local $s = CUSTOM_PICK(False)
	If $s <> "" Then GUICtrlSetData($IPCLICK, $s)
EndFunc

Func CUSTOM_ADD()
	Local $c1 = StringStripWS(GUICtrlRead($IP1), 3)
	Local $c2 = StringStripWS(GUICtrlRead($IP2), 3)
	Local $c3 = StringStripWS(GUICtrlRead($IP3), 3)
	Local $ck = StringStripWS(GUICtrlRead($IPCLICK), 3)
	Local $dl = StringStripWS(GUICtrlRead($IPDELAY), 3)
	Local $nt = StringStripWS(GUICtrlRead($IPNOTE), 3)

	If $c1 = "" And $c2 = "" And $c3 = "" Then
		MsgBox(48 + 262144, "Thiếu điều kiện màu", "Hãy nhập hoặc lấy ít nhất một điểm màu cho quy tắc.", 0, $HCUSTOMFORM)
		Return
	EndIf
	If $ck = "" Then
		MsgBox(48 + 262144, "Thiếu vị trí bấm", "Hãy nhập hoặc lấy vị trí cần bấm.", 0, $HCUSTOMFORM)
		Return
	EndIf
	If Number($dl) <= 0 Then $dl = "200"

	Local $sCur = GUICtrlRead($ECUSTOMLIST)
	If StringStripWS($sCur, 3) <> "" And StringRight($sCur, 2) <> @CRLF Then $sCur &= @CRLF
	GUICtrlSetData($ECUSTOMLIST, $sCur & $c1 & "|" & $c2 & "|" & $c3 & "|" & $ck & "|" & $dl & "|" & $nt & @CRLF)

	GUICtrlSetData($IP1, "")
	GUICtrlSetData($IP2, "")
	GUICtrlSetData($IP3, "")
	GUICtrlSetData($IPCLICK, "")
	GUICtrlSetData($IPNOTE, "")
EndFunc

Func CUSTOM_SAVE()
	Local $sTxt = GUICtrlRead($ECUSTOMLIST)
	Local $aL = StringSplit(StringStripCR($sTxt), @LF)
	IniDelete($SCUSTOMINI, "CustomClicks")
	Local $n = 0
	For $i = 1 To $aL[0]
		Local $sL = StringStripWS($aL[$i], 3)
		If $sL <> "" And StringInStr($sL, "|") Then
			$n += 1
			IniWrite($SCUSTOMINI, "CustomClicks", String($n), $sL)
		EndIf
	Next
	IniWrite($SCUSTOMINI, "Config", "Total", String($n))
	IniWrite($SCUSTOMINI, "Config", "Enabled", "1")
	CUSTOM_RELOAD()
	MsgBox(64 + 262144, "Đã lưu", "Đã lưu " & $n & " quy tắc vào tệp" & @CRLF & $SCUSTOMINI, 0, $HCUSTOMFORM)
EndFunc

Func CUSTOM_LOADUI()
	CUSTOM_RELOAD()
	Local $s = ""
	For $i = 1 To $ICUSTOMCOUNT
		$s &= $ACUSTOM[$i][0] & "|" & $ACUSTOM[$i][1] & "|" & $ACUSTOM[$i][2] & "|" & _
			  $ACUSTOM[$i][3] & "|" & $ACUSTOM[$i][4] & "|" & $ACUSTOM[$i][5] & @CRLF
	Next
	GUICtrlSetData($ECUSTOMLIST, $s)
EndFunc


; =============================================================================
;  MODE EDITOR  (2026-09-28)
;  Danh sach che do + option + buoc auto, luu trong auto_modes.ini (UTF-16).
;
;  [M<id>]  Name=  Builtin=0..9 (0 = tu tao, 1..9 = noi vao code goc = $IMODE)
;           Hidden=0/1   Order=<thu tu hien>
;  [O<id>]  Mode=<id che do>  Name=  Enabled=0/1
;           Type=loop|seq|finish   GoHome=0/1   Timeout=<ms>
;           Steps=N   S1..SN = diem1|diem2|diem3|hanh dong|cho(ms)|ghi chu
;              diem     : "x,y,0xRRGGBB" (toa do tuong doi cua so game), de trong duoc
;              hanh dong: "x,y" = click | WAIT = chi cho mau | HOME = ve man hinh chinh
;                         | STOP = dung auto
;  [LastMode]  <ten cua so MEmu>=<id che do>   -> nho che do rieng cho tung MEmu
;
;  Kieu option:
;    loop   : moi vong quet, buoc nao du mau thi lam (giong Custom Click)
;    seq    : thay mau buoc 1 -> chay lan luot tung buoc, moi buoc cho du mau
;             toi da Timeout, qua han thi dung chuoi (khong click mu)
;    finish : chay nhu seq khi che do goc het luot (ngay truoc khi auto dung)
;  Che do goc khong xoa duoc, chi an (Hidden=1).
; =============================================================================

; ---------------------------------------------------------------- du lieu ---
Func AM_ENSUREINI()
	If Not FileExists($SAMINI) Then
		Local $h = FileOpen($SAMINI, 2 + 32)      ; UTF-16 LE co BOM -> luu duoc ten tieng Viet
		If $h = -1 Then Return
		FileWrite($h, "; Che do auto - sua bang nut [Mode Editor], khong can sua tay" & @CRLF)
		FileClose($h)
	EndIf
	; dam bao du 9 che do goc, theo thu tu cac nut radio cu
	Local $aDef[9][2] = [[4, "Events"], [6, "League"], [5, "Story"], [7, "Raid"], [3, "World Challenge"], _
		[9, "Daily/Evolve"], [1, "Cup Champion"], [8, "Rank Match"], [2, "Training / FPTransfer"]]
	Local $bNew = False
	For $i = 0 To 8
		If AM_FINDBUILTIN($aDef[$i][0]) = 0 Then
			Local $id = AM_NEWID("M")
			IniWriteSection($SAMINI, "M" & $id, "Name=" & $aDef[$i][1] & @LF & "Builtin=" & $aDef[$i][0] & @LF & _
				"Hidden=0" & @LF & "Order=" & (AM_MAXORDER() + 1))
			$bNew = True
		EndIf
	Next
	; muc dac biet "Ve man hinh chinh" (Builtin=-1): nut Back/Home cac man hinh + diem nhan ra man hinh chinh.
	; Chi hien trong Mode Editor, khong hien o danh sach che do.
	If AM_FINDBUILTIN(-1) = 0 Then
		Local $idH = AM_NEWID("M")
		IniWriteSection($SAMINI, "M" & $idH, "Name=★ Về màn hình chính" & @LF & "Builtin=-1" & @LF & "Hidden=0" & @LF & "Order=0")
		; mau nut Home o Exchange Shop (do tren may JP 28/09)
		IniWriteSection($SAMINI, "O" & AM_NEWID("O"), "Mode=" & $idH & @LF & "Name=Nút Home/Back + nhận màn hình chính" & @LF & _
			"Enabled=1" & @LF & "Type=loop" & @LF & "GoHome=0" & @LF & "BlockCustom=0" & @LF & "Steps=1" & @LF & _
			"S1=60,45,0xFDE264|175,410,0xE6721A|160,410,0x5F2907|190,413|300|Nút Home trong Exchange Shop")
	EndIf
	; option mau: mua ve skip khi Daily/Evolve het luot (tat san, chua co buoc)
	If $bNew Then
		Local $aO = AM_IDS("O")
		If $aO[0] = 0 Then
			IniWriteSection($SAMINI, "O1", "Mode=" & AM_FINDBUILTIN(9) & @LF & "Name=Mua vé skip khi hết lượt" & @LF & _
				"Enabled=0" & @LF & "Type=finish" & @LF & "GoHome=1" & @LF & "Steps=0")
		EndIf
	EndIf
EndFunc

; id cua cac section "<prefix><so>" tang dan; $sKey/$sVal: chi lay section co key = gia tri
Func AM_IDS($sPrefix, $sKey = "", $sVal = "")
	Local $aRet[1] = [0]
	Local $aN = IniReadSectionNames($SAMINI)
	If @error Then Return $aRet
	For $i = 1 To $aN[0]
		If StringLeft($aN[$i], 1) <> $sPrefix Then ContinueLoop
		Local $sNum = StringMid($aN[$i], 2)
		If $sNum = "" Or Not StringIsDigit($sNum) Then ContinueLoop
		If $sKey <> "" And IniRead($SAMINI, $aN[$i], $sKey, "") <> $sVal Then ContinueLoop
		Local $n = Number($sNum)
		$aRet[0] += 1
		ReDim $aRet[$aRet[0] + 1]
		Local $j = $aRet[0]
		While $j > 1 And $aRet[$j - 1] > $n
			$aRet[$j] = $aRet[$j - 1]
			$j -= 1
		WEnd
		$aRet[$j] = $n
	Next
	Return $aRet
EndFunc

Func AM_NEWID($sPrefix)
	Local $a = AM_IDS($sPrefix)
	If $a[0] = 0 Then Return 1
	Return $a[$a[0]] + 1
EndFunc

Func AM_FINDBUILTIN($iB)
	Local $a = AM_IDS("M")
	For $i = 1 To $a[0]
		If Number(IniRead($SAMINI, "M" & $a[$i], "Builtin", "0")) = $iB Then Return $a[$i]
	Next
	Return 0
EndFunc

Func AM_MAXORDER()
	Local $a = AM_IDS("M"), $iMax = 0
	For $i = 1 To $a[0]
		Local $o = Number(IniRead($SAMINI, "M" & $a[$i], "Order", "0"))
		If $o > $iMax Then $iMax = $o
	Next
	Return $iMax
EndFunc

; danh sach id che do theo Order (tuy chon bo che do an)
Func AM_MODES($bVisibleOnly)
	Local $a = AM_IDS("M")
	Local $aRet[1] = [0], $aOrd[1] = [0]
	For $i = 1 To $a[0]
		If $bVisibleOnly And IniRead($SAMINI, "M" & $a[$i], "Hidden", "0") = "1" Then ContinueLoop
		If $bVisibleOnly And Number(IniRead($SAMINI, "M" & $a[$i], "Builtin", "0")) < 0 Then ContinueLoop   ; muc "Ve man hinh chinh"
		Local $o = Number(IniRead($SAMINI, "M" & $a[$i], "Order", $a[$i]))
		$aRet[0] += 1
		ReDim $aRet[$aRet[0] + 1]
		ReDim $aOrd[$aRet[0] + 1]
		Local $j = $aRet[0]
		While $j > 1 And $aOrd[$j - 1] > $o
			$aRet[$j] = $aRet[$j - 1]
			$aOrd[$j] = $aOrd[$j - 1]
			$j -= 1
		WEnd
		$aRet[$j] = $a[$i]
		$aOrd[$j] = $o
	Next
	Return $aRet
EndFunc

; gia tri $IMODE cua 1 che do: 1..9 = che do goc, 100+id = che do tu tao
Func AM_MODEVALUE($iMode)
	If $iMode = 0 Then Return 9
	Local $s = IniRead($SAMINI, "M" & $iMode, "Builtin", "")
	If $s = "" Then Return 9
	If Number($s) = 0 Then Return 100 + $iMode
	Return Number($s)
EndFunc

Func AM_MODELABEL($iMode)
	Local $s = IniRead($SAMINI, "M" & $iMode, "Name", "?")
	If Number(IniRead($SAMINI, "M" & $iMode, "Builtin", "0")) = 0 Then $s = "+ " & $s
	Return $s
EndFunc

Func AM_GETSTEPS($iOpt)
	Local $sSec = "O" & $iOpt
	Local $n = Number(IniRead($SAMINI, $sSec, "Steps", "0"))
	If $n < 0 Then $n = 0
	Local $a[$n + 1]
	$a[0] = $n
	For $i = 1 To $n
		$a[$i] = IniRead($SAMINI, $sSec, "S" & $i, "")
	Next
	Return $a
EndFunc

Func AM_SAVESTEPS($iOpt, $aS)
	Local $sSec = "O" & $iOpt
	Local $s = "Mode=" & IniRead($SAMINI, $sSec, "Mode", "0") & @LF & _
		"Name=" & IniRead($SAMINI, $sSec, "Name", "") & @LF & _
		"Enabled=" & IniRead($SAMINI, $sSec, "Enabled", "1") & @LF & _
		"Type=" & AM_TYPENAME(AM_TYPEIDX(IniRead($SAMINI, $sSec, "Type", "loop"))) & @LF & _
		"GoHome=" & IniRead($SAMINI, $sSec, "GoHome", "0") & @LF & _
		"BlockCustom=" & (AM_OPTBLOCK($iOpt) ? "1" : "0") & @LF & _
		"Steps=" & $aS[0]
	For $i = 1 To $aS[0]
		$s &= @LF & "S" & $i & "=" & $aS[$i]
	Next
	IniWriteSection($SAMINI, $sSec, $s)
	AMED_TOUCH()
EndFunc

; Tam dung Custom Click khi chay option nay? Chua dat thi: kieu "het luot" = co, "luon quet" = khong
Func AM_OPTBLOCK($iOpt)
	Local $s = IniRead($SAMINI, "O" & $iOpt, "BlockCustom", "")
	If $s = "" Then Return (IniRead($SAMINI, "O" & $iOpt, "Type", "loop") = "finish")
	Return ($s = "1")
EndFunc

; 2 kieu: 0 = loop (luon quet khi chay che do), 1 = finish (khi che do goc het luot).
; "seq" cu coi nhu loop.
Func AM_TYPEIDX($s)
	If $s = "finish" Then Return 1
	Return 0
EndFunc

Func AM_TYPENAME($i)
	If $i = 1 Then Return "finish"
	Return "loop"
EndFunc

; ------------------------------------------------- danh sach o man hinh chinh ---
Func AM_FILLMAINLIST($iSelMode = 0)
	If $iSelMode = 0 Then $iSelMode = $AMCURMODE
	$AMMAINIDS = AM_MODES(True)
	GUICtrlSendMsg($LAMMODE, 0x184, 0, 0)                 ; LB_RESETCONTENT
	Local $s = "", $iIdx = -1
	For $i = 1 To $AMMAINIDS[0]
		$s &= "|" & AM_MODELABEL($AMMAINIDS[$i])
		If $AMMAINIDS[$i] = $iSelMode Then $iIdx = $i - 1
	Next
	If $s <> "" Then GUICtrlSetData($LAMMODE, StringTrimLeft($s, 1))
	UI_LIST_WIDTH($LAMMODE, $s)
	; che do cu bi an/xoa -> ve Daily/Evolve (mac dinh cu)
	If $iIdx = -1 Then
		Local $iDef = AM_FINDBUILTIN(9)
		For $i = 1 To $AMMAINIDS[0]
			If $AMMAINIDS[$i] = $iDef Then $iIdx = $i - 1
		Next
	EndIf
	If $iIdx = -1 And $AMMAINIDS[0] > 0 Then $iIdx = 0
	If $iIdx >= 0 Then
		GUICtrlSendMsg($LAMMODE, 0x186, $iIdx, 0)         ; LB_SETCURSEL
		$AMCURMODE = $AMMAINIDS[$iIdx + 1]
	Else
		$AMCURMODE = 0
	EndIf
	UI_MODE_CAPTION()
EndFunc

; bam chon che do tren danh sach
Func AM_MAINSELCLICK()
	Local $iIdx = GUICtrlSendMsg($LAMMODE, 0x188, 0, 0)  ; LB_GETCURSEL
	If $iIdx < 0 Or $iIdx >= $AMMAINIDS[0] Then Return
	Local $iNew = $AMMAINIDS[$iIdx + 1]
	If $iNew = $AMCURMODE Then Return
	$AMCURMODE = $iNew
	UI_MODE_CAPTION()
	AM_APPLYMODE(True)
EndFunc

; ap dung che do $AMCURMODE: giu hanh vi cua nut radio cu (tick san Farming Mode...).
; $bUser = False (tu chuyen khi chay lan luot): khong hien bang huong dan Training
Func AM_APPLYMODE($bUser)
	Switch AM_MODEVALUE($AMCURMODE)
		Case 1
			DMISSCLICK()
		Case 2
			If $bUser Then
				TRAINSSRCLICK()
			Else
				GUICtrlSetState($CAYEVEN2, $GUI_CHECKED)
				RELOADMODE()
			EndIf
		Case 3
			WCHALLCLICK()
		Case 4
			EVENCLICK()
		Case 5
			STORYCLICK()
		Case 6
			LEAGUE()
		Case 7
			RAIDCLICK()
		Case 8
			RANKCLICK()
		Case 9
			EVOLVECLICK()
		Case Else
			RELOADMODE()
	EndSwitch
EndFunc

; Mo Auto luon chon san Daily/Evolve (khong nho che do lan truoc theo MEmu nua)

; ------------------------------------------------------------- luc chay ---
;  Moi option = 1 bo quy tac giong Custom Click: quet lien tuc, buoc nao khop mau thi lam.
;  KHONG co thoi gian cho / het gio: game lag thi chua khop -> chua bam; bam hut thi man
;  hinh chua doi -> van khop -> bam tiep; mua lap thi con mon -> con khop -> mua tiep.
;  Kieu "finish" (che do goc het luot): quet toi khi gap buoc "Click roi xong" (END:x,y)
;  hoac "Dung auto", hoac bam Stop.
Func AM_RTRELOAD()
	$AMRTCOUNT = 0
	ReDim $AMRT[1][8]
	$AMRTTIME = "-"
	If Not FileExists($SAMINI) Then Return
	$AMRTTIME = FileGetTime($SAMINI, 0, 1)
	$AMLOGON = (IniRead($SAMINI, "Config", "Log", "0") = "1")
	Local $aO = AM_IDS("O", "Enabled", "1")
	For $i = 1 To $aO[0]
		Local $sSec = "O" & $aO[$i]
		Local $iM = Number(IniRead($SAMINI, $sSec, "Mode", "0"))
		If IniRead($SAMINI, "M" & $iM, "Builtin", "") = "" Then ContinueLoop   ; che do da bi xoa
		$AMRTCOUNT += 1
		ReDim $AMRT[$AMRTCOUNT + 1][8]
		$AMRT[$AMRTCOUNT][0] = $aO[$i]
		$AMRT[$AMRTCOUNT][1] = AM_MODEVALUE($iM)
		$AMRT[$AMRTCOUNT][2] = AM_TYPENAME(AM_TYPEIDX(IniRead($SAMINI, $sSec, "Type", "loop")))
		$AMRT[$AMRTCOUNT][3] = (IniRead($SAMINI, $sSec, "GoHome", "0") = "1")
		$AMRT[$AMRTCOUNT][4] = 0                     ; buoc vua lam (de ghi log khi doi buoc)
		$AMRT[$AMRTCOUNT][5] = AM_GETSTEPS($aO[$i])
		$AMRT[$AMRTCOUNT][6] = IniRead($SAMINI, $sSec, "Name", "")
		$AMRT[$AMRTCOUNT][7] = AM_OPTBLOCK($aO[$i])
	Next
EndFunc

; doc lai khi file doi (Mode Editor, hoac Auto khac dung chung file)
Func AM_RTCHECK()
	Local $sT = "-"
	If FileExists($SAMINI) Then $sT = FileGetTime($SAMINI, 0, 1)
	If $AMRTTIME = "" Or $sT <> $AMRTTIME Then AM_RTRELOAD()
EndFunc

; goi moi vong lap chinh: moi option "luon quet" cua che do dang chay quet 1 luot
Func AM_RUNFORMODE($iMode)
	If Not $BRUN Then Return
	AM_RTCHECK()
	Local $n = $AMRTCOUNT
	For $k = 1 To $n
		If Not $BRUN Then Return
		If $k > $AMRTCOUNT Then Return
		If $IMODE <> $iMode Then Return        ; vua chuyen che do (chay lan luot)
		; muc ★ Ve man hinh chinh (-1) chay kem MOI che do: dang lac o shop... thi tu bam Home ve
		If ($AMRT[$k][1] <> $iMode And $AMRT[$k][1] <> -1) Or $AMRT[$k][2] = "finish" Then ContinueLoop
		Local $aS = $AMRT[$k][5]
		If $aS[0] < 1 Then ContinueLoop
		Local $iLast = $AMRT[$k][4]
		AM_RULEPASS($aS, $AMRT[$k][6], 1, $aS[0], $iLast)
		If $k <= $AMRTCOUNT Then $AMRT[$k][4] = $iLast
	Next
EndFunc

; goi o cho che do goc het luot, truoc khi auto dung
Func AM_ONFINISH($iMode)
	AM_RTCHECK()
	Local $n = $AMRTCOUNT
	For $k = 1 To $n
		If Not AM_ISRUN() Then Return
		If $k > $AMRTCOUNT Then Return
		If $AMRT[$k][2] <> "finish" Or $AMRT[$k][1] <> $iMode Then ContinueLoop
		Local $aS = $AMRT[$k][5]
		If $aS[0] < 1 Then ContinueLoop
		$AMINFINISH = True            ; "Dung auto" trong luc nay: che do goc tu chuyen hang cho, khong chuyen 2 lan
		AM_RULESRUN($aS, $AMRT[$k][3], $AMRT[$k][6], 1, 0, $AMRT[$k][7])
		$AMINFINISH = False
	Next
EndFunc

; quet lien tuc toi khi gap "Click roi xong" / "Dung auto" / bi dung
; $bBlock: tam dung Custom Click trong luc chay (tranh rule Custom bam nham, vd mua het shop)
Func AM_RULESRUN($aS, $bHome, $sName, $iFrom = 1, $iTo = 0, $bBlock = False)
	If Not $bBlock Then Return AM_RULESRUN2($aS, $bHome, $sName, $iFrom, $iTo)
	Local $bOld = $BCUSTOMBUSY
	$BCUSTOMBUSY = True
	Local $bOk = AM_RULESRUN2($aS, $bHome, $sName, $iFrom, $iTo)
	$BCUSTOMBUSY = $bOld
	Return $bOk
EndFunc

Func AM_RULESRUN2($aS, $bHome, $sName, $iFrom, $iTo)
	If $iFrom < 1 Or $iFrom > $aS[0] Then $iFrom = 1
	If $iTo < $iFrom Or $iTo > $aS[0] Then $iTo = $aS[0]
	If $iFrom > 1 Then $bHome = False
	AM_LOG($sName & ": bat dau quet buoc " & $iFrom & " -> " & $iTo)
	If $bHome Then
		AM_STATUS($sName & ": về màn hình chính...")
		If Not AM_GOHOME(120000) Then
			If AM_ISRUN() Then
				AM_STATUS($sName & ": không về được màn hình chính - dừng")
				AM_LOG($sName & ": KHONG ve duoc man hinh chinh")
			EndIf
			Return False
		EndIf
		Sleep(800)
	EndIf
	; Quet toi khi gap buoc "Click roi xong" / "Ve man hinh chinh" / "Dung auto" (hoac bam Stop).
	; (Bo kiem tra "quay ve man hinh chinh = xong": tung nhan nham luc dang o shop -> dung giua chung.)
	Local $iLast = 0
	While AM_ISRUN()
		Switch AM_RULEPASS($aS, $sName, $iFrom, $iTo, $iLast)
			Case 2
				AM_STATUS($sName & ": xong")
				AM_LOG($sName & ": XONG")
				Return True
			Case 3
				Return True
		EndSwitch
		Sleep(250)
	WEnd
	AM_LOG($sName & ": dung tay")
	Return False
EndFunc

; 1 luot quet: gap buoc khop dau tien thi lam roi tra ve (luot sau quet lai tu dau).
; Tra ve 0 = khong buoc nao khop, 1 = da lam, 2 = "Click roi xong", 3 = "Dung auto"/bi dung
Func AM_RULEPASS($aS, $sName, $iFrom, $iTo, ByRef $iLast)
	For $i = $iFrom To $iTo
		If Not AM_ISRUN() Then Return 3
		Local $a = AM_PARSESTEP($aS[$i])
		If Not AM_HASCOND($a) Then ContinueLoop       ; khong co diem mau = khong bam mu
		If Not AM_CONDSOK($a) Then ContinueLoop
		Local $sAct = StringUpper($a[3])
		If $sAct = "" Or $sAct = "WAIT" Or $sAct = "HOMEOK" Then ContinueLoop   ; HOMEOK chi de nhan man hinh chinh
		AM_STATUS($sName & " - bước " & $i & ": " & AM_STEPLABEL($a))
		If $i <> $iLast Then AM_LOG($sName & " buoc " & $i & " (" & AM_STEPLABEL($a) & ") -> " & AM_ACTTEXT($a[3]))
		$iLast = $i
		If StringLeft($sAct, 4) = "END:" Then
			CUSTOM_CLICKAT(StringMid($a[3], 5))
			Sleep(300)
			Return 2
		EndIf
		AM_ACTION($sAct)
		If $sAct = "STOP" Then Return 3
		If $sAct = "HOME" Then Return 2        ; "Ve man hinh chinh" = ve xong la xong option
		Sleep(300)
		Return 1
	Next
	Return 0
EndFunc

Func AM_ISRUN()
	If $AMTESTING Then
		If _IsPressed("1B") Then $AMTESTING = False      ; ESC dang giu = dung chay thu
		Return $AMTESTING
	EndIf
	Return $BRUN
EndFunc

; Nut "Dung" cua Mode Editor: bat qua WM_COMMAND nen chay NGAY ca khi dang o trong
; AMED_TESTRUN (su kien OnEvent thuong phai xep hang cho chay thu xong).
Func AM_WMCOMMAND($hWnd, $iMsg, $wParam, $lParam)
	If $AMTESTING And $AMBSTOPTEST <> 0 And BitAND($wParam, 0xFFFF) = $AMBSTOPTEST And BitShift($wParam, 16) = 0 Then
		$AMTESTING = False
	EndIf
	Return $GUI_RUNDEFMSG
EndFunc

; ESC luc chay thu (HotKey chen ngang duoc ham dang chay, khong can giu phim)
Func AM_TESTESC()
	$AMTESTING = False
EndFunc

; buoc: diem1|diem2|diem3|hanh dong|(khong dung)|ghi chu
;   hanh dong: "x,y" click | "END:x,y" click roi xong | HOME | STOP
Func AM_PARSESTEP($s)
	Local $a[6] = ["", "", "", "", 300, ""]
	Local $aP = StringSplit($s, "|", 2)
	For $i = 0 To 5
		If $i < UBound($aP) Then $a[$i] = StringStripWS($aP[$i], 3)
	Next
	Return $a
EndFunc

Func AM_HASCOND($a)
	Return ($a[0] <> "" Or $a[1] <> "" Or $a[2] <> "")
EndFunc

Func AM_CONDSOK($a)
	If Not CUSTOM_CONDOK($a[0]) Then Return False
	If Not CUSTOM_CONDOK($a[1]) Then Return False
	Return CUSTOM_CONDOK($a[2])
EndFunc

Func AM_ACTTEXT($sAct)
	If StringUpper(StringLeft($sAct, 4)) = "END:" Then Return "Click " & StringMid($sAct, 5) & " rồi xong"
	Switch StringUpper($sAct)
		Case "HOME"
			Return "Về màn hình chính"
		Case "STOP"
			Return "Dừng auto"
		Case "HOMEOK"
			Return "Đây là màn hình chính"
		Case "", "WAIT"
			Return "(chưa có hành động)"
	EndSwitch
	Return "Click " & $sAct
EndFunc

Func AM_STEPLABEL($a)
	If $a[5] <> "" Then Return $a[5]
	Return AM_ACTTEXT($a[3])
EndFunc

Func AM_ACTION($sAct)
	Switch StringUpper($sAct)
		Case "HOME"
			If Not $AMINGOHOME Then AM_GOHOME(120000)    ; tranh goi long nhau tu muc "Ve man hinh chinh"
		Case "STOP"
			AM_STOPAUTO()
		Case "", "WAIT", "HOMEOK"
		Case Else
			CUSTOM_CLICKAT($sAct)
	EndSwitch
EndFunc

; co buoc "Day la man hinh chinh" (muc ★ Ve man hinh chinh) nao dang khop khong
Func AM_ISHOMEUSER()
	AM_RTCHECK()
	For $k = 1 To $AMRTCOUNT
		If $AMRT[$k][1] <> -1 Then ContinueLoop
		Local $aS = $AMRT[$k][5]
		For $i = 1 To $aS[0]
			Local $a = AM_PARSESTEP($aS[$i])
			If StringUpper($a[3]) <> "HOMEOK" Or Not AM_HASCOND($a) Then ContinueLoop
			If AM_CONDSOK($a) Then Return True
		Next
	Next
	Return False
EndFunc

; 1 luot bam cac nut Back/Home nguoi dung ghi trong muc ★ Ve man hinh chinh
Func AM_HOMEPASS()
	For $k = 1 To $AMRTCOUNT
		If $AMRT[$k][1] <> -1 Then ContinueLoop
		Local $aS = $AMRT[$k][5], $iLast = $AMRT[$k][4]
		If $aS[0] < 1 Then ContinueLoop
		Local $r = AM_RULEPASS($aS, $AMRT[$k][6], 1, $aS[0], $iLast)
		$AMRT[$k][4] = $iLast
		If $r > 0 Then Return True
	Next
	Return False
EndFunc

; log luon ghi (khong phu thuoc o Log), file > 1MB thi lam moi
; Chi ghi khi Chay thu option (Mode Editor). Chay that khong ghi cho nhe may;
; muon ghi ca luc chay that: auto_modes.ini [Config] Log=1
Func AM_LOG($s)
	If Not ($AMTESTING Or $AMLOGON) Then Return
	Local $sFile = @ScriptDir & "\auto_modes_log.txt"
	If FileGetSize($sFile) > 1048576 Then FileDelete($sFile)
	Local $h = FileOpen($sFile, 1 + 128)      ; append, UTF-8
	If $h = -1 Then Return
	FileWriteLine($h, @YEAR & "-" & @MON & "-" & @MDAY & " " & @HOUR & ":" & @MIN & ":" & @SEC & " [" & $STEXT & "] " & $s)
	FileClose($h)
EndFunc

; thoat ve man hinh chinh: bam cac nut Back (chi bam khi dung mau) + xu ly popup
; Uu tien nut Back/Home + diem nhan man hinh chinh ghi trong muc "★ Ve man hinh chinh" (Mode Editor).
Func AM_GOHOME($iMaxMs)
	$AMINGOHOME = True
	Local $bOk = AM_GOHOME2($iMaxMs)
	$AMINGOHOME = False
	If Not $bOk And AM_ISRUN() Then AM_LOG("Ve man hinh chinh: KHONG ve duoc (ghi them nut Home/Back va diem 'Day la man hinh chinh' trong muc ★ Ve man hinh chinh)")
	Return $bOk
EndFunc

; moc "khong ve duoc man chinh -> thu Back / tat mo lai game": 90s, nhung khong qua ($iMaxMs - 15s)
Func AM_RESTARTMS($iMaxMs)
	If $iMaxMs - 15000 < 90000 Then Return $iMaxMs - 15000
	Return 90000
EndFunc
Func AM_GOHOME2($iMaxMs)
	Local $hT = TimerInit(), $bClicked = False, $hIdle = TimerInit(), $bRestarted = False
	While TimerDiff($hT) < $iMaxMs
		If Not AM_ISRUN() Then Return False
		If ISHOMESCREEN() Then Return True
		AM_STATUS("Về màn hình chính...")
		If AM_HOMEPASS() Then
			$bClicked = True
			$hIdle = TimerInit()
		Else
			; da bam nut Home/Back cua muc ★ roi ma 5s khong con nut nao khop -> coi nhu da ve
			; (may chua ghi diem "Day la man hinh chinh" thi khong nhan ra duoc)
			If $bClicked And TimerDiff($hIdle) > 5000 Then
				AM_LOG("Ve man hinh chinh: da bam Home, 5s khong con nut nao khop -> coi nhu da ve")
				Return True
			EndIf
			; nut Back/Home cam goc trai duoi (Story, Daily, Shop, Exchange Shop, Transfers...) -> bam Home
			If HOMEBTN() Then
				SENDCLICK(155 + $APOS[0], 413 + $APOS[1], $APOS)
				$bClicked = True
				$hIdle = TimerInit()
				Sleep(2000)
				ContinueLoop
			EndIf
			If ISGAMEERROR() Then GAMEERRRESTART()
			; 30s van khong ve duoc man chinh, khong thay nut Home nao (vd quang cao choi thu ket trong tab game)
			; -> tat het tab, mo lai game (1 lan), tinh lai thoi gian cho
			If Not $bRestarted And Not $bClicked And TimerDiff($hT) > AM_RESTARTMS($iMaxMs) Then      ; 18/11: 30s -> 90s; 19/11: AM_GOHOME(60000) -> 45s
				If Not AD_BACKOUT() Then GAMEERRRESTART("Không về được màn chính")      ; 19/11: thu Back Android truoc (ket trang cuoi quang cao)
				$bRestarted = True
				$hT = TimerInit()
				ContinueLoop
			EndIf
			; ham ve man hinh chinh goc cua auto: man "Touch Screen to Start", popup dang nhap, bang thong bao...
			GOTOHOME()
			CLICKPIXEL(29, 414, 14575636, $APOS)
			CLICKPIXEL(24, 414, 6236423, $APOS)
			CLICKPIXEL(23, 413, 6236423, $APOS)
			CLICKPIXEL(15, 409, 6236423, $APOS)
			DIALOGHANDLING()
		EndIf
		Sleep(1000)
	WEnd
	If Not ISHOMESCREEN() Then AUTOLOG("Ve man hinh chinh: KHONG ve duoc sau " & Int($iMaxMs / 1000) & "s")
	Return ISHOMESCREEN()
EndFunc

Func AM_STOPAUTO()
	$AMTESTING = False
	If Not $BRUN Then Return
	$BRUN = False
	_GUICtrlStatusBar_SetText($SSTATUS, "Sẵn sàng", 1, 0)
	UI_RUN_BUTTON(False)
	; buoc "Dung auto" = xong che do nay -> chay lan luot thi sang che do ke
	; (trong luc chay option "het luot" thi che do goc tu goi AM_QUEUENEXT, khong goi o day)
	If Not $AMINFINISH Then AM_QUEUENEXT()
EndFunc

; =============================================================================
;  CHAY LAN LUOT: nhieu che do theo thu tu, luu rieng tung MEmu
;    [Queue]    <ten cua so MEmu>=id,id,id
;    [QueueOn]  <ten cua so MEmu>=1
;  Che do xong (het luot / buoc "Dung auto") -> sang che do ke. Het danh sach -> dung,
;  chon lai che do dau de lan Start sau chay tu dau.
; =============================================================================
Func AM_QKEY()
	If $STEXT = "" Then Return "_mac_dinh"
	Return $STEXT
EndFunc

Func AM_QON()
	Return (IniRead($SAMINI, "QueueOn", AM_QKEY(), "0") = "1")
EndFunc

; id cac che do trong hang (bo che do da xoa / dang an / muc ★)
Func AM_QGET()
	Local $aRet[1] = [0]
	Local $s = IniRead($SAMINI, "Queue", AM_QKEY(), "")
	If $s = "" Then Return $aRet
	Local $a = StringSplit($s, ",")
	For $i = 1 To $a[0]
		Local $id = Number($a[$i])
		If $id <= 0 Then ContinueLoop
		Local $sB = IniRead($SAMINI, "M" & $id, "Builtin", "")
		If $sB = "" Or Number($sB) < 0 Then ContinueLoop
		If IniRead($SAMINI, "M" & $id, "Hidden", "0") = "1" Then ContinueLoop
		$aRet[0] += 1
		ReDim $aRet[$aRet[0] + 1]
		$aRet[$aRet[0]] = $id
	Next
	Return $aRet
EndFunc

Func AM_QSET($a)
	Local $s = ""
	For $i = 1 To $a[0]
		$s &= "," & $a[$i]
	Next
	IniWrite($SAMINI, "Queue", AM_QKEY(), StringTrimLeft($s, 1))
	AMED_TOUCH()
EndFunc

; chon che do (khong hien bang huong dan Training)
Func AM_SWITCHMODE($iMode)
	AM_FILLMAINLIST($iMode)
	AM_APPLYMODE(False)
EndFunc

; bam Start: bat chay lan luot ma che do dang chon khong nam trong hang -> bat dau tu che do dau
Func AM_QUEUESTART()
	If Not AM_QON() Then Return
	Local $a = AM_QGET()
	If $a[0] = 0 Then Return
	Local $iPos = 0
	For $i = 1 To $a[0]
		If $a[$i] = $AMCURMODE Then $iPos = $i
	Next
	If $iPos = 0 Then
		$iPos = 1
		AM_SWITCHMODE($a[1])
	EndIf
	AM_LOG("Lan luot: bat dau '" & IniRead($SAMINI, "M" & $a[$iPos], "Name", "") & "' (" & $iPos & "/" & $a[0] & ")")
EndFunc

; che do vua xong (auto vua dung) -> co che do ke thi chay tiep. Tra ve True neu da chay tiep.
Func AM_QUEUENEXT()
	If $pickedWindow Or Not UI_BINDING_VALID() Then Return False
	If Not AM_QON() Then Return False
	Local $a = AM_QGET()
	If $a[0] = 0 Then Return False
	Local $iPos = 0
	For $i = 1 To $a[0]
		If $a[$i] = $AMCURMODE Then $iPos = $i
	Next
	Local $sCur = IniRead($SAMINI, "M" & $AMCURMODE, "Name", "")
	If $iPos > 0 And $iPos < $a[0] Then
		Local $iNext = $a[$iPos + 1], $sNext = IniRead($SAMINI, "M" & $a[$iPos + 1], "Name", "")
		AM_LOG("Lan luot: xong '" & $sCur & "' -> chay '" & $sNext & "' (" & ($iPos + 1) & "/" & $a[0] & ")")
		AM_SWITCHMODE($iNext)
		; chay tiep nhu bam Start
		$BRUN = True
		$FREEZEGO = 0
		$ILASTSEC = -1
		$CNTTRANSFER = 0
		$CNTREFILL = 0
		$CNTSTORY = 0
		$CNTBALL = 0
		CUSTOM_RELOAD()
		AdlibRegister("PROCESS_CUSTOM_CLICKS", 250)
		_GUICtrlStatusBar_SetText($SSTATUS, "Đang chạy", 1, 0)
		_GUICtrlStatusBar_SetText($SSTATUS, "Lần lượt " & ($iPos + 1) & "/" & $a[0] & ": " & $sNext, 0, 0)
		UI_RUN_BUTTON(True)
		Return True
	EndIf
	AM_LOG("Lan luot: xong '" & $sCur & "' - het danh sach, dung")
	_GUICtrlStatusBar_SetText($SSTATUS, "Lần lượt: xong hết " & $a[0] & " chế độ", 0, 0)
	AM_SWITCHMODE($a[1])          ; lan Start sau chay lai tu dau
	Return False
EndFunc

; ---- cua so chon thu tu chay lan luot ----
Func AMQ_OPEN()
	AM_ENSUREINI()
	If $HAMQFORM <> 0 And WinExists($HAMQFORM) Then GUIDelete($HAMQFORM)
	Local $iLB = BitOR(0x0001, 0x0100, 0x00100000, 0x00200000, 0x00800000)
	Local $sProfile = ($STEXT = "") ? "Cấu hình mặc định" : "Giả lập  ·  " & $STEXT
	$HAMQFORM = GUICreate("Hàng đợi chế độ", 700, 476)
	GUISetOnEvent($GUI_EVENT_CLOSE, "AMQ_CLOSE", $HAMQFORM)
	GUISetFont(9, 400, 0, "Segoe UI", $HAMQFORM)
	GUISetBkColor($UI_BG, $HAMQFORM)
	UI_HEADER("Hàng đợi chế độ", $sProfile, 700)

	$AMQCHK = GUICtrlCreateCheckbox("Bật chạy lần lượt", 20, 80, 268, 26)
	GUICtrlSetState($AMQCHK, AM_QON() ? $GUI_CHECKED : $GUI_UNCHECKED)
	GUICtrlSetOnEvent($AMQCHK, "AMQ_ONCHK")

	UI_TITLE("Chế độ có sẵn", 20, 119, 260)
	$AMQLALL = GUICtrlCreateList("", 20, 146, 264, 188, $iLB)
	UI_TITLE("Thứ tự chạy", 416, 119, 264)
	$AMQLQ = GUICtrlCreateList("", 416, 146, 264, 188, $iLB)

	UI_BUTTON("Thêm →", 296, 151, 108, 33, "AMQ_ADD", True)
	UI_BUTTON("← Bỏ", 296, 190, 108, 33, "AMQ_DEL")
	UI_BUTTON("Đưa lên", 296, 249, 108, 33, "AMQ_UP")
	UI_BUTTON("Đưa xuống", 296, 288, 108, 33, "AMQ_DOWN")

	UI_TITLE("Khi nào chuyển chế độ?", 20, 348, 420)
	GUICtrlCreateLabel("Story, Daily/Evolve và World Challenge tự báo hoàn tất. Với Events, Raid hoặc League, hãy đặt chế độ ở cuối hàng đợi hoặc thêm bước “Dừng auto” khi hết lượt.", 20, 375, 660, 38)
	GUICtrlSetColor(-1, $UI_MUTED)
	UI_BUTTON("Đóng", 580, 428, 100, 32, "AMQ_CLOSE")
	AMQ_FILL(0)
	GUISetState(@SW_SHOW, $HAMQFORM)
EndFunc

Func AMQ_CLOSE()
	If $HAMQFORM <> 0 Then GUIDelete($HAMQFORM)
	$HAMQFORM = 0
EndFunc

Func AMQ_ONCHK()
	IniWrite($SAMINI, "QueueOn", AM_QKEY(), (BitAND(GUICtrlRead($AMQCHK), $GUI_CHECKED) = $GUI_CHECKED) ? "1" : "0")
	AMED_TOUCH()
EndFunc

Func AMQ_FILL($iSelQ)
	$AMQALL = AM_MODES(True)
	Local $s = ""
	For $i = 1 To $AMQALL[0]
		$s &= "|" & AM_MODELABEL($AMQALL[$i])
	Next
	AMED_LISTSET($AMQLALL, $s, -1)
	Local $a = AM_QGET()
	$s = ""
	For $i = 1 To $a[0]
		$s &= "|" & $i & ". " & AM_MODELABEL($a[$i])
	Next
	AMED_LISTSET($AMQLQ, $s, $iSelQ - 1)
EndFunc

Func AMQ_ADD()
	Local $iIdx = GUICtrlSendMsg($AMQLALL, 0x188, 0, 0)
	If $iIdx < 0 Or $iIdx >= $AMQALL[0] Then Return
	Local $id = $AMQALL[$iIdx + 1]
	Local $a = AM_QGET()
	For $i = 1 To $a[0]
		If $a[$i] = $id Then Return               ; da co trong hang
	Next
	$a[0] += 1
	ReDim $a[$a[0] + 1]
	$a[$a[0]] = $id
	AM_QSET($a)
	AMQ_FILL($a[0])
EndFunc

Func AMQ_DEL()
	Local $i = GUICtrlSendMsg($AMQLQ, 0x188, 0, 0) + 1
	Local $a = AM_QGET()
	If $i < 1 Or $i > $a[0] Then Return
	For $j = $i To $a[0] - 1
		$a[$j] = $a[$j + 1]
	Next
	$a[0] -= 1
	ReDim $a[$a[0] + 1]
	AM_QSET($a)
	AMQ_FILL(($i > $a[0]) ? $a[0] : $i)
EndFunc

Func AMQ_MOVE($iDir)
	Local $i = GUICtrlSendMsg($AMQLQ, 0x188, 0, 0) + 1
	Local $a = AM_QGET()
	Local $iTo = $i + $iDir
	If $i < 1 Or $i > $a[0] Or $iTo < 1 Or $iTo > $a[0] Then Return
	Local $t = $a[$i]
	$a[$i] = $a[$iTo]
	$a[$iTo] = $t
	AM_QSET($a)
	AMQ_FILL($iTo)
EndFunc

Func AMQ_UP()
	AMQ_MOVE(-1)
EndFunc

Func AMQ_DOWN()
	AMQ_MOVE(1)
EndFunc

Func AM_STATUS($s)
	_GUICtrlStatusBar_SetText($SSTATUS, $s, 0, 0)
	If $HAMFORM <> 0 And WinExists($HAMFORM) Then GUICtrlSetData($AMLBLINFO, $s)
EndFunc

