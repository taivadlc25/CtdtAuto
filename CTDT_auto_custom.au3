	If $BNOTIFY Then
		Local Const $WM_FONTCHANGE = 29
		Local Const $HWND_BROADCAST = 65535
		DllCall ( "user32.dll" , "none" , "SendMessage" , "hwnd" , $HWND_BROADCAST , "uint" , $WM_FONTCHANGE , "wparam" , 0 , "lparam" , 0 )
