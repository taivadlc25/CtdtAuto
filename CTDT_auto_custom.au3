	EndIf
	If GUICtrlRead ( $RHIDDEN ) = 1 Then
		$BHIDDEN = 1
	Else
		$BHIDDEN = 0
	EndIf
	If GUICtrlRead ( $RNEXT ) = 1 Then
		$BNEXT = 1
	Else
		$BNEXT = 0
	EndIf
	If GUICtrlRead ( $CHECK1 ) = 1 Then
		$TREO = 1
	Else
		$TREO = 0
	EndIf
EndFunc
; A timer keeps the panel attached during long-running modes and editor callbacks.
; Dock geometry is independent of $APOS, which the picker and game code also update.
Func UI_TRACK_WINDOW()
    If $uiChangingLayout Or $uiBindingBusy Then Return
    If Not $HWND Or Not UI_BINDING_VALID() Then
        If $HWND Then UI_BIND_LOST()
        If $uiDockHidden Then _WinAPI_ShowWindow($MAINFORM, @SW_SHOWNOACTIVATE)
        If $uiDockWindow And $BCOLLAPSED Then UI_STATUS_LAYOUT()
        $uiDockWindow = 0
        $uiDockRect = 0
        $uiDockWasActive = False
        $uiDockHidden = False
        Return
    EndIf

    Local $state = WinGetState($HWND)
    If BitAND($state, 16) Or Not BitAND($state, 2) Then
        If Not $uiDockHidden And BitAND(WinGetState($MAINFORM), 2) And Not BitAND(WinGetState($MAINFORM), 16) Then
            $uiDockHidden = True
            _WinAPI_ShowWindow($MAINFORM, @SW_HIDE)
        EndIf
        $uiDockRect = 0
        $uiDockWasActive = False
        Return
    EndIf
    If BitAND(WinGetState($MAINFORM), 16) Then Return

    Local $position = WinGetPos($HWND)
    If Not IsArray($position) Then Return
    Local $changed = ($uiDockWindow <> $HWND)
    If $changed And $BCOLLAPSED Then UI_STATUS_LAYOUT()
    If $changed Or Not IsArray($uiDockRect) Or $position[0] <> $uiDockRect[0] Or $position[1] <> $uiDockRect[1] Or _
            $position[2] <> $uiDockRect[2] Or $position[3] <> $uiDockRect[3] Then DOCK_TO_GAME($position)
    If $uiDockHidden Then
        _WinAPI_ShowWindow($MAINFORM, @SW_SHOWNOACTIVATE)
        $uiDockHidden = False
    EndIf

    Local $active = (_WinAPI_GetForegroundWindow() = $HWND)
    If $active And Not $uiDockWasActive Then
        ; Show the matching console above the game without activating it.
        _WinAPI_SetWindowPos($MAINFORM, $HWND_TOP, 0, 0, 0, 0, BitOR($SWP_NOACTIVATE, $SWP_NOMOVE, $SWP_NOSIZE))
    EndIf
    $uiDockWasActive = $active
    If TimerDiff($uiDesktopTimer) >= 1500 Then
        $uiDesktopTimer = TimerInit()
        If Not VD_SAMEDESKTOP($MAINFORM, $HWND) Then VD_MOVETOWINDOW($MAINFORM, $HWND)
    EndIf
EndFunc
Func MEMORYREADPIXEL ( $X , $Y , $HANDLE )
	Local $HDC
	Local $ICOLOR
	Local $SCOLOR
	$HDC = _WINAPI_GETWINDOWDC ( $HANDLE )
	$ICOLOR = DllCall ( "gdi32.dll" , "int" , "GetPixel" , "int" , $HDC , "int" , $X , "int" , $Y )
	$SCOLOR = Hex ( $ICOLOR [ 0 ] , 6 )
	_WINAPI_RELEASEDC ( $HANDLE , $HDC )
	Return Hex ( "0x" & StringRight ( $SCOLOR , 2 ) & StringMid ( $SCOLOR , 3 , 2 ) & StringLeft ( $SCOLOR , 2 ) , 6 )
EndFunc
; So mau cho phep lech +-3 moi kenh (MEmu moi may/ban ve lech 1-2 don vi lam auto dung).
; Mau gan den (moi kenh < 16) van so chinh xac de khong bam nham luc man hinh den dang tai.
; ($ICOLORTOL khai bao truoc vong lap chinh)
Func CHECKCOLOR ( $X , $Y , $ICOLOR )
	Local $GCOLOR = MEMORYREADPIXEL ( $X , $Y , $HWND )
	If $GCOLOR = Hex ( $ICOLOR , 6 ) Then Return True
	If $ICOLORTOL <= 0 Then Return False
	Local $R = BitAND ( BitShift ( $ICOLOR , 16 ) , 255 ) , $G = BitAND ( BitShift ( $ICOLOR , 8 ) , 255 ) , $B = BitAND ( $ICOLOR , 255 )
	If $R < 16 And $G < 16 And $B < 16 Then Return False
	Local $C = Dec ( $GCOLOR )
	If Abs ( BitAND ( BitShift ( $C , 16 ) , 255 ) - $R ) > $ICOLORTOL Then Return False
	If Abs ( BitAND ( BitShift ( $C , 8 ) , 255 ) - $G ) > $ICOLORTOL Then Return False
	Return Abs ( BitAND ( $C , 255 ) - $B ) <= $ICOLORTOL
EndFunc
; So mau co sai so (moi kenh R/G/B lech toi da $ITOL) - MEmu moi may ve lech vai don vi
Func CHECKCOLORT ( $X , $Y , $ICOLOR , $ITOL = 12 )
	Local $G = Dec ( MEMORYREADPIXEL ( $X , $Y , $HWND ) )
	If Abs ( BitAND ( BitShift ( $G , 16 ) , 255 ) - BitAND ( BitShift ( $ICOLOR , 16 ) , 255 ) ) > $ITOL Then Return False
	If Abs ( BitAND ( BitShift ( $G , 8 ) , 255 ) - BitAND ( BitShift ( $ICOLOR , 8 ) , 255 ) ) > $ITOL Then Return False
	Return Abs ( BitAND ( $G , 255 ) - BitAND ( $ICOLOR , 255 ) ) <= $ITOL
EndFunc
Func CLICKPIXELT ( $X , $Y , $ICOLOR , $ITOL = 12 )
	If Not CHECKCOLORT ( $X , $Y , $ICOLOR , $ITOL ) Then Return False
	SENDCLICK ( $X + $APOS [ 0 ] , $Y + $APOS [ 1 ] , $APOS )
	Sleep ( 200 )
	Return True
EndFunc
Func MOUSEDRAG ( $WINDOW , $BUTTON = "left" , $X1 = 0 , $Y1 = 0 , $X2 = 0 , $Y2 = 0 , $CLICKS = 1 , $X3 = 0 , $Y3 = 0 )
	Local $MK_LBUTTON = 1
	Local $WM_LBUTTONDOWN = 513
	Local $WM_LBUTTONUP = 514
	Local $MK_RBUTTON = 2
	Local $WM_RBUTTONDOWN = 516
	Local $WM_RBUTTONUP = 517
	Local $WM_MOUSEMOVE = 512
	Local $I = 0
	Select
	Case $BUTTON = "left"
		$BUTTON = $MK_LBUTTON
		$BUTTONDOWN = $WM_LBUTTONDOWN
		$BUTTONUP = $WM_LBUTTONUP
	Case $BUTTON = "right"
		$BUTTON = $MK_RBUTTON
		$BUTTONDOWN = $WM_RBUTTONDOWN
		$BUTTONUP = $WM_RBUTTONUP
	EndSelect
	If $X1 = 0 Or $Y1 = 0 Then
		$MOUSECOORD = MouseGetPos ( )
		$X1 = $MOUSECOORD [ 0 ]
		$Y1 = $MOUSECOORD [ 1 ]
	EndIf
	For $I = 1 To $CLICKS
		If $BRUN = False Then ExitLoop
		DllCall ( "user32.dll" , "int" , "SendMessage" , "hwnd" , WinGetHandle ( $WINDOW ) , "int" , $WM_MOUSEMOVE , "int" , 0 , "long" , _MAKELONG ( $X1 , $Y1 ) )
		DllCall ( "user32.dll" , "int" , "SendMessage" , "hwnd" , WinGetHandle ( $WINDOW ) , "int" , $BUTTONDOWN , "int" , $BUTTON , "long" , _MAKELONG ( $X1 , $Y1 ) )
		Sleep ( 300 )
		If _ISPRESSED ( "1" , $WINDOW ) Then
			DllCall ( "user32.dll" , "int" , "SendMessage" , "hwnd" , WinGetHandle ( $WINDOW ) , "int" , $WM_MOUSEMOVE , "int" , 0 , "long" , _MAKELONG ( $X2 , $Y2 ) )
			Sleep ( 300 )
		EndIf
		DllCall ( "user32.dll" , "int" , "SendMessage" , "hwnd" , WinGetHandle ( $WINDOW ) , "int" , $BUTTONUP , "int" , $BUTTON , "long" , _MAKELONG ( $X2 , $Y2 ) )
		Sleep ( 300 )
		DllCall ( "user32.dll" , "int" , "SendMessage" , "hwnd" , WinGetHandle ( $WINDOW ) , "int" , $WM_MOUSEMOVE , "int" , 0 , "long" , _MAKELONG ( $X2 + $X3 , $Y2 + $Y3 ) )
	Next
EndFunc
Func _MAKELONG ( $LOWORD , $HIWORD )
	Return BitOR ( $HIWORD * 65536 , BitAND ( $LOWORD , 65535 ) )
EndFunc
Func CLICKPIXEL ( $X , $Y , $ICOLOR , $APOS )
	If CHECKCOLOR ( $X , $Y , $ICOLOR ) Then
		SENDCLICK ( $X + $APOS [ 0 ] , $Y + $APOS [ 1 ] , $APOS )
		Sleep ( 200 )
		If $DEBUG Then SAVELOG ( "Click " & $X & " " & $Y & " " & $ICOLOR )
		Return True
	Else
		Return False
	EndIf
EndFunc
Func SAVELOG ( $INFO )
	Local $SFILENAME , $HFILEHANDLE , $VTEXT , $X , $Y
	If $LOG Then
		$SFILENAME = @ScriptDir & "\" & $STEXT & "-log.txt"
		$HFILEHANDLE = FileOpen ( $SFILENAME , $FO_APPEND )
		$VTEXT = _NOW ( ) & "-" & $INFO
		FileWrite ( $HFILEHANDLE , @CRLF & $VTEXT )
		FileClose ( $HFILEHANDLE )
	EndIf
EndFunc
Func CLICKMATCH ( $X , $Y , $ICOLOR , $APOS )
	$X2 = $X + 20
	$Y2 = $Y + 10
	If $X = 314 Then
		If CHECKCOLOR ( $X , $Y , $ICOLOR ) Then
			If CHECKCOLOR ( $X2 , $Y2 , 14386176 ) Then
				SENDCLICK ( $X + $APOS [ 0 ] , $Y + $APOS [ 1 ] , $APOS )
				Sleep ( 100 )
			EndIf
		Else
			$HETLEVEL = 1
		EndIf
	EndIf
	If $X = 420 Then
		If CHECKCOLOR ( $X , $Y , $ICOLOR ) Then
			If CHECKCOLOR ( $X2 , $Y2 , 14386176 ) Then
				SENDCLICK ( $X + $APOS [ 0 ] , $Y + $APOS [ 1 ] , $APOS )
				Sleep ( 100 )
			EndIf
		Else
			$HETLEVEL = 2
		EndIf
	EndIf
	If $X = 526 Then
		If CHECKCOLOR ( $X , $Y , $ICOLOR ) Then
			If CHECKCOLOR ( $X2 , $Y2 , 14386176 ) Then
				SENDCLICK ( $X + $APOS [ 0 ] , $Y + $APOS [ 1 ] , $APOS )
				Sleep ( 100 )
			EndIf
		Else
			$HETLEVEL = 3
		EndIf
	EndIf
	If $X = 632 Then
		If CHECKCOLOR ( $X , $Y , $ICOLOR ) Then
			If CHECKCOLOR ( $X2 , $Y2 , 14386176 ) Then
				SENDCLICK ( $X + $APOS [ 0 ] , $Y + $APOS [ 1 ] , $APOS )
				Sleep ( 100 )
			EndIf
		Else
			$HETLEVEL = 4
		EndIf
	EndIf
EndFunc
Func AUTOCLICKMATCH ( )
	If $EVENMODE = 12 And ( CHECKCOLOR ( 559 , 62 , 8818832 ) Or CHECKCOLOR ( 559 , 343 , 2311204 ) ) Then
		While CHECKCOLOR ( 559 , 62 , 8818832 )
			If $BRUN = False Then ExitLoop
			CLICKPIXEL ( 559 , 62 , 8818832 , $APOS )
			Sleep ( 500 )
			If CHECKCOLOR ( 559 , 62 , 16777215 ) Then ExitLoop
		WEnd
		If $GPOS3X <> 0 And $GPOS3Y <> 0 Then
			SENDCLICK ( $GPOS3X + $APOS [ 0 ] , $GPOS3Y + $APOS [ 1 ] , $APOS )
			Sleep ( 1000 )
		EndIf
		If $GPOS4X <> 0 And $GPOS4Y <> 0 Then
			SENDCLICK ( $GPOS4X + $APOS [ 0 ] , $GPOS4Y + $APOS [ 1 ] , $APOS )
			Sleep ( 1000 )
		EndIf
	EndIf
	Switch $EVENMODE
	Case 1
		CLICKPIXEL ( 339 , 145 , 14386176 , $APOS )
		CLICKPIXEL ( 339 , 153 , 14994519 , $APOS )
		Sleep ( 300 )
	Case 2
		CLICKPIXEL ( 445 , 145 , 14386176 , $APOS )
		Sleep ( 300 )
	Case 3
		CLICKPIXEL ( 552 , 145 , 14386176 , $APOS )
		Sleep ( 300 )
	Case 4
		CLICKPIXEL ( 658 , 145 , 14386176 , $APOS )
		Sleep ( 300 )
	Case 5
		CLICKPIXEL ( 339 , 242 , 14386176 , $APOS )
		Sleep ( 300 )
	Case 6
		CLICKPIXEL ( 445 , 242 , 14386176 , $APOS )
		Sleep ( 300 )
	Case 7
		CLICKPIXEL ( 552 , 242 , 14386176 , $APOS )
		Sleep ( 300 )
	Case 8
		CLICKPIXEL ( 658 , 242 , 14386176 , $APOS )
		Sleep ( 300 )
	Case 9
		CLICKPIXEL ( 339 , 335 , 14386176 , $APOS )
		Sleep ( 300 )
	Case 10
		CLICKPIXEL ( 445 , 335 , 14386176 , $APOS )
		Sleep ( 300 )
	Case 11
		CLICKPIXEL ( 552 , 335 , 14386176 , $APOS )
		Sleep ( 300 )
	Case 12
		CLICKPIXEL ( 658 , 335 , 14386176 , $APOS )
		Sleep ( 300 )
	EndSwitch
EndFunc
