	CLICKPIXEL ( 115 , 277 , 16777161 , $APOS )
	If ( CHECKCOLOR ( 22 , 50 , 16762729 ) Or CHECKCOLOR ( 22 , 50 , 16499305 ) Or CHECKCOLOR ( 22 , 50 , 16564841 ) ) And CHECKCOLOR ( 12 , 370 , 8228475 ) Then
		SENDCLICK ( 11 + $APOS [ 0 ] , 372 + $APOS [ 1 ] , $APOS )
		Sleep ( 2000 )
	EndIf
	Switch $MUCEVEN
	Case 0
		If CHECKCOLOR ( 165 , 85 , 16464198 ) Or CHECKCOLOR ( 165 , 85 , 16398150 ) Or CHECKCOLOR ( 165 , 83 , 14566224 ) Or CHECKCOLOR ( 165 , 83 , 14566223 ) Or CHECKCOLOR ( 165 , 85 , 16463942 ) Or CHECKCOLOR ( 150 , 89 , 15996711 ) Then
